{# templates/home/sections/_new_articles.html.twig #}

<style>
  :root{
    --pc-radius: 18px;
    --pc-border: rgba(0,0,0,.10);
    --pc-shadow: 0 14px 34px rgba(0,0,0,.08);
    --pc-muted: rgba(0,0,0,.58);
  }

  body.theme-dark{
    --pc-border: rgba(255,255,255,.14);
    --pc-shadow: 0 18px 46px rgba(0,0,0,.35);
    --pc-muted: rgba(255,255,255,.65);
  }

  [data-new-section]{
    padding-top: 6px;
  }

  [data-new-section] .latest-arrivals-title{
    margin: 0;
    font-family: 'Montserrat', 'Arial Black', Arial, sans-serif;
    font-size: clamp(2.25rem, 4.8vw, 4.35rem);
    font-weight: 850;
    line-height: .96;
    letter-spacing: .055em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  [data-new-section] .latest-arrivals-eyebrow{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    margin-bottom: 1rem;
    color: var(--bs-warning, var(--brand-orange));
    font-family: 'Montserrat', 'Arial Black', Arial, sans-serif;
    font-size: clamp(.68rem, .78vw, .82rem);
    font-weight: 700;
    letter-spacing: .42em;
    text-transform: uppercase;
  }

  [data-new-section] .latest-arrivals-eyebrow::before{
    content: "//";
    letter-spacing: .12em;
  }

  [data-new-section] .latest-arrivals-title .heading-accent{
    color: var(--bs-warning, var(--brand-orange));
    text-shadow: 0 10px 26px rgba(var(--brand-orange-rgb), .30);
  }

  [data-new-section] .latest-arrivals-subtitle{
    margin-top: 8px;
    font-size: .9rem;
    color: var(--brand-muted);
    font-weight: 400;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  [data-new-section] .latest-arrivals-link{
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: .95rem;
    color: #198754;
    transition: opacity .15s ease, transform .15s ease;
  }

  [data-new-section] .latest-arrivals-link:hover{
    opacity: .85;
    transform: translateY(-1px);
  }

  body.theme-dark [data-new-section] .latest-arrivals-title{
    color: rgba(255,255,255,.92);
  }

  body.theme-dark [data-new-section] .latest-arrivals-subtitle{
    color: rgba(255,255,255,.60);
  }

  body.theme-dark [data-new-section] .latest-arrivals-link{
    color: #4ade80;
  }

  [data-new-section] .product-grid{
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 14px;
  }

  @media (min-width: 768px){
    [data-new-section] .product-grid{
      grid-template-columns: repeat(3, minmax(0,1fr));
    }
  }

  @media (min-width: 1200px){
    [data-new-section] .product-grid{
      grid-template-columns: repeat(5, minmax(0,1fr));
    }
  }

  [data-new-section] .product-card{
    position: relative;
    border-radius: var(--pc-radius);
    border: 1px solid var(--pc-border);
    box-shadow: 0 10px 24px rgba(0,0,0,.06);
    background: rgba(240, 240, 240, 0.85);
    overflow: hidden;
    transition: transform .08s ease, box-shadow .12s ease, border-color .12s ease;
  }

  body.theme-dark [data-new-section] .product-card{
    background: rgba(18,18,22,.70);
  }

  [data-new-section] .product-card:hover{
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(0,0,0,.10);
    border-color: rgba(13,110,253,.22);
  }

  [data-new-section] .wishlist-button{
    position: absolute;
    top: 10px;
    right: 10px;
    min-width: 40px;
    width: auto;
    height: 40px;
    padding: 0 10px;
    border-radius: 14px;
    background: rgba(255,255,255,.82);
    display: grid;
    place-items: center;
    z-index: 5;
    white-space: nowrap;
  }

  [data-new-section] .wishlist-button [data-stock-badge]{
    font-weight: 650;
    font-size: .78rem;
    line-height: 1;
  }

  body.theme-dark [data-new-section] .wishlist-button{
    background: rgba(155, 155, 155, 0.41);
  }

  [data-new-section] .product-card__image{
    position: relative;
    padding: 14px;
    background: linear-gradient(180deg, rgb(255,255,255), transparent);
  }

  [data-new-section] .badge-pill{
    position: absolute;
    left: 12px;
    top: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 4px;
    border: 1px solid rgba(0,0,0,.10);
    background: rgba(255,255,255,.80);
    font-weight: 600;
    font-size: .78rem;
    z-index: 4;
  }

  body.theme-dark [data-new-section] .badge-pill{
    border-color: rgba(255,255,255,.14);
    background: rgba(18,18,22,.70);
  }

  [data-new-section] .discount-badge{
    background: var(--bs-primary) !important;
    color: #fff !important;
  }

  [data-new-section] .badge-newimg{
    position: absolute;
    top: 7px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 6;
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  [data-new-section] .badge-newimg img{
    width: min(220px, 100%);
    height: auto;
    filter: drop-shadow(0 10px 18px rgba(0,0,0,.18));
  }

  body.theme-dark [data-new-section] .badge-newimg img{
    filter: drop-shadow(0 14px 24px rgba(0,0,0,.55));
  }

  [data-new-section] .product-img{
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    border-radius: 16px;
    background: rgba(255,255,255,.35);
    padding: 12px;
    border: 1px solid rgba(0,0,0,.06);
  }

  body.theme-dark [data-new-section] .product-img{
    background: rgba(255,255,255);
    border-color: rgba(255,255,255,.10);
  }

  [data-new-section] .product-card__info{
    padding: 12px 14px 0 14px;
  }

  [data-new-section] .refPlusCopy{
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 1.2rem;
  }

  [data-new-section] .product-reference{
    text-decoration: none;
    color: inherit;
  }

  [data-new-section] .designation{
    display: block;
    margin-top: 6px;
    font-weight: 600;
    font-size: .82rem;
    color: rgba(0,0,0,.75);
    text-decoration: none;
    text-transform: uppercase;
  }

  body.theme-dark [data-new-section] .designation{
    color: rgba(255,255,255,.86);
  }

  [data-new-section] .meta-line{
    margin-top: 8px;
    font-size: .70rem;
    color: var(--pc-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  [data-new-section] .meta-chip{
    border: 1px solid var(--brand-orange);
    background: var(--brand-orange);
    border-radius: 999px;
    padding: 0 6px;
    font-weight: 400;
    color: rgba(255,255,255,.85);
  }

  body.theme-dark [data-new-section] .meta-chip{
    border-color: rgba(255,255,255,.14);
    background: rgba(18,18,22,.62);
  }

  [data-new-section] .product-card__footer{
    padding: 12px 14px 14px 14px;
  }

  [data-new-section] .product-card__prices{
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-weight: 650;
  }

  [data-new-section] .price-ttc{
    font-size: 1.05rem;
  }

  [data-new-section] .price-label{
    font-size: .78rem;
    color: var(--pc-muted);
    font-weight: 600;
  }

  [data-new-section] .bottomFooterWrapper{
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  [data-new-section] .qty-stepper{
    display: flex;
    align-items: stretch;
    height: 44px;
    border: 1px solid var(--pc-border);
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255,255,255,.92);
    flex: 0 0 auto;
  }

  body.theme-dark [data-new-section] .qty-stepper{
    background: rgba(18,18,22,.70);
  }

  [data-new-section] .qty-btn{
    width: 44px;
    border: 0;
    background: transparent;
    display: grid;
    place-items: center;
    font-weight: 600;
    color: rgba(0,0,0,.65);
    transition: background .12s ease, color .12s ease;
    flex: 0 0 44px;
  }

  body.theme-dark [data-new-section] .qty-btn{
    color: rgba(255,255,255,.75);
  }

  [data-new-section] .qty-btn:hover{
    background: rgba(0,0,0,.05);
  }

  body.theme-dark [data-new-section] .qty-btn:hover{
    background: rgba(255,255,255,.06);
  }

  [data-new-section] .qty-btn:disabled{
    opacity: .45;
    cursor: not-allowed;
  }

  [data-new-section] .qty-field{
    width: 24px;
    border: 0;
    outline: none;
    text-align: center;
    font-weight: 650;
    background: transparent;
    color: rgba(0,0,0,.85);
  }

  body.theme-dark [data-new-section] .qty-field{
    color: rgba(255,255,255,.90);
  }

  [data-new-section] .qty-field:disabled{
    opacity: .6;
  }

  [data-new-section] .addcart{
    margin-left: auto;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 0 5px;
    border: 1px solid var(--brand-border);
    background: #ecf0f1;
    font-weight: 600;
  }

  [data-new-section] .addcart:hover{
    background: rgba(190, 190, 190, 0.64);
  }

  [data-new-section] .addcart:disabled{
    opacity: .60;
    cursor: not-allowed;
    background: rgb(255,255,255);
    border-color: rgba(0,0,0,.10);
  }

  [data-new-section] .cart-count-btn{
    min-width: 10px;
    height: 22px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: .78rem;
    line-height: 1;
    font-weight: 600;
    color: inherit;
  }

  body.theme-dark [data-new-section] .cart-count-btn{
    background: rgba(255,255,255,.10);
    border-color: rgba(255,255,255,.14);
  }

  [data-new-section] .skeleton{
    height: 380px;
    border-radius: var(--pc-radius);
    border: 1px solid rgba(0,0,0,.06);
    background: linear-gradient(90deg, rgba(0,0,0,.04), rgba(0,0,0,.08), rgba(0,0,0,.04));
    background-size: 200% 100%;
    animation: sk 1.2s infinite;
  }

  @keyframes sk{
    0%{ background-position: 200% 0; }
    100%{ background-position: -200% 0; }
  }
</style>

<section class="latest-arrivals-section mb-5" data-new-section>
  <div class="latest-arrivals-head">
    <div>
      <div class="section-eyebrow latest-arrivals-eyebrow">Nouveautés catalogue</div>
      <h2 class="latest-arrivals-title">Dernier <span class="heading-accent">arrivage</span></h2>
      <div class="latest-arrivals-subtitle">Découvrez les arrivages récemment ajoutés au catalogue</div>
    </div>
    <a href="{{ path('articles_page', { new: 1, newDays: 90 }) }}" class="latest-arrivals-link">
      Voir tout<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </a>
  </div>

  <div class="product-grid" data-new-grid>
    {% for i in 1..8 %}
      <div class="skeleton"></div>
    {% endfor %}
  </div>

  <div class="alert alert-danger mt-3 d-none" data-new-error></div>

</section>

