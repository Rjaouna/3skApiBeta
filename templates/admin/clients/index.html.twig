{% extends 'base.html.twig' %}

{% block body %}
<style>
  :root{
    --oc-radius: 22px;
    --oc-border: rgba(0,0,0,.10);
    --oc-shadow: 0 14px 34px rgba(0,0,0,.08);
    --oc-muted: rgba(0,0,0,.58);
    --oc-text: rgba(0,0,0,.84);
    --oc-glass: rgba(255,255,255,.82);
    --oc-glass-2: rgba(255,255,255,.60);
  }

  body.theme-dark{
    --oc-border: rgba(255,255,255,.14);
    --oc-shadow: 0 18px 46px rgba(0,0,0,.35);
    --oc-muted: rgba(255,255,255,.62);
    --oc-text: rgba(255,255,255,.88);
    --oc-glass: rgba(18,18,22,.76);
    --oc-glass-2: rgba(18,18,22,.58);
  }

  .clients-page-hero{
    border-radius: 24px;
    border: 1px solid var(--oc-border);
    box-shadow: var(--oc-shadow);
    padding: 18px;
    background:
      radial-gradient(900px circle at 10% 10%, rgba(var(--bs-primary-rgb), .16), transparent 40%),
      radial-gradient(900px circle at 90% 30%, rgba(var(--bs-secondary-rgb), .14), transparent 38%),
      linear-gradient(180deg, rgba(0,0,0,.02), transparent);
  }

  .clients-page-hero h3{
    margin: 0;
    font-weight: 650;
    color: var(--oc-text);
  }

  .clients-page-hero .subtitle{
    margin-top: 6px;
    color: var(--oc-muted);
    font-size: .92rem;
    font-weight: 600;
  }

  .clients-main-card{
    border-radius: var(--oc-radius);
    border: 1px solid var(--oc-border);
    box-shadow: var(--oc-shadow);
    background: var(--oc-glass);
    backdrop-filter: blur(8px);
  }

  .clients-main-card .card-body{
    padding: 18px;
  }

  .ebp-import-card{
    border-top: 3px solid rgba(var(--bs-primary-rgb), .55);
  }

  .ebp-import-status{
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    padding: 5px 9px;
    font-size: .76rem;
    font-weight: 700;
  }

  .ebp-import-status--pending{ background: rgba(255,193,7,.16); color: #8a5a00; }
  .ebp-import-status--failed{ background: rgba(220,53,69,.12); color: #b42332; }
  .ebp-import-status--created{ background: rgba(25,135,84,.13); color: #0a7041; }

  body.theme-dark .ebp-import-status--pending{ color: #ffd166; }
  body.theme-dark .ebp-import-status--failed{ color: #ff9aa5; }
  body.theme-dark .ebp-import-status--created{ color: #6ee7ae; }

  .clients-toolbar{
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .clients-search-wrap{
    flex: 1 1 420px;
    min-width: 260px;
  }

  .clients-search{
    min-height: 50px;
    border-radius: 14px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.75);
    color: var(--oc-text);
    font-weight: 700;
    box-shadow: none;
  }

  .clients-search:focus{
    border-color: rgba(var(--bs-primary-rgb), .35);
    box-shadow: 0 0 0 .22rem rgba(var(--bs-primary-rgb), .10);
    background: rgba(255,255,255,.92);
  }

  body.theme-dark .clients-search{
    background: rgba(255,255,255,.06);
    color: var(--oc-text);
  }

  body.theme-dark .clients-search:focus{
    background: rgba(255,255,255,.08);
  }

  .clients-btn{
    min-height: 48px;
    border-radius: 14px;
    font-weight: 600;
    padding-inline: 18px;
  }

  .clients-count-badge{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 8px 12px;
    border: 1px solid var(--oc-border);
    background: var(--oc-glass-2);
    color: var(--oc-text);
    font-size: .82rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .clients-count-badge i{
    color: var(--bs-primary);
  }

  .clients-alert{
    border-radius: 16px;
    border: 1px solid transparent;
    font-weight: 550;
    padding: 12px 14px;
  }

  .clients-table{
    margin: 0;
    border-collapse: separate;
    border-spacing: 0;
    min-width: 1280px;
  }

  .clients-table thead,
  .clients-table thead tr{
    background: var(--bs-tertiary-bg, var(--brand-bg)) !important;
  }

  .clients-table thead th{
    --bs-table-bg: var(--bs-tertiary-bg, var(--brand-bg));
    --bs-table-color: var(--oc-muted);
    border-bottom: 1px solid var(--oc-border);
    color: var(--oc-muted) !important;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    font-weight: 600;
    padding: 12px;
    white-space: nowrap;
    background: var(--bs-tertiary-bg, var(--brand-bg)) !important;
    background-color: var(--bs-tertiary-bg, var(--brand-bg)) !important;
    box-shadow: none !important;
  }

  .clients-table thead th:first-child{
    border-top-left-radius: 14px;
  }

  .clients-table thead th:last-child{
    border-top-right-radius: 14px;
  }

  .clients-table tbody tr{
    transition: background .12s ease, transform .12s ease;
  }

  .clients-table tbody tr:hover{
    background: rgba(var(--bs-primary-rgb), .04);
  }

  .clients-table tbody td{
    padding: 16px 12px;
    border-color: rgba(0,0,0,.06);
    vertical-align: middle;
    color: var(--oc-text);
  }

  body.theme-dark .clients-table tbody td{
    border-color: rgba(255,255,255,.08);
  }

  .client-primary-name{
    font-weight: 600;
    color: var(--oc-text);
    line-height: 1.2;
    word-break: break-word;
  }

  .client-secondary-email{
    margin-top: 5px;
    color: var(--oc-muted);
    font-size: .80rem;
    font-weight: 500;
    line-height: 1.25;
    word-break: break-word;
  }

  .client-address{
    margin-top: 3px;
    font-size: .78rem;
    color: var(--oc-muted);
    font-weight: 400;
    line-height: 1.3;
  }

  .client-code,
  .client-city{
    font-weight: 550;
    color: var(--oc-text);
  }

  .client-source{
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 5px 8px;
    font-size: .74rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .client-source--ebp{ background: rgba(var(--bs-primary-rgb), .12); color: var(--bs-primary); }
  .client-source--site{ background: rgba(108,117,125,.13); color: #59636e; }
  .client-date{ white-space: nowrap; color: var(--oc-muted); font-size: .80rem; }

  .clients-filter-select{
    min-height: 44px;
    border-radius: 14px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.72);
    color: var(--oc-text);
    font-weight: 550;
    box-shadow: none;
  }

  body.theme-dark .clients-filter-select{
    background: rgba(255,255,255,.06);
  }

  .client-actions{
    display: inline-flex;
    gap: 8px;
    justify-content: flex-end;
  }

  .client-action-btn{
    border-radius: 12px;
    min-width: 38px;
    font-weight: 600;
  }

  .client-status-pill{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: .78rem;
    font-weight: 600;
    min-width: 94px;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .client-status-active{
    background: rgba(25,135,84,.12);
    color: rgba(25,135,84,1);
    border-color: rgba(25,135,84,.20);
  }

  .client-status-inactive{
    background: rgba(108,117,125,.14);
    color: rgba(73,80,87,1);
    border-color: rgba(108,117,125,.20);
  }

  .clients-pagination{
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .clients-page-info{
    color: var(--oc-muted);
    font-size: .84rem;
    font-weight: 700;
  }

  .clients-page-btn{
    min-height: 40px;
    border-radius: 12px;
    font-weight: 600;
  }

  body.theme-dark .client-status-inactive{
    color: rgba(222,226,230,.88);
    border-color: rgba(255,255,255,.14);
    background: rgba(255,255,255,.06);
  }

  .clients-empty{
    border-radius: 20px;
    border: 1px dashed var(--oc-border);
    background: rgba(255,255,255,.42);
    padding: 44px 18px;
    text-align: center;
    color: var(--oc-muted);
  }

  body.theme-dark .clients-empty{
    background: rgba(255,255,255,.03);
  }

  .clients-empty i{
    font-size: 2rem;
    margin-bottom: 12px;
    color: var(--bs-secondary);
  }

  .client-modal .modal-content{
    max-height: calc(100dvh - 2.5rem);
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid var(--oc-border);
    box-shadow: var(--oc-shadow);
    background: var(--oc-glass);
    backdrop-filter: blur(10px);
  }

  .client-modal .modal-header,
  .client-modal .modal-footer{
    border-color: rgba(0,0,0,.06);
    padding: 16px 18px;
  }

  body.theme-dark .client-modal .modal-header,
  body.theme-dark .client-modal .modal-footer{
    border-color: rgba(255,255,255,.08);
  }

  .client-modal .modal-title{
    font-weight: 650;
    color: var(--oc-text);
  }

  .client-modal .modal-body{
    padding: 18px;
    overflow-y: auto;
  }

  .client-modal-label{
    font-size: .82rem;
    font-weight: 600;
    color: var(--oc-muted);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: .03em;
  }

  .client-modal .form-control,
  .client-modal textarea{
    min-height: 44px;
    border-radius: 14px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.75);
    color: var(--oc-text);
    font-weight: 700;
    box-shadow: none;
  }

  .client-modal textarea{
    min-height: auto;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .client-modal .form-control:focus,
  .client-modal textarea:focus{
    border-color: rgba(var(--bs-primary-rgb), .35);
    box-shadow: 0 0 0 .22rem rgba(var(--bs-primary-rgb), .10);
    background: rgba(255,255,255,.92);
  }

  body.theme-dark .client-modal .form-control,
  body.theme-dark .client-modal textarea{
    background: rgba(255,255,255,.06);
    color: var(--oc-text);
  }

  body.theme-dark .client-modal .form-control:focus,
  body.theme-dark .client-modal textarea:focus{
    background: rgba(255,255,255,.08);
  }

  .client-switch-card{
    border-radius: 16px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.52);
    padding: 14px;
  }

  body.theme-dark .client-switch-card{
    background: rgba(255,255,255,.04);
  }

  .client-switch-card .form-check{
    margin: 0;
  }

  .client-switch-card .form-check-input{
    width: 2.8rem;
    height: 1.45rem;
    cursor: pointer;
  }

  .client-switch-card .form-check-label{
    color: var(--oc-text);
    font-weight: 550;
    cursor: pointer;
  }

  .client-metadata{
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    padding: 14px;
    border: 1px solid var(--oc-border);
    border-radius: 16px;
    background: rgba(255,255,255,.52);
  }

  .client-metadata small{
    display: block;
    margin-bottom: 4px;
    color: var(--oc-muted);
    font-size: .72rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .client-metadata strong{
    color: var(--oc-text);
    font-size: .84rem;
  }

  body.theme-dark .client-metadata{ background: rgba(255,255,255,.04); }

  @media (max-width: 767.98px){
    .client-modal .modal-dialog{
      margin: .75rem;
    }

    .client-modal .modal-content{
      max-height: calc(100dvh - 1.5rem);
    }

    .client-modal .modal-header,
    .client-modal .modal-footer,
    .client-modal .modal-body{
      padding: 14px;
    }

    .client-modal .row{
      --bs-gutter-y: .75rem;
    }

    .clients-toolbar{
      align-items: stretch;
    }

    .clients-search-wrap{
      flex-basis: 100%;
    }

    .clients-btn{
      width: 100%;
    }

    .clients-filter-select{
      width: 100%;
    }

    .clients-pagination{
      justify-content: stretch;
    }

    .clients-page-btn{
      flex: 1 1 0;
    }

    .clients-page-info{
      width: 100%;
      text-align: center;
    }

    .client-metadata{
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>

<div class="container py-4" data-crud-token="{{ crudToken|e('html_attr') }}">
  <div class="clients-page-hero mb-3 d-flex align-items-start justify-content-between flex-wrap gap-2">
    <div>
      <h3>Gestion des clients</h3>
      <div class="subtitle">Administration, recherche et mise à jour des comptes clients.</div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <button class="btn btn-outline-primary clients-btn" id="btnEbpInvoicesSync" type="button">
        <i class="fa-solid fa-file-invoice me-2"></i>Charger les documents EBP
      </button>
      <button class="btn btn-outline-primary clients-btn" id="btnEbpImportFocus" type="button">
        <i class="fa-solid fa-database me-2"></i>Importer depuis EBP
      </button>
      <button class="btn btn-primary clients-btn" id="btnNewClient" type="button">
        <i class="fa-solid fa-plus me-2"></i>Nouveau client
      </button>
    </div>
  </div>

  <div class="clients-main-card">
    <div class="card-body">
      <div class="clients-toolbar">
        <div class="clients-search-wrap">
          <input
            type="text"
            class="form-control clients-search"
            id="searchInput"
            placeholder="Recherche par email, société, code client, ville..."
          >
        </div>

        <select class="form-select clients-filter-select" id="statusFilter" aria-label="Filtrer par statut">
          <option value="">Tous les statuts</option>
          <option value="1">Actifs</option>
          <option value="0">Inactifs</option>
        </select>

        <input
          type="text"
          class="form-control clients-filter-select"
          id="cityFilter"
          placeholder="Ville"
          aria-label="Filtrer par ville"
        >

        <button class="btn btn-outline-secondary clients-btn" id="btnReload" type="button">
          <i class="fa-solid fa-rotate-right me-2"></i>Actualiser
        </button>

        <span class="clients-count-badge" id="clientsCount">
          <i class="fa-solid fa-users"></i>
          <span>0 client</span>
        </span>
      </div>

      <div class="alert alert-danger clients-alert d-none" id="pageError"></div>

      <div class="table-responsive">
        <table class="table clients-table align-middle mb-0">
          <thead>
            <tr>
              <th>Client</th>
              <th>Code client</th>
              <th>Source</th>
              <th>Ville</th>
              <th>Créé le</th>
              <th>Modifié le</th>
              <th>Dernière commande</th>
              <th>Commandes ce mois</th>
              <th>Statut</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody id="clientsTbody">
            <tr>
              <td colspan="10" class="text-muted">Chargement…</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="clients-pagination d-none" id="clientsPagination"></div>
    </div>
  </div>

  <section class="clients-main-card ebp-import-card mt-3" aria-labelledby="ebp-import-title">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
        <div>
          <h5 class="mb-1" id="ebp-import-title"><i class="fa-solid fa-database text-primary me-2"></i>Imports clients EBP</h5>
          <p class="mb-0 text-muted small">Demandez une fiche avec son UniqueId. ApiLocal lit uniquement ce client, puis le compte est créé ici dès réception.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-outline-secondary btn-sm" id="btnEbpRefresh" type="button"><i class="fa-solid fa-rotate-right me-1"></i>Vérifier les demandes</button>
          <button class="btn btn-outline-danger btn-sm" id="btnEbpClear" type="button"><i class="fa-solid fa-trash-can me-1"></i>Vider la liste</button>
        </div>
      </div>

      <div class="row g-2 align-items-end">
        <div class="col-lg-8">
          <label class="form-label fw-semibold small" for="ebpUniqueId">UniqueId client EBP</label>
          <input class="form-control clients-search" id="ebpUniqueId" maxlength="36" placeholder="Ex. 7A4F31A8-1AA1-4B3D-8AA1-123456789ABC" autocomplete="off">
        </div>
        <div class="col-lg-4 d-grid">
          <button class="btn btn-primary clients-btn" id="btnEbpRequest" type="button"><i class="fa-solid fa-cloud-arrow-down me-2"></i>Demander l’import</button>
        </div>
      </div>
      <p class="small text-muted mt-2 mb-3">Le mot de passe du nouveau compte est généré de façon sécurisée. Il peut ensuite être remplacé depuis sa fiche client.</p>

      <div class="alert d-none mb-3" id="ebpImportMessage" role="status"></div>
      <div class="table-responsive">
        <table class="table clients-table align-middle mb-0">
          <thead>
            <tr>
              <th>Client EBP</th>
              <th>Informations reçues</th>
              <th>Statut</th>
              <th>Dernière mise à jour</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody id="ebpImportsTbody">
            <tr><td colspan="5" class="text-muted">Chargement des demandes…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<div class="modal fade client-modal" id="clientModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="clientModalTitle">Nouveau client</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <div class="alert alert-danger clients-alert d-none" id="formError"></div>

        <form id="clientForm" novalidate>
          <input type="hidden" id="clientId">

          <div class="row g-3">
            <div class="col-md-6">
              <label class="client-modal-label">Email</label>
              <input type="email" class="form-control" id="f_email" required>
            </div>

            <div class="col-md-6">
              <label class="client-modal-label">
                Mot de passe <span class="text-muted small text-lowercase">(laisser vide pour ne pas changer)</span>
              </label>
              <input type="password" class="form-control" id="f_password">
            </div>

            <div class="col-md-6">
              <label class="client-modal-label">Société</label>
              <input type="text" class="form-control" id="f_companyName">
            </div>

            <div class="col-md-6">
              <label class="client-modal-label">Code client</label>
              <input type="text" class="form-control" id="f_customerCode">
            </div>

            <div class="col-md-8">
              <label class="client-modal-label">Adresse 1</label>
              <textarea class="form-control" id="f_address1" rows="2"></textarea>
            </div>

            <div class="col-md-4">
              <label class="client-modal-label">Ville</label>
              <input type="text" class="form-control" id="f_city">
            </div>

            <div class="col-12">
              <label class="client-modal-label">Adresse 2</label>
              <textarea class="form-control" id="f_address2" rows="2"></textarea>
            </div>

            <div class="col-12">
              <div class="client-switch-card">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" id="f_isActive" checked>
                  <label class="form-check-label" for="f_isActive">Compte actif</label>
                </div>
              </div>
            </div>

            <div class="col-12 d-none" id="clientMetadata">
              <div class="client-metadata">
                <div><small>Source</small><strong id="clientSource">—</strong></div>
                <div><small>Créé le</small><strong id="clientCreatedAt">—</strong></div>
                <div><small>Modifié le</small><strong id="clientUpdatedAt">—</strong></div>
              </div>
            </div>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button class="btn btn-outline-secondary clients-btn" type="button" data-bs-dismiss="modal">Annuler</button>
        <button class="btn btn-primary clients-btn" type="button" id="btnSaveClient">Enregistrer</button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const wrap = document.querySelector('[data-crud-token]');
  const CRUD_TOKEN = wrap?.getAttribute('data-crud-token') || '';

  const tbody = document.getElementById('clientsTbody');
  const pageError = document.getElementById('pageError');
  const formError = document.getElementById('formError');
  const clientsCount = document.getElementById('clientsCount');
  const searchInput = document.getElementById('searchInput');
  const statusFilter = document.getElementById('statusFilter');
  const cityFilter = document.getElementById('cityFilter');
  const clientsPagination = document.getElementById('clientsPagination');
  const btnReload = document.getElementById('btnReload');
  const btnNewClient = document.getElementById('btnNewClient');
  const btnSaveClient = document.getElementById('btnSaveClient');
  const btnEbpImportFocus = document.getElementById('btnEbpImportFocus');
  const btnEbpInvoicesSync = document.getElementById('btnEbpInvoicesSync');
  const btnEbpRequest = document.getElementById('btnEbpRequest');
  const btnEbpRefresh = document.getElementById('btnEbpRefresh');
  const btnEbpClear = document.getElementById('btnEbpClear');
  const ebpUniqueId = document.getElementById('ebpUniqueId');
  const ebpImportsTbody = document.getElementById('ebpImportsTbody');
  const ebpImportMessage = document.getElementById('ebpImportMessage');

  const clientId = document.getElementById('clientId');
  const clientMetadata = document.getElementById('clientMetadata');
  const clientSource = document.getElementById('clientSource');
  const clientCreatedAt = document.getElementById('clientCreatedAt');
  const clientUpdatedAt = document.getElementById('clientUpdatedAt');
  const f_email = document.getElementById('f_email');
  const f_password = document.getElementById('f_password');
  const f_companyName = document.getElementById('f_companyName');
  const f_customerCode = document.getElementById('f_customerCode');
  const f_address1 = document.getElementById('f_address1');
  const f_address2 = document.getElementById('f_address2');
  const f_city = document.getElementById('f_city');
  const f_isActive = document.getElementById('f_isActive');

  const modalEl = document.getElementById('clientModal');
  const modalTitle = document.getElementById('clientModalTitle');
  let modal = null;

  if (window.bootstrap && modalEl) {
    modal = new bootstrap.Modal(modalEl);
  } else {
    console.error('Bootstrap JS non chargé : la modale client ne peut pas s’ouvrir.');
  }

  const API_LIST = "{{ path('admin_clients_list') }}";
  const API_CREATE = "{{ path('admin_clients_create') }}";
  const API_UPDATE_PATTERN = "{{ path('admin_clients_update', {id: 999999}) }}";
  const API_DELETE_PATTERN = "{{ path('admin_clients_delete', {id: 999999}) }}";
  const API_EBP_IMPORTS = "{{ path('admin_clients_ebp_import_list') }}";
  const API_EBP_REFRESH = "{{ path('admin_clients_ebp_import_refresh') }}";
  const API_EBP_CLEAR = "{{ path('admin_clients_ebp_import_clear') }}";
  const API_EBP_DELETE_PATTERN = "{{ path('admin_clients_ebp_import_delete', {id: 999999}) }}";
  const API_EBP_INVOICES_SYNC = "{{ path('admin_clients_invoices_sync_all') }}";

  let currentItems = [];
  let currentPage = 1;
  let searchTimer = null;
  let ebpImportItems = [];
  let ebpRefreshing = false;

  function esc(s){
    return String(s ?? '').replace(/[&<>"']/g, m => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[m]));
  }

  function setPageError(message){
    if (!pageError) return;
    if (!message) {
      pageError.classList.add('d-none');
      pageError.textContent = '';
      return;
    }
    pageError.classList.remove('d-none', 'alert-success');
    pageError.classList.add('alert-danger');
    pageError.textContent = message;
  }

  function setPageNotice(message){
    if (!pageError) return;
    if (!message) {
      pageError.classList.add('d-none');
      pageError.textContent = '';
      return;
    }
    pageError.classList.remove('d-none', 'alert-danger');
    pageError.classList.add('alert-success');
    pageError.textContent = message;
  }

  function setFormError(message){
    if (!formError) return;
    if (!message) {
      formError.classList.add('d-none');
      formError.textContent = '';
      return;
    }
    formError.classList.remove('d-none');
    formError.textContent = message;
  }

  function resetForm(){
    clientId.value = '';
    f_email.value = '';
    f_password.value = '';
    f_companyName.value = '';
    f_customerCode.value = '';
    f_address1.value = '';
    f_address2.value = '';
    f_city.value = '';
    f_isActive.checked = true;
    clientMetadata?.classList.add('d-none');
    setFormError('');
  }

  function displayClientDate(value, dateStyle = 'medium'){
    if (!value) return '—';
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? '—' : parsed.toLocaleString('fr-FR', { dateStyle, timeStyle:'short' });
  }

  function fillForm(item){
    clientId.value = item.id ?? '';
    f_email.value = item.email ?? '';
    f_password.value = '';
    f_companyName.value = item.companyName ?? '';
    f_customerCode.value = item.customerCode ?? '';
    f_address1.value = item.address1 ?? '';
    f_address2.value = item.address2 ?? '';
    f_city.value = item.city ?? '';
    f_isActive.checked = !!item.isActive;
    clientSource.textContent = item.source === 'EBP' ? 'EBP' : 'Site';
    clientCreatedAt.textContent = displayClientDate(item.createdAt);
    clientUpdatedAt.textContent = displayClientDate(item.updatedAt);
    clientMetadata?.classList.remove('d-none');
  }

  function getPayload(){
    return {
      _token: CRUD_TOKEN,
      email: f_email.value.trim(),
      password: f_password.value,
      companyName: f_companyName.value.trim(),
      customerCode: f_customerCode.value.trim(),
      address1: f_address1.value.trim(),
      address2: f_address2.value.trim(),
      city: f_city.value.trim(),
      isActive: f_isActive.checked
    };
  }

  function updateUrl(id){
    return API_UPDATE_PATTERN.replace('999999', String(id));
  }

  function deleteUrl(id){
    return API_DELETE_PATTERN.replace('999999', String(id));
  }

  function ebpDeleteUrl(id){
    return API_EBP_DELETE_PATTERN.replace('999999', String(id));
  }

  function setEbpMessage(message, type = 'success'){
    if (!ebpImportMessage) return;
    if (!message) {
      ebpImportMessage.className = 'alert d-none mb-3';
      ebpImportMessage.textContent = '';
      return;
    }
    ebpImportMessage.className = 'alert alert-' + type + ' mb-3';
    ebpImportMessage.textContent = message;
  }

  function ebpStatus(status){
    const labels = {
      pending: ['En attente EBP', 'pending', 'fa-hourglass-half'],
      failed: ['Erreur', 'failed', 'fa-triangle-exclamation'],
      created: ['Compte créé', 'created', 'fa-circle-check']
    };
    const value = labels[status] || ['Inconnu', 'failed', 'fa-circle-question'];
    return `<span class="ebp-import-status ebp-import-status--${value[1]}"><i class="fa-solid ${value[2]}"></i>${value[0]}</span>`;
  }

  function importDate(value){
    if (!value) return '—';
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? '—' : parsed.toLocaleString('fr-FR', { dateStyle:'short', timeStyle:'short' });
  }

  function renderEbpImports(items){
    ebpImportItems = Array.isArray(items) ? items : [];
    if (btnEbpClear) btnEbpClear.disabled = !ebpImportItems.length;
    if (!ebpImportsTbody) return;
    if (!ebpImportItems.length) {
      ebpImportsTbody.innerHTML = '<tr><td colspan="5"><div class="clients-empty my-2"><i class="fa-solid fa-inbox"></i><div class="fw-bold mb-1">Aucune demande d’import</div><div class="small">Saisissez l’UniqueId d’un client EBP pour commencer.</div></div></td></tr>';
      return;
    }
    ebpImportsTbody.innerHTML = ebpImportItems.map(item => {
      const customer = item.customer && typeof item.customer === 'object' ? item.customer : {};
      const identity = customer.companyName || customer.customerCode || 'Client EBP';
      const details = [customer.email, customer.phone, customer.city].filter(Boolean).map(esc).join(' · ');
      const message = item.message ? `<div class="small ${item.status === 'failed' ? 'text-danger' : 'text-muted'} mt-1">${esc(item.message)}</div>` : '';
      return `<tr>
        <td><div class="client-code">${esc(item.uniqueId || '—')}</div><small class="text-muted">Demande #${esc(item.id || '—')}</small></td>
        <td><div class="client-primary-name">${esc(identity)}</div><div class="client-secondary-email">${details || 'En attente des informations EBP'}</div>${message}</td>
        <td>${ebpStatus(item.status)}</td>
        <td>${importDate(item.updatedAt)}</td>
        <td class="text-end"><button class="btn btn-outline-danger btn-sm client-action-btn" type="button" data-ebp-delete="${esc(item.id)}" title="Supprimer cette demande"><i class="fa-solid fa-trash"></i></button></td>
      </tr>`;
    }).join('');
    ebpImportsTbody.querySelectorAll('[data-ebp-delete]').forEach(button => {
      button.addEventListener('click', async () => {
        const id = Number(button.getAttribute('data-ebp-delete'));
        if (!Number.isInteger(id) || !confirm('Supprimer cette demande d’import ?')) return;
        button.disabled = true;
        try {
          const response = await fetch(ebpDeleteUrl(id), {
            method: 'POST',
            headers: {'Content-Type':'application/json', 'Accept':'application/json'},
            body: JSON.stringify({_token: CRUD_TOKEN})
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.message || 'Suppression impossible');
          setEbpMessage(data.message || 'Demande supprimée.');
          await loadEbpImports();
        } catch (error) {
          setEbpMessage(error.message || 'Erreur réseau.', 'danger');
          button.disabled = false;
        }
      });
    });
  }

  async function loadEbpImports(){
    try {
      const response = await fetch(API_EBP_IMPORTS, {headers:{'Accept':'application/json'}});
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) throw new Error(data.message || 'Impossible de charger les demandes EBP.');
      renderEbpImports(data.items);
    } catch (error) {
      if (ebpImportsTbody) ebpImportsTbody.innerHTML = '<tr><td colspan="5" class="text-danger">Impossible de charger les demandes EBP.</td></tr>';
      setEbpMessage(error.message || 'Erreur réseau.', 'danger');
    }
  }

  async function refreshEbpImports(silent = false){
    if (ebpRefreshing) return;
    ebpRefreshing = true;
    if (btnEbpRefresh) btnEbpRefresh.disabled = true;
    try {
      const response = await fetch(API_EBP_REFRESH, {
        method:'POST',
        headers:{'Content-Type':'application/json', 'Accept':'application/json'},
        body:JSON.stringify({_token:CRUD_TOKEN})
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) throw new Error(data.message || 'Vérification impossible.');
      renderEbpImports(data.items);
      if ((data.summary?.created || 0) > 0 || (data.summary?.updated || 0) > 0) await loadClients();
      if (!silent) {
        const summary = data.summary || {};
        setEbpMessage((summary.created || 0) + ' compte(s) créé(s), ' + (summary.updated || 0) + ' fiche(s) mise(s) à jour, ' + (summary.pending || 0) + ' demande(s) en attente et ' + (summary.failed || 0) + ' erreur(s).');
      }
    } catch (error) {
      if (!silent) setEbpMessage(error.message || 'Erreur réseau.', 'danger');
    } finally {
      ebpRefreshing = false;
      if (btnEbpRefresh) btnEbpRefresh.disabled = false;
    }
  }

  function renderPagination(meta){
    if (!clientsPagination) return;

    const total = Number(meta?.total || 0);
    const page = Number(meta?.page || 1);
    const pages = Number(meta?.pages || 1);
    const limit = Number(meta?.limit || 20);

    if (total <= limit || pages <= 1) {
      clientsPagination.classList.add('d-none');
      clientsPagination.innerHTML = '';
      return;
    }

    clientsPagination.classList.remove('d-none');
    clientsPagination.innerHTML = `
      <button class="btn btn-outline-secondary clients-page-btn" type="button" data-page-prev ${page <= 1 ? 'disabled' : ''}>
        <i class="fa-solid fa-chevron-left me-1"></i>Précédent
      </button>
      <div class="clients-page-info">Page ${page} / ${pages} · ${total} clients</div>
      <button class="btn btn-outline-secondary clients-page-btn" type="button" data-page-next ${page >= pages ? 'disabled' : ''}>
        Suivant<i class="fa-solid fa-chevron-right ms-1"></i>
      </button>
    `;

    clientsPagination.querySelector('[data-page-prev]')?.addEventListener('click', () => {
      if (currentPage > 1) loadClients(currentPage - 1);
    });

    clientsPagination.querySelector('[data-page-next]')?.addEventListener('click', () => {
      if (currentPage < pages) loadClients(currentPage + 1);
    });
  }

  function renderRows(items, meta = {}){
    currentItems = items || [];

    if (clientsCount) {
      const total = Number(meta.total ?? currentItems.length);
      clientsCount.innerHTML = `
        <i class="fa-solid fa-users"></i>
        <span>${total} ${total > 1 ? 'clients' : 'client'}</span>
      `;
    }

    if (!tbody) return;

    if (!currentItems.length) {
      tbody.innerHTML = `
        <tr>
          <td colspan="10">
            <div class="clients-empty my-2">
              <i class="fa-solid fa-user-slash"></i>
              <div class="fw-bold mb-1">Aucun client trouvé</div>
              <div class="small">Aucun client ne correspond à la recherche actuelle.</div>
            </div>
          </td>
        </tr>
      `;
      renderPagination(meta);
      return;
    }

    tbody.innerHTML = currentItems.map(item => {
      const displayName = item.companyName || item.email || '—';
      const secondaryEmail = item.companyName && item.email ? item.email : '';
      const source = item.source === 'EBP' ? 'EBP' : 'Site';

      return `
      <tr>
        <td>
          <div class="client-primary-name">${esc(displayName)}</div>
          ${secondaryEmail ? `<div class="client-secondary-email">${esc(secondaryEmail)}</div>` : ''}
          <div class="client-address">${esc(item.address1 || item.address2 || '')}</div>
        </td>
        <td>
          <div class="client-code">${esc(item.customerCode || '—')}</div>
        </td>
        <td><span class="client-source client-source--${source === 'EBP' ? 'ebp' : 'site'}">${source}</span></td>
        <td>
          <div class="client-city">${esc(item.city || '—')}</div>
        </td>
        <td class="client-date">${displayClientDate(item.createdAt, 'short')}</td>
        <td class="client-date">${displayClientDate(item.updatedAt, 'short')}</td>
        <td>${item.lastOrderAt ? esc(new Date(item.lastOrderAt.replace(' ', 'T')).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })) : '—'}</td>
        <td>${Number(item.monthlyOrders) || 0}</td>
        <td>
          ${
            item.isActive
              ? '<span class="client-status-pill client-status-active"><i class="fa-solid fa-circle-check"></i>Actif</span>'
              : '<span class="client-status-pill client-status-inactive"><i class="fa-solid fa-circle-pause"></i>Inactif</span>'
          }
        </td>
        <td class="text-end">
          <div class="client-actions">
            <button class="btn btn-outline-primary btn-sm client-action-btn" type="button" data-edit="${item.id}">
              <i class="fa-solid fa-pen"></i>
            </button>
            <button class="btn btn-outline-danger btn-sm client-action-btn" type="button" data-delete="${item.id}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    `;
    }).join('');

    tbody.querySelectorAll('[data-edit]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = Number(btn.getAttribute('data-edit'));
        const item = currentItems.find(x => Number(x.id) === id);
        if (!item) return;

        resetForm();
        fillForm(item);
        modalTitle.textContent = 'Modifier le client';
        if (modal) modal.show();
      });
    });

    tbody.querySelectorAll('[data-delete]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = Number(btn.getAttribute('data-delete'));
        const item = currentItems.find(x => Number(x.id) === id);
        if (!item) return;

        const ok = confirm(`Supprimer le client ${item.companyName || item.email || ''} ?`);
        if (!ok) return;

        btn.disabled = true;

        try {
          const res = await fetch(deleteUrl(id), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ _token: CRUD_TOKEN })
          });

          const data = await res.json().catch(() => ({}));

          if (!res.ok || !data.ok) {
            alert(data.message || 'Erreur lors de la suppression');
            btn.disabled = false;
            return;
          }

          await loadClients();
        } catch (e) {
          alert('Erreur réseau');
          btn.disabled = false;
        }
      });
    });

    renderPagination(meta);
  }

  async function loadClients(page = currentPage){
    currentPage = Math.max(1, Number(page) || 1);
    setPageError('');
    if (tbody) {
      tbody.innerHTML = `<tr><td colspan="7" class="text-muted">Chargement…</td></tr>`;
    }

    try {
      const q = searchInput?.value?.trim() || '';
      const active = statusFilter?.value || '';
      const city = cityFilter?.value?.trim() || '';
      const url = new URL(API_LIST, window.location.origin);
      if (q) url.searchParams.set('q', q);
      if (active !== '') url.searchParams.set('active', active);
      if (city) url.searchParams.set('city', city);
      url.searchParams.set('page', String(currentPage));

      const res = await fetch(url.toString(), {
        headers: { 'Accept': 'application/json' }
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        setPageError(data.message || 'Impossible de charger les clients');
        if (tbody) {
          tbody.innerHTML = `<tr><td colspan="7" class="text-danger">Erreur chargement</td></tr>`;
        }
        return;
      }

      currentPage = Number(data.page || currentPage);
      renderRows(data.items || [], data);
    } catch (e) {
      setPageError('Erreur réseau');
      if (tbody) {
        tbody.innerHTML = `<tr><td colspan="5" class="text-danger">Erreur réseau</td></tr>`;
      }
    }
  }

  btnNewClient?.addEventListener('click', () => {
    resetForm();
    modalTitle.textContent = 'Nouveau client';

    if (modal) {
      modal.show();
    } else {
      alert('Bootstrap JS non chargé');
    }
  });

  btnReload?.addEventListener('click', () => loadClients(currentPage));
  btnEbpInvoicesSync?.addEventListener('click', async () => {
    if (!confirm('Lancer la récupération des factures pour tous les clients EBP actifs ?')) return;
    btnEbpInvoicesSync.disabled = true;
    try {
      const response = await fetch(API_EBP_INVOICES_SYNC, {
        method:'POST',
        headers:{'Content-Type':'application/json', 'Accept':'application/json'},
        body:JSON.stringify({_token:CRUD_TOKEN})
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) throw new Error(data.message || 'Chargement global impossible.');
      const failed = Number(data.queued?.failed || 0);
      setPageNotice((data.message || 'Demandes de factures envoyées.') + (failed ? ' ' + failed + ' demande(s) n’ont pas pu être envoyée(s).' : ''));
    } catch (error) {
      setPageError(error.message || 'Erreur réseau lors du chargement global des factures.');
    } finally {
      btnEbpInvoicesSync.disabled = false;
    }
  });
  btnEbpImportFocus?.addEventListener('click', () => {
    ebpUniqueId?.focus({preventScroll:false});
  });
  btnEbpRequest?.addEventListener('click', async () => {
    const uniqueId = ebpUniqueId?.value.trim().toUpperCase() || '';
    if (!/^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$/.test(uniqueId)) {
      setEbpMessage('Saisissez un UniqueId EBP valide.', 'danger');
      ebpUniqueId?.focus();
      return;
    }
    btnEbpRequest.disabled = true;
    try {
      const response = await fetch(API_EBP_IMPORTS, {
        method:'POST',
        headers:{'Content-Type':'application/json', 'Accept':'application/json'},
        body:JSON.stringify({_token:CRUD_TOKEN, uniqueId})
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) throw new Error(data.message || 'Demande impossible.');
      if (ebpUniqueId) ebpUniqueId.value = '';
      setEbpMessage(data.message || 'Demande envoyée à ApiRecept.');
      await loadEbpImports();
    } catch (error) {
      setEbpMessage(error.message || 'Erreur réseau.', 'danger');
    } finally {
      btnEbpRequest.disabled = false;
    }
  });
  ebpUniqueId?.addEventListener('keydown', event => {
    if (event.key === 'Enter') {
      event.preventDefault();
      btnEbpRequest?.click();
    }
  });
  btnEbpRefresh?.addEventListener('click', () => refreshEbpImports());
  btnEbpClear?.addEventListener('click', async () => {
    if (!ebpImportItems.length || !confirm('Vider toute la liste des demandes d’import EBP ? Les comptes déjà créés ne seront pas supprimés.')) return;
    btnEbpClear.disabled = true;
    try {
      const response = await fetch(API_EBP_CLEAR, {
        method:'POST',
        headers:{'Content-Type':'application/json', 'Accept':'application/json'},
        body:JSON.stringify({_token:CRUD_TOKEN})
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) throw new Error(data.message || 'Nettoyage impossible.');
      renderEbpImports([]);
      setEbpMessage(data.message || 'Liste des demandes vidée.');
    } catch (error) {
      setEbpMessage(error.message || 'Erreur réseau.', 'danger');
      btnEbpClear.disabled = false;
    }
  });

  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => loadClients(1), 300);
  });

  statusFilter?.addEventListener('change', () => loadClients(1));

  cityFilter?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => loadClients(1), 300);
  });

  btnSaveClient?.addEventListener('click', async () => {
    setFormError('');

    const payload = getPayload();
    const isEdit = clientId.value !== '';
    const url = isEdit ? updateUrl(clientId.value) : API_CREATE;

    if (!payload.email) {
      setFormError('Email obligatoire');
      return;
    }

    if (!isEdit && payload.password.trim().length < 6) {
      setFormError('Le mot de passe doit contenir au moins 6 caractères');
      return;
    }

    btnSaveClient.disabled = true;

    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        setFormError(data.message || 'Erreur enregistrement');
        btnSaveClient.disabled = false;
        return;
      }

      if (modal) modal.hide();
      await loadClients();
    } catch (e) {
      setFormError('Erreur réseau');
    } finally {
      btnSaveClient.disabled = false;
    }
  });

  loadClients();
  loadEbpImports();
  window.setInterval(() => {
    if (document.visibilityState === 'visible' && ebpImportItems.some(item => item.status === 'pending')) refreshEbpImports(true);
  }, 15000);
})();
</script>
{% endblock %}
