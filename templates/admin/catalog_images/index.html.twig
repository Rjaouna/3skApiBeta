{% extends 'base.html.twig' %}

{% block title %}Source des images catalogue{% endblock %}

{% block body %}
<style>
  .catalog-image-source{--cis-ink:#232B38;--cis-blue:#315FB7;--cis-orange:#FF8A00;--cis-bg:#F5F6F8;--cis-line:#dfe5ed;color:var(--cis-ink)}
  .catalog-image-source .cis-hero,.catalog-image-source .cis-card{background:#fff;border:1px solid var(--cis-line);border-radius:16px}.catalog-image-source .cis-hero{padding:25px 28px;margin-bottom:16px}.catalog-image-source .cis-kicker{color:var(--cis-orange);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.catalog-image-source h1{font-size:28px;margin:7px 0 8px}.catalog-image-source h2{font-size:18px;margin:0 0 6px}.catalog-image-source .cis-subtitle,.catalog-image-source .cis-help{color:#64748b;margin:0}.catalog-image-source .cis-card{padding:24px}.catalog-image-source label{font-size:13px;font-weight:700;margin-bottom:7px}.catalog-image-source .form-control{border-color:#cfd8e5;border-radius:10px;min-height:46px}.catalog-image-source .form-control:focus{border-color:var(--cis-blue);box-shadow:0 0 0 .2rem rgba(49,95,183,.13)}.catalog-image-source .cis-help{font-size:12px;line-height:1.5;margin-top:7px}.catalog-image-source .cis-primary{background:var(--cis-orange);border-color:var(--cis-orange);color:var(--cis-ink);font-weight:700}.catalog-image-source .cis-primary:hover{background:#e87d00;border-color:#e87d00;color:var(--cis-ink)}.catalog-image-source .btn{border-radius:10px;min-height:42px;font-weight:700}.catalog-image-source .cis-message{display:none;border-radius:11px;margin-bottom:16px;padding:12px 14px}.catalog-image-source .cis-message.visible{display:block}.catalog-image-source .cis-message.success{background:#edf9f1;border:1px solid #b9e7c8;color:#17673d}.catalog-image-source .cis-message.error{background:#fff1f2;border:1px solid #fecdd3;color:#a6172d}.catalog-image-source .cis-status{display:flex;justify-content:space-between;gap:15px;border-bottom:1px solid #edf0f4;font-size:14px;padding:12px 0}.catalog-image-source .cis-status:last-child{border:0}.catalog-image-source .cis-status span{color:#64748b}.catalog-image-source .cis-badge{background:#edf9f1;border-radius:999px;color:#17673d;font-size:12px;font-weight:700;padding:5px 9px}.catalog-image-source .cis-preview{display:grid;gap:12px;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:17px}.catalog-image-source .cis-thumb{background:var(--cis-bg);border:1px solid var(--cis-line);border-radius:12px;overflow:hidden}.catalog-image-source .cis-thumb img{background:#fff;display:block;height:112px;object-fit:contain;width:100%}.catalog-image-source .cis-thumb div{font-size:12px;font-weight:700;overflow:hidden;padding:9px;text-overflow:ellipsis;white-space:nowrap}.catalog-image-source .cis-thumb small{color:#64748b;display:block;font-size:11px;font-weight:400;margin-top:3px}.catalog-image-source .cis-empty{background:var(--cis-bg);border-radius:10px;color:#64748b;font-size:13px;margin-top:16px;padding:14px}.catalog-image-source .cis-tested{font-size:12px;margin-top:14px}.catalog-image-source .cis-tested.ok{color:#17673d}.catalog-image-source .cis-tested.error{color:#a6172d}@media(max-width:575.98px){.catalog-image-source .cis-hero,.catalog-image-source .cis-card{border-radius:13px;padding:18px}.catalog-image-source h1{font-size:24px}.catalog-image-source .cis-preview{grid-template-columns:1fr 1fr}.catalog-image-source .cis-thumb img{height:95px}}
  .catalog-image-source .cis-cache{border-top:1px solid var(--cis-line);margin-top:24px;padding-top:22px}.catalog-image-source .cis-cache .btn{max-width:100%;white-space:normal}
</style>

<main class="container py-4 catalog-image-source" data-save-token="{{ saveToken|e('html_attr') }}" data-test-token="{{ testToken|e('html_attr') }}" data-purge-token="{{ purgeToken|e('html_attr') }}">
  <section class="cis-hero"><div class="cis-kicker">Catalogue produits</div><h1>Source des images</h1><p class="cis-subtitle">Définissez l’URL publique où ApiLocal publie les fichiers <code>UniqueId.png</code>.</p></section>
  <div class="row g-3">
    <div class="col-lg-7"><section class="cis-card"><div id="cisMessage" class="cis-message" role="status" aria-live="polite"></div><h2>Adresse publique des PNG</h2><p class="cis-help mb-3">Utilisez l’URL HTTP(S) visible par les visiteurs, pas l’adresse FTPS. Un chemin local tel que <code>/ebpsynch</code> reste possible pour une installation sur le même site.</p><form id="cisForm" novalidate><label for="cisBaseUrl">URL ou chemin des images</label><input id="cisBaseUrl" class="form-control" type="text" autocomplete="url" value="{{ configuration.baseUrl ?? fallbackBaseUrl }}" placeholder="https://cdn.exemple.fr/catalogue" maxlength="500" required><p class="cis-help">Chaque image est demandée sous la forme <code>…/UniqueId.png</code>.</p><div class="d-flex flex-wrap gap-2 mt-4"><button id="cisSave" type="submit" class="btn cis-primary"><i class="fa-solid fa-floppy-disk me-1"></i> Enregistrer</button><button id="cisTest" type="button" class="btn btn-outline-primary"><i class="fa-solid fa-images me-1"></i> Tester et prévisualiser</button></div></form><div class="cis-cache"><h2>Recharger les photos du catalogue</h2><p class="cis-help">Si une photo existe mais ne s’affiche pas, purgez son cache pour demander un nouveau chargement de toutes les photos. Les fichiers d’origine sont conservés.</p><button id="cisPurge" type="button" class="btn btn-outline-primary mt-3"><i class="fa-solid fa-rotate me-1" aria-hidden="true"></i> Purger le cache des photos</button><p class="cis-help">S’applique à la source enregistrée, puis à la prochaine actualisation du catalogue, des fiches produits et du panier.</p></div></section></div>
    <div class="col-lg-5"><section class="cis-card"><h2>Vérification</h2><div class="cis-status"><span>Source active</span><strong id="cisCurrentUrl" class="text-end text-break">{{ fallbackBaseUrl }}</strong></div><div class="cis-status"><span>Dernier test</span><strong>{{ configuration.lastTestedAt ? configuration.lastTestedAt|date('d/m/Y H:i') : 'Jamais' }}</strong></div><div class="cis-status"><span>État</span><strong class="cis-badge">Configuration locale</strong></div>{% if configuration.lastError %}<p class="cis-tested error">Dernière erreur : {{ configuration.lastError }}</p>{% endif %}<div id="cisTestResult" class="cis-tested"></div></section>
      <section class="cis-card mt-3"><h2>Exemples d’images</h2><p class="cis-help">Les miniatures sont choisies parmi les derniers articles synchronisés.</p><div id="cisPreview" class="cis-preview">{% for sample in samples %}<article class="cis-thumb"><img src="{{ sample.url }}" alt="{{ sample.label }}" loading="lazy"><div>{{ sample.label }}<small>{{ sample.uniqueId }}</small></div></article>{% else %}<p class="cis-empty">Synchronisez d’abord quelques articles pour disposer de miniatures de test.</p>{% endfor %}</div></section>
    </div>
  </div>
</main>
<script>
(() => {
  const root=document.querySelector('.catalog-image-source'), form=document.getElementById('cisForm'), input=document.getElementById('cisBaseUrl'), message=document.getElementById('cisMessage'), save=document.getElementById('cisSave'), test=document.getElementById('cisTest'), purge=document.getElementById('cisPurge'), preview=document.getElementById('cisPreview');
  const esc=value=>String(value??'').replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
  const show=(text,type)=>{message.textContent=text;message.className=`cis-message visible ${type}`;};
  const request=async(url,body)=>{const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)});const data=await response.json().catch(()=>({}));if(!response.ok||!data.ok)throw new Error(data.message||'Une erreur est survenue.');return data;};
  const busy=value=>{save.disabled=value;test.disabled=value;purge.disabled=value;};
  const draw=samples=>{preview.innerHTML=(samples||[]).map(sample=>`<article class="cis-thumb"><img src="${esc(sample.url)}" alt="${esc(sample.label)}" loading="lazy"><div>${esc(sample.label)}<small>${sample.available === true ? 'Disponible' : (sample.available === false ? 'Indisponible' : 'Rechargement demandé')}${sample.status ? ` · HTTP ${esc(sample.status)}` : ''}</small></div></article>`).join('')||'<p class="cis-empty">Aucun article disponible pour le test.</p>';};
  form.addEventListener('submit',async event=>{event.preventDefault();busy(true);try{const data=await request('{{ path('admin_catalog_images_save') }}',{_token:root.dataset.saveToken,baseUrl:input.value});document.getElementById('cisCurrentUrl').textContent=data.baseUrl;show(data.message,'success');}catch(error){show(error.message,'error');}finally{busy(false);}});
  test.addEventListener('click',async()=>{if(!form.reportValidity())return;busy(true);try{const data=await request('{{ path('admin_catalog_images_test') }}',{_token:root.dataset.testToken,baseUrl:input.value});draw(data.samples);document.getElementById('cisTestResult').textContent=data.message;document.getElementById('cisTestResult').className='cis-tested ok';show('Prévisualisation actualisée.','success');}catch(error){document.getElementById('cisTestResult').textContent=error.message;document.getElementById('cisTestResult').className='cis-tested error';show(error.message,'error');}finally{busy(false);}});
  purge.addEventListener('click', async () => {
    const label = purge.innerHTML;
    busy(true);
    purge.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin me-1" aria-hidden="true"></i> Purge en cours…';
    try {
      const data = await request('{{ path('admin_catalog_images_purge') }}', {_token: root.dataset.purgeToken});
      draw(data.samples);
      document.getElementById('cisCurrentUrl').textContent = data.baseUrl;
      document.getElementById('cisTestResult').textContent = '';
      show(data.message, 'success');
    } catch (error) {
      show(error.message, 'error');
    } finally {
      purge.innerHTML = label;
      busy(false);
    }
  });
})();
</script>
{% endblock %}
