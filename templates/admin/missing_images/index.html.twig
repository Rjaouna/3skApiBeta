{% extends 'base.html.twig' %}

{% block title %}Articles sans photo | 3SK Parts Auto{% endblock %}

{% block body %}
<style>
  .missing-images-page {
    --missing-line: rgba(35, 43, 56, .14);
    --missing-muted: rgba(35, 43, 56, .68);
    padding-block: 1.5rem 2.5rem;
  }

  .missing-images-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .missing-images-heading h1 {
    margin: 0;
    color: var(--brand-anthracite);
    font: 700 28px/1.15 Montserrat, Arial, sans-serif;
  }

  .missing-images-kicker {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin: 0 0 .4rem;
    color: var(--brand-blue);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .missing-images-kicker::before {
    width: 26px;
    height: 2px;
    content: '';
    background: var(--brand-orange);
  }

  .missing-images-total {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 38px;
    padding: .45rem .7rem;
    border: 1px solid var(--missing-line);
    border-radius: 6px;
    background: var(--brand-surface);
    color: var(--brand-anthracite);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .missing-images-total i { color: var(--brand-orange); }

  .missing-images-panel {
    border: 1px solid var(--missing-line);
    border-radius: 8px;
    background: var(--brand-surface);
    overflow: hidden;
  }

  .missing-images-toolbar {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .85rem;
    border-bottom: 1px solid var(--missing-line);
    background: var(--brand-bg);
  }

  .missing-images-search {
    position: relative;
    width: min(420px, 100%);
  }

  .missing-images-search i {
    position: absolute;
    top: 50%;
    left: .8rem;
    color: var(--brand-blue);
    pointer-events: none;
    transform: translateY(-50%);
  }

  .missing-images-search input {
    width: 100%;
    min-height: 40px;
    padding: .5rem .75rem .5rem 2.35rem;
    border: 1px solid var(--missing-line);
    border-radius: 6px;
    background: var(--brand-surface);
    color: var(--brand-anthracite);
    font-size: 14px;
  }

  .missing-images-search input:focus {
    outline: 0;
    border-color: var(--brand-blue);
    box-shadow: 0 0 0 3px rgba(49, 95, 183, .12);
  }

  .missing-images-table-wrap { overflow-x: auto; }

  .missing-images-table {
    width: 100%;
    min-width: 780px;
    margin: 0;
    border-collapse: collapse;
  }

  .missing-images-table th {
    padding: .7rem .85rem;
    border-bottom: 1px solid var(--missing-line);
    background: var(--brand-bg);
    color: var(--missing-muted);
    font-size: 12px;
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
  }

  .missing-images-table td {
    padding: .78rem .85rem;
    border-bottom: 1px solid var(--missing-line);
    color: var(--brand-anthracite);
    font-size: 14px;
    vertical-align: middle;
  }

  .missing-images-table tbody tr:last-child td { border-bottom: 0; }
  .missing-images-table tbody tr.is-detected { background: rgba(25, 135, 84, .08); }

  .missing-images-ref {
    color: var(--brand-blue);
    font-weight: 700;
    white-space: nowrap;
  }

  .missing-images-designation {
    display: block;
    max-width: 340px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
  }

  .missing-images-meta {
    color: var(--missing-muted);
    font-size: 13px;
  }

  .missing-images-status {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--missing-muted);
    font-size: 13px;
    white-space: nowrap;
  }

  .missing-images-actions {
    display: flex;
    justify-content: flex-end;
    gap: .4rem;
  }

  .missing-images-icon-button {
    display: inline-grid;
    width: 36px;
    height: 36px;
    place-items: center;
    padding: 0;
    border: 1px solid var(--missing-line);
    border-radius: 6px;
    background: var(--brand-surface);
    color: var(--brand-blue);
    text-decoration: none;
  }

  .missing-images-icon-button:hover,
  .missing-images-icon-button:focus-visible {
    border-color: var(--brand-blue);
    background: rgba(49, 95, 183, .08);
    color: var(--brand-blue);
  }

  .missing-images-icon-button:disabled {
    cursor: wait;
    opacity: .65;
  }

  .missing-images-empty {
    padding: 2.5rem 1rem;
    color: var(--missing-muted);
    font-size: 14px;
    text-align: center;
  }

  .missing-images-pagination {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: .55rem;
    padding: .85rem;
    border-top: 1px solid var(--missing-line);
  }

  .missing-images-pagination span {
    min-width: 58px;
    color: var(--missing-muted);
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 575.98px) {
    .missing-images-page { padding-top: 1rem; }
    .missing-images-heading h1 { font-size: 24px; }
    .missing-images-heading { align-items: center; }
    .missing-images-toolbar { padding: .65rem; }
    .missing-images-total { min-height: 34px; font-size: 12px; }
  }
</style>

<main class="container-fluid missing-images-page">
  <div class="missing-images-heading">
    <div>
      <div class="missing-images-kicker">Contrôle catalogue</div>
      <h1>Articles sans photo</h1>
    </div>
    <span class="missing-images-total" data-total aria-live="polite">
      <i class="fa-regular fa-image" aria-hidden="true"></i>
      <span data-total-value>Chargement</span>
    </span>
  </div>

  <section class="missing-images-panel" aria-label="Liste des articles sans photo">
    <div class="missing-images-toolbar">
      <label class="visually-hidden" for="missingImageSearch">Rechercher un article</label>
      <div class="missing-images-search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input id="missingImageSearch" type="search" autocomplete="off" placeholder="Référence, désignation, marque ou véhicule">
      </div>
    </div>

    <div class="missing-images-table-wrap">
      <table class="missing-images-table">
        <thead>
          <tr>
            <th>Référence</th>
            <th>Article</th>
            <th>Marque</th>
            <th>Véhicule</th>
            <th>État</th>
            <th aria-label="Actions"></th>
          </tr>
        </thead>
        <tbody data-rows>
          <tr><td colspan="6" class="missing-images-empty">Chargement des articles...</td></tr>
        </tbody>
      </table>
    </div>

    <div class="missing-images-pagination" data-pagination>
      <button class="missing-images-icon-button" type="button" data-prev aria-label="Page précédente" title="Page précédente" disabled><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
      <span data-page>1 / 1</span>
      <button class="missing-images-icon-button" type="button" data-next aria-label="Page suivante" title="Page suivante" disabled><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
    </div>
  </section>
</main>

<script>
(() => {
  const endpoint = {{ path('api_admin_missing_images_list')|json_encode|raw }};
  const checkEndpoint = {{ path('api_admin_missing_images_check', { uniqueId: '00000000-0000-0000-0000-000000000000' })|json_encode|raw }};
  const checkToken = {{ checkToken|json_encode|raw }};
  const articleUrl = {{ path('article_show', { code: '__ARTICLE_CODE__' })|json_encode|raw }};
  const search = document.getElementById('missingImageSearch');
  const rows = document.querySelector('[data-rows]');
  const totalValue = document.querySelector('[data-total-value]');
  const pageLabel = document.querySelector('[data-page]');
  const previous = document.querySelector('[data-prev]');
  const next = document.querySelector('[data-next]');
  let timer = null;
  let state = { page: 1, pages: 1, total: 0, q: '' };

  const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
  }[char]));

  const articleHref = code => articleUrl.replace('__ARTICLE_CODE__', encodeURIComponent(code || ''));
  const checkHref = uniqueId => checkEndpoint.replace('00000000-0000-0000-0000-000000000000', encodeURIComponent(uniqueId));

  function updateSummary() {
    totalValue.textContent = `${state.total} article${state.total > 1 ? 's' : ''}`;
    pageLabel.textContent = `${state.page} / ${state.pages}`;
    previous.disabled = state.page <= 1;
    next.disabled = state.page >= state.pages;
  }

  function render(items) {
    if (!items.length) {
      rows.innerHTML = '<tr><td colspan="6" class="missing-images-empty">Aucun article sans photo.</td></tr>';
      return;
    }

    rows.innerHTML = items.map(item => `
      <tr data-row data-unique-id="${escapeHtml(item.uniqueId)}">
        <td><span class="missing-images-ref">${escapeHtml(item.code || item.uniqueId)}</span></td>
        <td><span class="missing-images-designation" title="${escapeHtml(item.designation)}">${escapeHtml(item.designation || '-')}</span></td>
        <td class="missing-images-meta">${escapeHtml(item.brand || '-')}</td>
        <td class="missing-images-meta">${escapeHtml(item.vehicle || '-')}</td>
        <td><span class="missing-images-status" data-status><i class="fa-regular fa-circle-xmark" aria-hidden="true"></i>À contrôler</span></td>
        <td>
          <div class="missing-images-actions">
            <a class="missing-images-icon-button" href="${articleHref(item.code)}" aria-label="Voir l'article" title="Voir l'article"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
            <button class="missing-images-icon-button" type="button" data-check aria-label="Vérifier la photo" title="Vérifier la photo" data-check-url="${checkHref(item.uniqueId)}"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></button>
          </div>
        </td>
      </tr>
    `).join('');

    rows.querySelectorAll('[data-check]').forEach(button => button.addEventListener('click', checkImage));
  }

  async function load() {
    rows.innerHTML = '<tr><td colspan="6" class="missing-images-empty">Chargement des articles...</td></tr>';
    const url = new URL(endpoint, window.location.origin);
    url.searchParams.set('page', String(state.page));
    url.searchParams.set('limit', '50');
    if (state.q) url.searchParams.set('q', state.q);

    try {
      const response = await fetch(url, { headers: { Accept: 'application/json' } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) throw new Error('load-failed');

      state = { ...state, page: data.page, pages: data.pages, total: data.total };
      render(data.items || []);
      updateSummary();
    } catch {
      rows.innerHTML = '<tr><td colspan="6" class="missing-images-empty">Chargement temporairement indisponible.</td></tr>';
    }
  }

  async function checkImage(event) {
    const button = event.currentTarget;
    const row = button.closest('[data-row]');
    const status = row?.querySelector('[data-status]');
    if (!row || !status || button.disabled) return;

    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>';

    try {
      const response = await fetch(button.dataset.checkUrl, {
        method: 'POST',
        headers: { Accept: 'application/json', 'X-CSRF-TOKEN': checkToken },
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) throw new Error('check-failed');

      if (data.imageDetected) {
        status.className = 'missing-images-status text-success';
        status.innerHTML = '<i class="fa-solid fa-circle-check" aria-hidden="true"></i>Photo détectée';
        row.classList.add('is-detected');
        state.total = Math.max(0, state.total - 1);
        updateSummary();
        window.dispatchEvent(new CustomEvent('admin:missing-image-detected', { detail: { count: state.total } }));
        window.setTimeout(() => {
          row.remove();
          if (!rows.querySelector('[data-row]')) render([]);
        }, 650);
        return;
      }

      status.className = 'missing-images-status text-danger';
      status.innerHTML = '<i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>Photo non détectée';
    } catch {
      status.className = 'missing-images-status text-danger';
      status.innerHTML = '<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>Vérification indisponible';
    } finally {
      if (!row.classList.contains('is-detected')) {
        button.disabled = false;
        button.innerHTML = '<i class="fa-solid fa-circle-check" aria-hidden="true"></i>';
      }
    }
  }

  search?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      state.page = 1;
      state.q = search.value.trim();
      load();
    }, 220);
  });

  previous?.addEventListener('click', () => {
    if (state.page <= 1) return;
    state.page--;
    load();
  });

  next?.addEventListener('click', () => {
    if (state.page >= state.pages) return;
    state.page++;
    load();
  });

  load();
})();
</script>
{% endblock %}
