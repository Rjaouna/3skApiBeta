{% extends 'base.html.twig' %}

{% block body %}
<style>
  :root{
    --oc-radius: 22px;
    --oc-border: rgba(0,0,0,.10);
    --oc-shadow: 0 14px 34px rgba(0,0,0,.08);
    --oc-muted: rgba(0,0,0,.58);
    --oc-text: rgba(0,0,0,.84);
    --oc-glass: rgba(255,255,255,.82);
    --oc-glass-2: rgba(255,255,255,.60);
  }

  body.theme-dark{
    --oc-border: rgba(255,255,255,.14);
    --oc-shadow: 0 18px 46px rgba(0,0,0,.35);
    --oc-muted: rgba(255,255,255,.62);
    --oc-text: rgba(255,255,255,.88);
    --oc-glass: rgba(18,18,22,.76);
    --oc-glass-2: rgba(18,18,22,.58);
  }

  .orders-page-hero{
    border-radius: 24px;
    border: 1px solid var(--oc-border);
    box-shadow: var(--oc-shadow);
    padding: 18px;
    background:
      radial-gradient(900px circle at 10% 10%, rgba(var(--bs-primary-rgb), .16), transparent 40%),
      radial-gradient(900px circle at 90% 30%, rgba(var(--bs-secondary-rgb), .14), transparent 38%),
      linear-gradient(180deg, rgba(0,0,0,.02), transparent);
  }

  .orders-page-hero h3{
    margin: 0;
    font-weight: 650;
    color: var(--oc-text);
  }

  .orders-page-hero .subtitle{
    margin-top: 6px;
    color: var(--oc-muted);
    font-size: .92rem;
    font-weight: 600;
  }

  .orders-filter-card,
  .orders-table-card{
    border-radius: var(--oc-radius);
    border: 1px solid var(--oc-border);
    box-shadow: var(--oc-shadow);
    background: var(--oc-glass);
    backdrop-filter: blur(8px);
  }

  .orders-filter-card .card-body,
  .orders-table-card .card-body{
    padding: 18px;
  }

  .orders-filter-label{
    font-size: .82rem;
    font-weight: 600;
    color: var(--oc-muted);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: .03em;
  }

  .orders-filter-card .form-select,
  .orders-filter-card .form-control{
    min-height: 48px;
    border-radius: 14px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.75);
    color: var(--oc-text);
    font-weight: 700;
  }

  body.theme-dark .orders-filter-card .form-select,
  body.theme-dark .orders-filter-card .form-control{
    background: rgba(255,255,255,.06);
    color: var(--oc-text);
  }

  .orders-filter-card .btn{
    min-height: 48px;
    border-radius: 14px;
    font-weight: 600;
    padding-inline: 18px;
  }

  .orders-meta-row{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .orders-meta-left{
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .orders-count-badge{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 8px 12px;
    border: 1px solid var(--oc-border);
    background: var(--oc-glass-2);
    color: var(--oc-text);
    font-size: .82rem;
    font-weight: 600;
  }

  .orders-count-badge i{
    color: var(--bs-primary);
  }

  .orders-table{
    margin: 0;
  }

  .orders-table thead th{
    border-bottom: 1px solid var(--oc-border);
    color: var(--oc-muted);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    font-weight: 600;
    padding: 14px 12px;
    white-space: nowrap;
    background: transparent;
  }

  .orders-table tbody tr{
    transition: background .12s ease, transform .12s ease;
  }

  .orders-table tbody tr:hover{
    background: rgba(var(--bs-primary-rgb), .04);
  }

  .orders-table tbody td{
    padding: 16px 12px;
    border-color: rgba(0,0,0,.06);
    vertical-align: middle;
    color: var(--oc-text);
  }

  body.theme-dark .orders-table tbody td{
    border-color: rgba(255,255,255,.08);
  }

  .order-number{
    font-weight: 650;
    color: var(--bs-primary);
    line-height: 1.2;
  }

  .order-date{
    font-weight: 550;
    white-space: nowrap;
  }

  .order-client{
    min-width: 220px;
  }

  .order-client-email{
    font-weight: 550;
    color: var(--oc-text);
    line-height: 1.2;
  }

  .order-client-company{
    margin-top: 4px;
    font-size: .82rem;
    color: var(--oc-muted);
    font-weight: 700;
  }

  .order-city{
    font-weight: 550;
  }

  .order-total{
    font-weight: 650;
    font-size: 1rem;
    color: var(--oc-text);
    white-space: nowrap;
  }

  .order-action-btn{
    border-radius: 12px;
    font-weight: 600;
    padding-inline: 14px;
  }

  .order-actions-inline{
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    flex-wrap: wrap;
  }

  .order-delete-btn{
    color: var(--bs-danger) !important;
    border-color: rgba(var(--bs-danger-rgb), .34) !important;
    background: rgba(var(--bs-danger-rgb), .04) !important;
  }

  .order-delete-btn:hover{
    color: #fff !important;
    background: var(--bs-danger) !important;
    border-color: var(--bs-danger) !important;
  }

  .orders-danger-btn{
    min-height: 42px;
    border-radius: 999px;
    font-weight: 650;
    padding-inline: 14px;
  }

  .orders-delete-modal .modal-content{
    border: 0;
    border-radius: 24px;
    box-shadow: 0 24px 80px rgba(var(--brand-anthracite-rgb), .24);
    overflow: hidden;
  }

  .orders-delete-modal .modal-header{
    border: 0;
    padding: 20px 22px 10px;
  }

  .orders-delete-modal .modal-body{
    padding: 10px 22px 22px;
  }

  .orders-delete-modal__icon{
    width: 48px;
    height: 48px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    color: var(--bs-danger);
    background: rgba(var(--bs-danger-rgb), .10);
    margin-bottom: 14px;
  }

  .orders-delete-modal__title{
    margin: 0;
    font-size: 1.16rem;
    font-weight: 750;
    color: var(--oc-text);
  }

  .orders-delete-modal__text{
    margin: 8px 0 0;
    color: var(--oc-muted);
    font-size: .92rem;
    line-height: 1.45;
  }

  .orders-delete-modal .form-label{
    font-size: .78rem;
    font-weight: 650;
    color: var(--oc-muted);
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .orders-delete-modal .form-control{
    min-height: 48px;
    border-radius: 14px;
  }

  .orders-delete-modal .modal-footer{
    border-top: 1px solid rgba(0,0,0,.06);
    padding: 14px 22px 20px;
  }

  .status-pill{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: .78rem;
    font-weight: 600;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .status-pill i{
    font-size: .78rem;
  }

  .status-new{
    background: rgba(13,110,253,.12);
    color: rgba(13,110,253,1);
    border-color: rgba(13,110,253,.18);
  }


  .status-exported{
    background: rgba(49,95,183,.16);
    color: #315FB7;
    border-color: rgba(49,95,183,.28);
  }

  .status-preparing{
    background: rgba(255,193,7,.16);
    color: rgba(176,117,0,.98);
    border-color: rgba(255,193,7,.24);
  }

  .status-shipping{
    background: rgba(111,66,193,.14);
    color: rgba(111,66,193,1);
    border-color: rgba(111,66,193,.22);
  }

  .status-completed{
    background: rgba(25,135,84,.12);
    color: rgba(25,135,84,1);
    border-color: rgba(25,135,84,.20);
  }

  .status-cancelled{
    background: rgba(220,53,69,.12);
    color: rgba(220,53,69,.98);
    border-color: rgba(220,53,69,.20);
  }

  .empty-orders{
    border-radius: 20px;
    border: 1px dashed var(--oc-border);
    background: rgba(255,255,255,.42);
    padding: 44px 18px;
    text-align: center;
    color: var(--oc-muted);
  }

  body.theme-dark .empty-orders{
    background: rgba(255,255,255,.03);
  }

  .empty-orders i{
    font-size: 2rem;
    margin-bottom: 12px;
    color: var(--bs-secondary);
  }

  .mobile-orders{
    display: none;
  }

  .mobile-order-card{
    border-radius: 18px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.52);
    padding: 14px;
  }

  body.theme-dark .mobile-order-card{
    background: rgba(255,255,255,.04);
  }

  .mobile-order-top{
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .mobile-order-number{
    font-weight: 650;
    color: var(--bs-primary);
    line-height: 1.2;
  }

  .mobile-order-date{
    font-size: .82rem;
    color: var(--oc-muted);
    font-weight: 700;
    margin-top: 4px;
  }

  .mobile-order-grid{
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 10px;
    margin-bottom: 12px;
  }

  .mobile-order-box{
    border-radius: 14px;
    border: 1px solid var(--oc-border);
    padding: 10px 12px;
    background: rgba(255,255,255,.55);
  }

  body.theme-dark .mobile-order-box{
    background: rgba(18,18,22,.50);
  }

  .mobile-order-label{
    font-size: .72rem;
    color: var(--oc-muted);
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .mobile-order-value{
    font-size: .88rem;
    color: var(--oc-text);
    font-weight: 550;
    line-height: 1.35;
    word-break: break-word;
  }

  .mobile-order-actions{
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    flex-wrap: wrap;
  }

  @media (max-width: 991.98px){
    .desktop-orders{
      display: none;
    }

    .mobile-orders{
      display: grid;
      gap: 12px;
    }
  }
</style>

<div class="container py-4">
  <div class="orders-page-hero mb-3 d-flex align-items-start justify-content-between flex-wrap gap-2">
    <div>
      <h3>Gestion des commandes</h3>
      <div class="subtitle">Suivi admin des commandes clients.</div>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
      <div class="orders-count-badge">
        <i class="fa-solid fa-box-open"></i>
        <span>{{ orders|length }} commande{{ orders|length > 1 ? 's' : '' }}</span>
      </div>

      {% if newOrdersCount|default(0) > 0 %}
        <form method="post" action="{{ path('admin_orders_export_new_ebp') }}" data-export-new-orders-form>
          <input type="hidden" name="_token" value="{{ csrf_token('export_new_orders_ebp') }}">
          <button class="btn btn-primary orders-danger-btn" type="submit" data-export-new-orders-button>
            <i class="fa-solid fa-paper-plane me-2"></i>
            Exporter {{ newOrdersCount }} commande{{ newOrdersCount > 1 ? 's' : '' }} nouvelle{{ newOrdersCount > 1 ? 's' : '' }}
          </button>
        </form>
      {% endif %}

      {% if totalOrders|default(0) > 0 %}
        <button class="btn btn-outline-danger orders-danger-btn" type="button" data-bs-toggle="modal" data-bs-target="#deleteAllOrdersModal">
          <i class="fa-solid fa-trash-can me-2"></i>Supprimer toutes
        </button>
      {% endif %}
    </div>
  </div>

  <div class="orders-filter-card mb-3">
    <div class="card-body">
      <form method="get" class="row g-2 align-items-end">
        <div class="col-12 col-lg-3">
          <label class="orders-filter-label">Recherche</label>
          <input type="search" name="q" class="form-control" value="{{ currentQuery }}" placeholder="N°, client, email, code...">
        </div>

        <div class="col-6 col-lg-2">
          <label class="orders-filter-label">Statut</label>
          <select name="status" class="form-select">
            <option value="">Tous</option>
            {% for status in statuses %}
              <option value="{{ status }}" {% if currentStatus == status %}selected{% endif %}>
                {{ labels[status] }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="col-6 col-lg-2">
          <label class="orders-filter-label">Ville</label>
          <input type="text" name="city" class="form-control" value="{{ currentCity }}" placeholder="Ville">
        </div>

        <div class="col-6 col-lg-2">
          <label class="orders-filter-label">Du</label>
          <input type="date" name="dateFrom" class="form-control" value="{{ currentDateFrom }}">
        </div>

        <div class="col-6 col-lg-2">
          <label class="orders-filter-label">Au</label>
          <input type="date" name="dateTo" class="form-control" value="{{ currentDateTo }}">
        </div>

        <div class="col-md-auto">
          <button class="btn btn-primary" type="submit">
            <i class="fa-solid fa-filter me-2"></i>Filtrer
          </button>
        </div>

        {% if currentStatus or currentQuery or currentDateFrom or currentDateTo or currentCity %}
          <div class="col-md-auto">
            <a href="{{ path('admin_orders_index') }}" class="btn btn-outline-secondary">
              <i class="fa-solid fa-rotate-left me-2"></i>Réinitialiser
            </a>
          </div>
        {% endif %}
      </form>
    </div>
  </div>

  <div class="orders-table-card">
    <div class="card-body">
      <div class="orders-meta-row">
        <div class="orders-meta-left">
          <div class="orders-count-badge">
            <i class="fa-solid fa-clipboard-list"></i>
            <span>
              {% if currentStatus %}
                Statut : {{ labels[currentStatus] ?? currentStatus }}
              {% else %}
                Toutes les commandes
              {% endif %}
            </span>
          </div>
        </div>
      </div>

      {% if orders is empty %}
        <div class="empty-orders">
          <i class="fa-solid fa-inbox"></i>
          <div class="fw-bold mb-1">Aucune commande</div>
          <div class="small">Aucune commande ne correspond au filtre actuel.</div>
        </div>
      {% else %}
        <div class="table-responsive desktop-orders">
          <table class="table orders-table align-middle mb-0">
            <thead>
              <tr>
                <th>N°</th>
                <th>Date</th>
                <th>Client</th>
                <th>Ville</th>
                <th>Statut</th>
                <th class="text-end">Total</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for order in orders %}
                {% set statusClass =
                  order.status == 'new' ? 'status-new' :
                  (order.status == 'exported' ? 'status-exported' :
                  (order.status == 'preparing' ? 'status-preparing' :
                  (order.status == 'shipping' ? 'status-shipping' :
                  (order.status == 'completed' ? 'status-completed' : 'status-cancelled'))))
                %}
                {% set statusIcon =
                  order.status == 'new' ? 'fa-file-circle-plus' :
                  (order.status == 'exported' ? 'fa-paper-plane' :
                  (order.status == 'preparing' ? 'fa-boxes-packing' :
                  (order.status == 'shipping' ? 'fa-truck-fast' :
                  (order.status == 'completed' ? 'fa-circle-check' : 'fa-ban'))))
                %}

                <tr>
                  <td>
                    <div class="order-number">{{ order.orderNumber }}</div>
                  </td>

                  <td>
                    <div class="order-date">
                      {{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '—' }}
                    </div>
                  </td>

                  <td class="order-client">
                    <div class="order-client-email">{{ order.companyName ?: '—' }}</div>
                    <div class="order-client-company">{{ order.customerEmail }}</div>
                  </td>

                  <td>
                    <div class="order-city">{{ order.city ?: '—' }}</div>
                  </td>

                  <td>
                    <span class="status-pill {{ statusClass }}">
                      <i class="fa-solid {{ statusIcon }}"></i>
                      {{ order.statusLabel }}
                    </span>
                  </td>

                  <td class="text-end">
                    <div class="order-total">{{ order.totalTtc }} DH</div>
                  </td>

                  <td class="text-end">
                    <div class="order-actions-inline">
                      <a class="btn btn-outline-primary btn-sm order-action-btn"
                         href="{{ path('admin_orders_show', {id: order.id}) }}">
                        <i class="fa-solid fa-eye me-1"></i>Voir
                      </a>

                      <button class="btn btn-outline-danger btn-sm order-action-btn order-delete-btn"
                              type="button"
                              data-bs-toggle="modal"
                              data-bs-target="#deleteOrderModal"
                              data-delete-order-action="{{ path('admin_orders_delete', {id: order.id}) }}"
                              data-delete-order-token="{{ csrf_token('delete_order_' ~ order.id) }}"
                              data-delete-order-number="{{ order.orderNumber }}">
                        <i class="fa-solid fa-trash-can me-1"></i>Supprimer
                      </button>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="mobile-orders">
          {% for order in orders %}
            {% set statusClass =
              order.status == 'new' ? 'status-new' :
              (order.status == 'preparing' ? 'status-preparing' :
              (order.status == 'shipping' ? 'status-shipping' :
              (order.status == 'completed' ? 'status-completed' : 'status-cancelled')))
            %}
            {% set statusIcon =
              order.status == 'new' ? 'fa-file-circle-plus' :
              (order.status == 'preparing' ? 'fa-boxes-packing' :
              (order.status == 'shipping' ? 'fa-truck-fast' :
              (order.status == 'completed' ? 'fa-circle-check' : 'fa-ban')))
            %}

            <div class="mobile-order-card">
              <div class="mobile-order-top">
                <div>
                  <div class="mobile-order-number">{{ order.orderNumber }}</div>
                  <div class="mobile-order-date">
                    {{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '—' }}
                  </div>
                </div>

                <span class="status-pill {{ statusClass }}">
                  <i class="fa-solid {{ statusIcon }}"></i>
                  {{ order.statusLabel }}
                </span>
              </div>

              <div class="mobile-order-grid">
                <div class="mobile-order-box">
                  <div class="mobile-order-label">Client</div>
                  <div class="mobile-order-value">{{ order.customerEmail }}</div>
                </div>

                <div class="mobile-order-box">
                  <div class="mobile-order-label">Société</div>
                  <div class="mobile-order-value">{{ order.companyName ?: '—' }}</div>
                </div>

                <div class="mobile-order-box">
                  <div class="mobile-order-label">Ville</div>
                  <div class="mobile-order-value">{{ order.city ?: '—' }}</div>
                </div>

                <div class="mobile-order-box">
                  <div class="mobile-order-label">Total</div>
                  <div class="mobile-order-value">{{ order.totalTtc }} DH</div>
                </div>
              </div>

              <div class="mobile-order-actions">
                <a class="btn btn-outline-primary btn-sm order-action-btn"
                   href="{{ path('admin_orders_show', {id: order.id}) }}">
                  <i class="fa-solid fa-eye me-1"></i>Voir
                </a>

                <button class="btn btn-outline-danger btn-sm order-action-btn order-delete-btn"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteOrderModal"
                        data-delete-order-action="{{ path('admin_orders_delete', {id: order.id}) }}"
                        data-delete-order-token="{{ csrf_token('delete_order_' ~ order.id) }}"
                        data-delete-order-number="{{ order.orderNumber }}">
                  <i class="fa-solid fa-trash-can me-1"></i>Supprimer
                </button>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="modal fade orders-delete-modal" id="deleteOrderModal" tabindex="-1" aria-labelledby="deleteOrderModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" method="post" id="deleteOrderForm">
      <div class="modal-header">
        <div>
          <div class="orders-delete-modal__icon">
            <i class="fa-solid fa-trash-can"></i>
          </div>
          <h5 class="orders-delete-modal__title" id="deleteOrderModalLabel">Supprimer la commande</h5>
          <p class="orders-delete-modal__text">
            Cette action supprimera définitivement la commande <strong data-delete-order-label>sélectionnée</strong> et ses lignes.
          </p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" name="_token" data-delete-order-token-input>

        <label class="form-label" for="deleteOrderPassword">Mot de passe admin</label>
        <input class="form-control"
               id="deleteOrderPassword"
               type="password"
               name="confirm_password"
               autocomplete="current-password"
               placeholder="Saisissez votre mot de passe"
               required>
        <div class="form-text text-muted mt-2">
          Le mot de passe du compte administrateur connecté est nécessaire pour confirmer.
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
        <button type="submit" class="btn btn-danger">
          <i class="fa-solid fa-trash-can me-2"></i>Supprimer
        </button>
      </div>
    </form>
  </div>
</div>

{% if totalOrders|default(0) > 0 %}
  <div class="modal fade orders-delete-modal" id="deleteAllOrdersModal" tabindex="-1" aria-labelledby="deleteAllOrdersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form class="modal-content" method="post" action="{{ path('admin_orders_delete_all') }}">
        <div class="modal-header">
          <div>
            <div class="orders-delete-modal__icon">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h5 class="orders-delete-modal__title" id="deleteAllOrdersModalLabel">Supprimer toutes les commandes</h5>
            <p class="orders-delete-modal__text">
              Cette action supprimera définitivement toutes les commandes enregistrées, avec leurs lignes de commande.
            </p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" name="_token" value="{{ csrf_token('delete_all_orders') }}">

          <div class="alert alert-danger small mb-3">
            Attention : cette suppression concerne toutes les commandes, pas seulement le filtre actuel.
          </div>

          <label class="form-label" for="deleteAllOrdersPassword">Mot de passe admin</label>
          <input class="form-control"
                 id="deleteAllOrdersPassword"
                 type="password"
                 name="confirm_password"
                 autocomplete="current-password"
                 placeholder="Saisissez votre mot de passe"
                 required>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash-can me-2"></i>Tout supprimer
          </button>
        </div>
      </form>
    </div>
  </div>
{% endif %}

<script>
(function () {
  document.querySelectorAll('[data-export-new-orders-form]').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      const button = form.querySelector('[data-export-new-orders-button]');
      if (!button || button.disabled) {
        event.preventDefault();
        return;
      }

      button.disabled = true;
      button.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Export en cours…';
    });
  });

  const deleteOrderModal = document.getElementById('deleteOrderModal');
  const deleteOrderForm = document.getElementById('deleteOrderForm');

  if (!deleteOrderModal || !deleteOrderForm) {
    return;
  }

  deleteOrderModal.addEventListener('show.bs.modal', function (event) {
    const trigger = event.relatedTarget;
    if (!trigger) {
      return;
    }

    const action = trigger.getAttribute('data-delete-order-action') || '';
    const token = trigger.getAttribute('data-delete-order-token') || '';
    const number = trigger.getAttribute('data-delete-order-number') || 'sélectionnée';
    const label = deleteOrderModal.querySelector('[data-delete-order-label]');
    const tokenInput = deleteOrderModal.querySelector('[data-delete-order-token-input]');
    const passwordInput = deleteOrderModal.querySelector('input[name="confirm_password"]');

    deleteOrderForm.setAttribute('action', action);

    if (tokenInput) {
      tokenInput.value = token;
    }

    if (label) {
      label.textContent = number;
    }

    if (passwordInput) {
      passwordInput.value = '';
      window.setTimeout(function () {
        passwordInput.focus();
      }, 180);
    }
  });
})();
</script>
{% endblock %}
