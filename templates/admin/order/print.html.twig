<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bon de commande {{ order.orderNumber }}</title>
  <style>
    :root {
      --print-primary: #0d47a1;
      --print-accent: #ff8a00;
      --print-text: #111827;
      --print-muted: #667085;
      --print-line: #d9e2ef;
      --print-soft: #f5f7fb;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #eef2f7;
      color: var(--print-text);
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12px;
      line-height: 1.3;
    }

    .print-page {
      width: min(100%, 920px);
      margin: 18px auto;
      padding: 24px 26px;
      background: #fff;
      border-radius: 18px;
      box-shadow: 0 18px 50px rgba(16, 24, 40, .12);
    }

    .print-toolbar {
      width: min(100%, 920px);
      margin: 24px auto 0;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }

    .print-btn {
      border: 1px solid var(--print-line);
      background: #fff;
      color: var(--print-primary);
      border-radius: 10px;
      padding: 10px 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .print-btn.primary {
      background: var(--print-primary);
      border-color: var(--print-primary);
      color: #fff;
    }

    .order-head {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 18px;
      align-items: start;
      padding-bottom: 14px;
      border-bottom: 2px solid var(--print-primary);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .brand-logo {
      width: 158px;
      max-height: 60px;
      object-fit: contain;
    }

    .brand-subtitle {
      margin-top: 3px;
      color: var(--print-muted);
      font-size: 10.5px;
      max-width: 360px;
      line-height: 1.25;
    }

    .order-title {
      text-align: right;
    }

    .order-title h1 {
      margin: 0;
      color: var(--print-primary);
      font-size: 25px;
      line-height: 1;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .order-title .number {
      margin-top: 7px;
      color: var(--print-text);
      font-weight: 700;
      font-size: 13px;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 12px;
      margin-top: 14px;
    }

    .box {
      border: 1px solid var(--print-line);
      border-radius: 11px;
      overflow: hidden;
      background: #fff;
    }

    .box-title {
      padding: 7px 10px;
      background: var(--print-soft);
      color: var(--print-primary);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      font-size: 10px;
    }

    .box-body {
      padding: 10px;
    }

    .client-name {
      margin-bottom: 3px;
      font-size: 14px;
      font-weight: 700;
      color: var(--print-text);
    }

    .muted {
      color: var(--print-muted);
    }

    .client-address {
      margin-top: 3px;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 4px 0;
      border-bottom: 1px solid #edf1f6;
    }

    .info-row:last-child {
      border-bottom: 0;
    }

    .info-row span:first-child {
      color: var(--print-muted);
    }

    .info-row strong {
      text-align: right;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 14px;
      border: 1px solid var(--print-line);
      border-radius: 11px;
      overflow: hidden;
    }

    thead th {
      background: var(--print-primary);
      color: #fff;
      padding: 8px 9px;
      text-align: left;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    tbody td {
      padding: 7px 9px;
      border-bottom: 1px solid #edf1f6;
      vertical-align: middle;
    }

    th:nth-child(1),
    td:nth-child(1) {
      width: 22%;
    }

    th:nth-child(3),
    td:nth-child(3) {
      width: 9%;
    }

    th:nth-child(4),
    td:nth-child(4) {
      width: 18%;
    }

    tbody tr:nth-child(even) td {
      background: #fbfcfe;
    }

    tbody tr:last-child td {
      border-bottom: 0;
    }

    tbody tr {
      page-break-inside: avoid;
    }

    .text-end {
      text-align: right;
    }

    .ref {
      color: var(--print-primary);
      font-weight: 700;
      white-space: nowrap;
    }

    .designation {
      line-height: 1.25;
    }

    .totals {
      width: min(100%, 330px);
      margin: 14px 0 0 auto;
      border: 1px solid var(--print-line);
      border-radius: 11px;
      overflow: hidden;
    }

    .total-row {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      padding: 8px 12px;
      border-bottom: 1px solid #edf1f6;
    }

    .total-row:last-child {
      border-bottom: 0;
    }

    .total-row.final {
      background: var(--print-primary);
      color: #fff;
      font-size: 15px;
      font-weight: 700;
    }

    .print-footer {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-top: 20px;
      padding-top: 10px;
      border-top: 1px solid var(--print-line);
      color: var(--print-muted);
      font-size: 10px;
    }

    @media print {
      @page {
        size: A4;
        margin: 8mm;
      }

      body {
        background: #fff;
      }

      .print-toolbar {
        display: none;
      }

      .print-page {
        width: 100%;
        margin: 0;
        padding: 0;
        border-radius: 0;
        box-shadow: none;
      }
    }

    @media (max-width: 720px) {
      .print-page {
        margin: 0;
        padding: 18px;
        border-radius: 0;
      }

      .order-head,
      .meta-grid {
        grid-template-columns: 1fr;
      }

      .order-title {
        text-align: left;
      }
    }
  </style>
</head>
<body>
  <div class="print-toolbar">
    <button class="print-btn" type="button" onclick="window.close()">Fermer</button>
    <button class="print-btn primary" type="button" onclick="window.print()">Imprimer</button>
  </div>

  <main class="print-page">
    <header class="order-head">
      <div>
        <div class="brand">
          <img class="brand-logo" src="{{ asset('img/logo-3sk-partsauto-transparent.png') }}" alt="3SK Parts Auto">
        </div>
        <div class="brand-subtitle">
          IMPORTATEUR ET DISTRIBUTEUR DE PIECES AUTOMOBILES CARROSSERIES ET ACCESSOIRES
        </div>
      </div>

      <div class="order-title">
        <h1>Bon de commande</h1>
        <div class="number">{{ order.orderNumber }}</div>
      </div>
    </header>

    <section class="meta-grid">
      <div class="box">
        <div class="box-title">Informations client</div>
        <div class="box-body">
          <div class="client-name">{{ order.companyName ?: 'Client non renseigne' }}</div>
          {% if order.customerCode %}
            <div class="muted">Code client : {{ order.customerCode }}</div>
          {% endif %}
          <div class="muted client-address">
            {{ order.address1 ?: 'Adresse non renseignee' }}
            {% if order.address2 %} - {{ order.address2 }}{% endif %}
            {% if order.city %} - {{ order.city }}{% endif %}
          </div>
        </div>
      </div>

      <div class="box">
        <div class="box-title">Commande</div>
        <div class="box-body">
          <div class="info-row">
            <span>Date</span>
            <strong>{{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '-' }}</strong>
          </div>
          <div class="info-row">
            <span>Statut</span>
            <strong>{{ order.statusLabel }}</strong>
          </div>
          <div class="info-row">
            <span>Articles</span>
            <strong>{{ order.lines|length }}</strong>
          </div>
        </div>
      </div>
    </section>

    <table>
      <thead>
        <tr>
          <th>Reference</th>
          <th>Article</th>
          <th class="text-end">Qte</th>
          <th class="text-end">Total TTC</th>
        </tr>
      </thead>
      <tbody>
        {% for line in order.lines %}
          <tr>
            <td><span class="ref">{{ line.articleCode }}</span></td>
            <td class="designation">{{ line.designation ?: '-' }}</td>
            <td class="text-end">{{ line.quantity }}</td>
            <td class="text-end">{{ line.lineTotalTtc }} DH</td>
          </tr>
        {% else %}
          <tr>
            <td colspan="4" class="muted">Aucun article dans cette commande.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <section class="totals">
      <div class="total-row">
        <span>Sous-total TTC</span>
        <strong>{{ order.subtotalTtc }} DH</strong>
      </div>
      {% if order.discountAmountTtc and order.discountAmountTtc != '0.00' and order.discountAmountTtc != '0' %}
        <div class="total-row">
          <span>Remise TTC</span>
          <strong>-{{ order.discountAmountTtc }} DH</strong>
        </div>
      {% endif %}
      <div class="total-row final">
        <span>Total TTC</span>
        <strong>{{ order.totalTtc }} DH</strong>
      </div>
    </section>

    <footer class="print-footer">
      <span>3SK Parts Auto</span>
      <span>Document genere le {{ 'now'|date('d/m/Y H:i') }}</span>
    </footer>
  </main>

  <script>
    window.addEventListener('load', function () {
      window.setTimeout(function () {
        window.print();
      }, 350);
    });
  </script>
</body>
</html>
