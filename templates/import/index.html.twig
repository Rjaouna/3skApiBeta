{% extends 'base.html.twig' %}

{% block body %}
<style>
  :root{
    --oc-radius: 22px;
    --oc-border: rgba(0,0,0,.10);
    --oc-shadow: 0 14px 34px rgba(0,0,0,.08);
    --oc-muted: rgba(0,0,0,.58);
    --oc-text: rgba(0,0,0,.84);
    --oc-glass: rgba(255,255,255,.82);
    --oc-glass-2: rgba(255,255,255,.60);
  }

  body.theme-dark{
    --oc-border: rgba(255,255,255,.14);
    --oc-shadow: 0 18px 46px rgba(0,0,0,.35);
    --oc-muted: rgba(255,255,255,.62);
    --oc-text: rgba(255,255,255,.88);
    --oc-glass: rgba(18,18,22,.76);
    --oc-glass-2: rgba(18,18,22,.58);
  }

  .import-page-hero{
    border-radius: 24px;
    border: 1px solid var(--oc-border);
    box-shadow: var(--oc-shadow);
    padding: 18px;
    background:
      radial-gradient(900px circle at 10% 10%, rgba(var(--bs-primary-rgb), .16), transparent 40%),
      radial-gradient(900px circle at 90% 30%, rgba(var(--bs-secondary-rgb), .14), transparent 38%),
      linear-gradient(180deg, rgba(0,0,0,.02), transparent);
  }

  .import-page-hero h3{
    margin: 0;
    font-weight: 650;
    color: var(--oc-text);
  }

  .import-page-hero .subtitle{
    margin-top: 6px;
    color: var(--oc-muted);
    font-size: .92rem;
    font-weight: 600;
  }

  .import-actions{
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .import-actions .btn{
    min-height: 46px;
    border-radius: 14px;
    font-weight: 600;
    padding-inline: 16px;
  }

  .import-card{
    border-radius: var(--oc-radius);
    border: 1px solid var(--oc-border);
    box-shadow: var(--oc-shadow);
    background: var(--oc-glass);
    backdrop-filter: blur(8px);
  }

  .import-card .card-body{
    padding: 18px;
  }

  .import-section-title{
    font-size: .82rem;
    font-weight: 600;
    color: var(--oc-muted);
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: .03em;
  }

  .import-file-box{
    border-radius: 18px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.48);
    padding: 14px;
  }

  body.theme-dark .import-file-box{
    background: rgba(255,255,255,.04);
  }

  .import-file-label{
    font-size: .74rem;
    color: var(--oc-muted);
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 6px;
    letter-spacing: .03em;
  }

  .import-file-value{
    color: var(--oc-text);
    font-weight: 550;
    line-height: 1.45;
    word-break: break-word;
  }

  .status-pill{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: .78rem;
    font-weight: 600;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .status-ready{
    background: rgba(108,117,125,.14);
    color: rgba(73,80,87,1);
    border-color: rgba(108,117,125,.20);
  }

  .status-running{
    background: rgba(13,110,253,.12);
    color: rgba(13,110,253,1);
    border-color: rgba(13,110,253,.18);
  }

  .status-done{
    background: rgba(25,135,84,.12);
    color: rgba(25,135,84,1);
    border-color: rgba(25,135,84,.20);
  }

  .status-error{
    background: rgba(220,53,69,.12);
    color: rgba(220,53,69,.98);
    border-color: rgba(220,53,69,.20);
  }

  .import-warning{
    border-radius: 18px;
    border: 1px solid rgba(255,193,7,.28);
    background: rgba(255,193,7,.10);
    color: var(--oc-text);
    font-weight: 700;
    padding: 14px 16px;
  }

  .import-progress-wrap{
    border-radius: 18px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.42);
    padding: 14px;
  }

  body.theme-dark .import-progress-wrap{
    background: rgba(255,255,255,.03);
  }

  .import-progress{
    height: 28px;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(0,0,0,.06);
  }

  body.theme-dark .import-progress{
    background: rgba(255,255,255,.08);
  }

  .import-progress .progress-bar{
    font-weight: 600;
    font-size: .82rem;
  }

  .import-stats-grid{
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 12px;
    margin-top: 18px;
  }

  .import-stat-card{
    border-radius: 18px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.48);
    padding: 14px;
  }

  body.theme-dark .import-stat-card{
    background: rgba(255,255,255,.04);
  }

  .import-stat-label{
    font-size: .74rem;
    color: var(--oc-muted);
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 6px;
    letter-spacing: .03em;
  }

  .import-stat-value{
    color: var(--oc-text);
    font-weight: 650;
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .import-message-box,
  .import-log-box{
    border-radius: 18px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.48);
    padding: 14px;
  }

  body.theme-dark .import-message-box,
  body.theme-dark .import-log-box{
    background: rgba(255,255,255,.04);
  }

  .import-message-text{
    color: var(--oc-text);
    font-weight: 550;
    line-height: 1.45;
    word-break: break-word;
  }

  .import-message-box.is-success{
    border-color: rgba(var(--bs-success-rgb), .28);
    background: rgba(var(--bs-success-rgb), .08);
  }

  .import-message-box.is-warning{
    border-color: rgba(var(--bs-warning-rgb), .32);
    background: rgba(var(--bs-warning-rgb), .10);
  }

  .import-message-box.is-error{
    border-color: rgba(var(--bs-danger-rgb), .30);
    background: rgba(var(--bs-danger-rgb), .08);
  }

  .import-log{
    height: 160px;
    overflow: auto;
    font-size: .85rem;
    color: var(--oc-text);
    line-height: 1.45;
    word-break: break-word;
  }

  .import-log > div + div{
    margin-top: 6px;
  }

  .import-created-panel{
    display: none;
    border-radius: 18px;
    border: 1px solid rgba(var(--bs-success-rgb), .22);
    background: rgba(var(--bs-success-rgb), .06);
    padding: 14px;
  }

  .import-created-panel.is-visible{
    display: block;
  }

  .import-created-header{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .import-created-title{
    color: var(--oc-text);
    font-weight: 650;
    margin: 0;
  }

  .import-created-count{
    border-radius: 999px;
    background: rgba(var(--bs-success-rgb), .14);
    color: rgb(var(--bs-success-rgb));
    padding: 6px 10px;
    font-size: .78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .import-created-list{
    display: grid;
    gap: 8px;
    max-height: 340px;
    overflow: auto;
    padding-right: 4px;
  }

  .import-created-item{
    display: grid;
    grid-template-columns: minmax(120px, .7fr) minmax(0, 1.5fr) auto;
    gap: 10px;
    align-items: center;
    border-radius: 14px;
    border: 1px solid var(--oc-border);
    background: rgba(255,255,255,.58);
    padding: 10px 12px;
  }

  body.theme-dark .import-created-item{
    background: rgba(255,255,255,.05);
  }

  .import-created-code{
    color: rgb(var(--bs-primary-rgb));
    font-weight: 700;
    word-break: break-word;
  }

  .import-created-name{
    color: var(--oc-text);
    font-weight: 550;
    line-height: 1.35;
  }

  .import-created-meta{
    color: var(--oc-muted);
    font-size: .78rem;
    margin-top: 3px;
  }

  .import-created-stock{
    border-radius: 999px;
    background: rgba(var(--bs-primary-rgb), .10);
    color: rgb(var(--bs-primary-rgb));
    padding: 5px 9px;
    font-size: .78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 991.98px){
    .import-stats-grid{
      grid-template-columns: repeat(2, minmax(0,1fr));
    }
  }

  @media (max-width: 767.98px){
    .import-actions{
      width: 100%;
    }

    .import-actions .btn,
    .import-actions a{
      width: 100%;
    }

    .import-stats-grid{
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="container py-4">
  <div class="import-page-hero mb-3 d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
      <h3>Import Articles</h3>
      <div class="subtitle">Insert / Update / Skip + progression fiable</div>
    </div>

    <div class="import-actions">
      <a class="btn btn-outline-secondary" href="{{ path('import_source_index') }}">
        <i class="fa-solid fa-gear me-2"></i>Configurer le fichier
      </a>
      <button class="btn btn-success" id="btnStart" {% if not source %}disabled{% endif %}>
        <i class="fa-solid fa-play me-2"></i>Démarrer
      </button>
      <button class="btn btn-outline-danger" id="btnStop" disabled>
        <i class="fa-solid fa-stop me-2"></i>Stop
      </button>
    </div>
  </div>

  {% if not source %}
    <div class="import-warning mb-3">
      <i class="fa-solid fa-triangle-exclamation me-2"></i>
      Aucune configuration trouvée. Clique sur “Configurer le fichier”.
    </div>
  {% else %}
    <div class="import-card mb-3">
      <div class="card-body">
        <div class="row g-3 align-items-center">
          <div class="col-md-8">
            <div class="import-file-box">
              <div class="import-file-label">Fichier source</div>
              <div class="import-file-value">{{ source.fullPath }}</div>
            </div>
          </div>

          <div class="col-md-4">
            <div class="import-file-box h-100">
              <div class="import-file-label">Statut</div>
              <div>
                <span id="statusBadge" class="status-pill status-ready">
                  <i class="fa-solid fa-clock"></i>READY
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <div class="import-card">
    <div class="card-body">
      <div class="import-section-title">Progression</div>

      <div class="import-progress-wrap">
        <div class="progress import-progress">
          <div id="bar" class="progress-bar" style="width:0%;">0%</div>
        </div>
      </div>

      <div class="import-stats-grid">
        <div class="import-stat-card">
          <div class="import-stat-label">Lues</div>
          <div class="import-stat-value"><span id="read">0</span> / <span id="total">0</span></div>
        </div>

        <div class="import-stat-card">
          <div class="import-stat-label">Insérées</div>
          <div class="import-stat-value" id="ins">0</div>
        </div>

        <div class="import-stat-card">
          <div class="import-stat-label">Mises à jour</div>
          <div class="import-stat-value" id="upd">0</div>
        </div>

        <div class="import-stat-card">
          <div class="import-stat-label">Ignorées</div>
          <div class="import-stat-value" id="skp">0</div>
        </div>

        <div class="import-stat-card">
          <div class="import-stat-label">Articles CSV</div>
          <div class="import-stat-value" id="csvArticles">0</div>
        </div>

        <div class="import-stat-card">
          <div class="import-stat-label">Articles base</div>
          <div class="import-stat-value" id="dbArticles">—</div>
        </div>
      </div>

      <div class="mt-3">
        <div class="import-section-title mb-2">Message</div>
        <div class="import-message-box">
          <div id="msg" class="import-message-text">—</div>
        </div>
      </div>

      <div class="mt-3">
        <div class="import-section-title mb-2">Log</div>
        <div class="import-log-box">
          <div id="log" class="import-log"></div>
        </div>
      </div>

      <div class="mt-3">
        <div id="createdArticlesPanel" class="import-created-panel" aria-live="polite">
          <div class="import-created-header">
            <p class="import-created-title">Nouveaux articles crees</p>
            <span id="createdArticlesCount" class="import-created-count">0</span>
          </div>
          <div id="createdArticlesList" class="import-created-list"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const csrf = "{{ csrf }}";
  const hasSource = {{ source ? 'true' : 'false' }};
  const startUrl = "{{ path('import_start') }}";
  const stepUrlPattern = "{{ path('import_step', {id: 999999}) }}";
  const stopUrlPattern = "{{ path('import_stop', {id: 999999}) }}";
  const minChunkLimit = 50;
  const maxChunkLimit = 300;
  const requestTimeoutMs = 25000;
  const maxRetries = 3;

  let robustJobId = null;
  let robustStopped = false;
  let robustRetryCount = 0;
  let robustLimit = 120;

  const byId = (id) => document.getElementById(id);
  const route = (pattern, id) => pattern.replace('999999', encodeURIComponent(String(id)));

  function setRunning(isRunning){
    const startBtn = byId('btnStart');
    const stopBtn = byId('btnStop');

    if (startBtn) {
      startBtn.disabled = isRunning || !hasSource;
    }
    if (stopBtn) {
      stopBtn.disabled = !isRunning || !robustJobId;
    }
  }

  function setBadge(status){
    const badge = byId('statusBadge');
    if (!badge) return;

    let icon = 'fa-clock';
    let cls = 'status-ready';

    if (status === 'RUNNING') {
      icon = 'fa-rotate';
      cls = 'status-running';
    } else if (status === 'DONE') {
      icon = 'fa-circle-check';
      cls = 'status-done';
    } else if (status === 'ERROR') {
      icon = 'fa-triangle-exclamation';
      cls = 'status-error';
    }

    badge.className = 'status-pill ' + cls;
    badge.innerHTML = '<i class="fa-solid ' + icon + '"></i>' + status;
  }

  function setMessage(text, type){
    const message = byId('msg');
    if (!message) return;

    const box = message.closest('.import-message-box');
    message.textContent = text || '-';

    if (box) {
      box.classList.remove('is-success', 'is-warning', 'is-error');
      if (['success', 'warning', 'error'].includes(type)) {
        box.classList.add('is-' + type);
      }
    }
  }

  function setProgress(processed, total){
    const bar = byId('bar');
    if (!bar) return;

    let percent = total > 0 ? Math.floor((processed / total) * 100) : 0;
    percent = Math.max(0, Math.min(100, percent));
    bar.style.width = percent + '%';
    bar.textContent = percent + '%';
    bar.classList.toggle('progress-bar-striped', percent < 100);
    bar.classList.toggle('progress-bar-animated', percent < 100);
  }

  function logLine(text){
    const log = byId('log');
    if (!log) return;

    const row = document.createElement('div');
    row.textContent = text;
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
  }

  function escapeHtml(value){
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderCreatedArticles(data){
    const panel = byId('createdArticlesPanel');
    const countNode = byId('createdArticlesCount');
    const list = byId('createdArticlesList');

    if (!panel || !countNode || !list) return;

    const createdArticles = Array.isArray(data.createdArticles) ? data.createdArticles : [];
    const insertedRows = Number(data.insertedRows || 0);

    countNode.textContent = insertedRows + ' article' + (insertedRows > 1 ? 's' : '');

    if (data.status !== 'DONE' || insertedRows <= 0) {
      panel.classList.remove('is-visible');
      list.innerHTML = '';
      return;
    }

    panel.classList.add('is-visible');
    if (createdArticles.length === 0) {
      list.innerHTML = '<div class="import-created-item"><div class="import-created-code">Info</div><div><div class="import-created-name">Liste detaillee indisponible pour ce job.</div><div class="import-created-meta">Le compteur reste fiable.</div></div><div class="import-created-stock">' + escapeHtml(insertedRows) + '</div></div>';
      return;
    }

    list.innerHTML = createdArticles.map((article) => {
      const meta = [article.family, article.brand, article.uniqueId].filter(Boolean).join(' - ');
      return `
        <div class="import-created-item">
          <div class="import-created-code">${escapeHtml(article.code || article.uniqueId || '-')}</div>
          <div>
            <div class="import-created-name">${escapeHtml(article.designation || 'Article sans designation')}</div>
            <div class="import-created-meta">${escapeHtml(meta || 'Nouvel article')}</div>
          </div>
          <div class="import-created-stock">Stock ${escapeHtml(article.stock ?? 0)}</div>
        </div>
      `;
    }).join('');
  }

  function render(data){
    data = data || {};

    const fields = {
      read: data.processedRows ?? 0,
      total: data.totalRows ?? 0,
      ins: data.insertedRows ?? 0,
      upd: data.updatedRows ?? 0,
      skp: data.skippedRows ?? 0
    };

    Object.entries(fields).forEach(([id, value]) => {
      const node = byId(id);
      if (node) node.textContent = value;
    });

    setMessage(data.message ?? '-', data.status === 'DONE' ? 'success' : (data.status === 'ERROR' ? 'error' : null));

    const csvArticles = byId('csvArticles');
    const dbArticles = byId('dbArticles');

    if (csvArticles && data.expectedArticleCount !== null && data.expectedArticleCount !== undefined) {
      csvArticles.textContent = data.expectedArticleCount;
    }

    if (dbArticles) {
      dbArticles.classList.remove('text-success', 'text-danger');
      if (data.databaseArticleCount === null || data.databaseArticleCount === undefined) {
        dbArticles.textContent = '-';
      } else {
        dbArticles.textContent = data.databaseArticleCount;
        dbArticles.classList.add(data.countsMatch === false ? 'text-danger' : 'text-success');
      }
    }

    setBadge(data.status ?? 'READY');
    setProgress(data.processedRows ?? 0, data.totalRows ?? 0);
    renderCreatedArticles(data);
  }

  async function fetchJson(url, options = {}){
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), requestTimeoutMs);

    try {
      const response = await fetch(url, Object.assign({}, options, {
        credentials: 'same-origin',
        signal: controller.signal,
        headers: Object.assign({
          Accept: 'application/json',
          'Content-Type': 'application/json'
        }, options.headers || {})
      }));

      const body = await response.text();
      let data = {};

      if (body.trim() !== '') {
        try {
          data = JSON.parse(body);
        } catch (error) {
          throw new Error('Reponse serveur invalide (' + response.status + ').');
        }
      }

      if (!response.ok || data.ok === false) {
        const error = new Error(data.message || 'Erreur serveur (' + response.status + ').');
        error.data = data;
        throw error;
      }

      return data;
    } catch (error) {
      if (error.name === 'AbortError') {
        throw new Error('Le serveur met trop de temps a repondre. Import mis en pause.');
      }
      throw error;
    } finally {
      window.clearTimeout(timeout);
    }
  }

  function adjustChunkLimit(elapsedMs){
    if (!elapsedMs) return;

    if (elapsedMs > 8000) {
      robustLimit = Math.max(minChunkLimit, Math.floor(robustLimit / 2));
      logLine('Chunk reduit a ' + robustLimit + ' lignes pour eviter les timeouts.');
    } else if (elapsedMs < 1800 && robustLimit < maxChunkLimit) {
      robustLimit = Math.min(maxChunkLimit, robustLimit + 25);
    }
  }

  function failImport(error){
    if (error && error.data) {
      render(error.data);
    } else {
      setBadge('ERROR');
      setMessage('Import interrompu: ' + (error?.message || 'erreur inconnue'), 'error');
    }

    logLine('ERROR: ' + (error?.message || 'erreur inconnue'));
    robustStopped = true;
    setRunning(false);
  }

  async function robustStart(){
    robustJobId = null;
    robustStopped = false;
    robustRetryCount = 0;
    robustLimit = 120;
    setBadge('RUNNING');
    setMessage('Preparation de l import...', null);
    setRunning(true);
    logLine('Start...');

    try {
      const data = await fetchJson(startUrl, {
        method: 'POST',
        body: JSON.stringify({_token: csrf})
      });

      robustJobId = data.jobId;
      render(data);
      setRunning(true);

      if (data.alreadyRunning) {
        logLine(data.message || ('Reprise du job #' + robustJobId));
      } else {
        logLine(data.message || ('Vous allez mettre a jour ' + (data.expectedArticleCount || data.totalRows || 0) + ' articles.'));
        logLine('Job #' + robustJobId + ' RUNNING');
      }

      if (data.done) {
        robustStopped = true;
        setRunning(false);
        logLine('DONE: ' + (data.message || ''));
        return;
      }

      window.setTimeout(robustStepLoop, 250);
    } catch (error) {
      failImport(error);
    }
  }

  async function robustStepLoop(){
    if (robustStopped || !robustJobId) return;

    try {
      const data = await fetchJson(route(stepUrlPattern, robustJobId), {
        method: 'POST',
        body: JSON.stringify({_token: csrf, limit: robustLimit})
      });

      robustRetryCount = 0;
      adjustChunkLimit(data.elapsedMs);
      render(data);

      if (data.done) {
        robustStopped = true;
        setRunning(false);
        logLine('DONE: ' + (data.message || ''));
        return;
      }

      window.setTimeout(robustStepLoop, 300);
    } catch (error) {
      if (robustStopped) return;

      robustRetryCount++;
      if (robustRetryCount <= maxRetries) {
        const delay = robustRetryCount * 1500;
        setMessage('Import momentanement ralenti. Nouvelle tentative ' + robustRetryCount + '/' + maxRetries + '...', 'warning');
        logLine('Retry ' + robustRetryCount + '/' + maxRetries + ': ' + (error?.message || 'erreur reseau'));
        window.setTimeout(robustStepLoop, delay);
        return;
      }

      failImport(error);
    }
  }

  async function robustStop(){
    robustStopped = true;
    const currentJobId = robustJobId;
    setRunning(false);

    if (!currentJobId) {
      logLine('STOP demande avant creation du job.');
      return;
    }

    logLine('STOP demande par l utilisateur');

    try {
      const data = await fetchJson(route(stopUrlPattern, currentJobId), {
        method: 'POST',
        body: JSON.stringify({_token: csrf})
      });
      render(data);
      logLine('STOP: ' + (data.message || 'Import arrete.'));
    } catch (error) {
      setBadge('ERROR');
      setMessage('Stop local effectue. Le serveur n a pas confirme l arret: ' + (error?.message || 'erreur inconnue'), 'warning');
      logLine('STOP warning: ' + (error?.message || 'erreur inconnue'));
    }
  }

  byId('btnStart')?.addEventListener('click', function(event){
    event.preventDefault();
    event.stopImmediatePropagation();
    robustStart();
  }, true);

  byId('btnStop')?.addEventListener('click', function(event){
    event.preventDefault();
    event.stopImmediatePropagation();
    robustStop();
  }, true);
})();
</script>
{% endblock %}
