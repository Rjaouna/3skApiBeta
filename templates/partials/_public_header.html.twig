{% set public_header_is_home = public_header_is_home|default(false) %}
{% set public_header_nav_id = public_header_nav_id|default('publicMainNav') %}
{% set public_header_anchor_prefix = public_header_is_home ? '' : path('home') %}

<style>
  .public-shell {
    --public-blue: #315fbb;
    --public-blue-dark: #102e63;
    --public-orange: #ff9100;
    --public-ink: #101828;
    --public-border: rgba(16,24,40,.10);
  }

  .public-shell .public-site-header {
    position: sticky;
    top: 0;
    z-index: 1030;
    filter: drop-shadow(0 12px 24px rgba(16,24,40,.08));
  }

  .public-shell .public-topbar {
    position: relative;
    overflow: hidden;
    background: #fff;
    border-bottom: 2px solid var(--public-blue);
    color: var(--public-ink);
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    min-height: 54px;
    text-transform: uppercase;
  }

  .public-shell .public-topbar .container,
  .public-shell .public-topbar .container-fluid {
    position: relative;
    z-index: 1;
  }

  .public-shell .public-topbar a {
    color: var(--public-blue);
    text-decoration: none;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .public-shell .public-topbar-contact i {
    margin-right: .5rem !important;
    font-size: 1.05rem;
  }

  .public-shell .public-topbar a:hover {
    color: var(--public-orange);
  }

  .public-shell .public-topbar-contact {
    min-height: 54px;
  }

  .public-shell .public-topbar-contact a + a::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 22px;
    margin: 0 22px 0 18px;
    background: rgba(49,95,187,.2);
    vertical-align: middle;
  }

  .public-shell .public-topbar-actions {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .9rem;
    min-height: 54px;
    color: var(--public-orange);
  }

  .public-shell .public-topbar-actions::before,
  .public-shell .public-topbar-actions::after {
    display: none;
  }

  .public-shell .public-topbar-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    min-height: 42px;
    padding: .75rem 1.15rem;
    border: 1px solid rgba(16,24,40,.05);
    border-radius: 999px;
    color: var(--public-orange);
    background: #fff;
    box-shadow: 0 8px 22px rgba(16,24,40,.12);
    transition: color .18s ease, background .18s ease, transform .18s ease, box-shadow .18s ease;
  }

  .public-shell .public-topbar-actions a:hover {
    color: #fff;
    background: var(--public-orange);
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(255,145,0,.22);
  }

  .public-shell .public-topbar-separator {
    width: 1px;
    height: 26px;
    background: rgba(16,24,40,.14);
  }

  .public-shell .public-navbar {
    min-height: 146px;
    border: 0;
    border-radius: 0 0 32px 32px;
    background: #fff;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 14px 32px rgba(16,24,40,.08);
    overflow: hidden;
  }

  .public-shell .public-navbar .navbar-brand {
    display: inline-flex;
    align-items: center;
    min-height: 124px;
    padding: 0;
    margin-left: 2rem;
    margin-right: 2.5rem;
  }

  .public-shell .public-navbar .navbar-brand::before,
  .public-shell .public-navbar .navbar-brand::after {
    display: none;
  }

  .public-shell .public-navbar .navbar-brand img {
    height: 118px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .public-shell .public-navbar .nav-link {
    color: var(--public-blue);
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 550;
    letter-spacing: 0;
    text-transform: uppercase;
    position: relative;
    padding: 2.55rem 0 !important;
    margin: 0 1.25rem;
  }

  .public-shell .public-navbar .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.95rem;
    height: 3px;
    border-radius: 0;
    background: var(--public-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .16s ease;
  }

  .public-shell .public-navbar .nav-link:hover,
  .public-shell .public-navbar .nav-link:focus {
    color: var(--public-orange);
  }

  .public-shell .public-navbar .nav-link.active {
    color: var(--public-blue);
  }

  .public-shell .public-navbar .nav-link:hover::after,
  .public-shell .public-navbar .nav-link:focus::after,
  .public-shell .public-navbar .nav-link.active::after {
    transform: scaleX(1);
  }

  .public-shell .public-navbar .navbar-toggler {
    border-color: rgba(49,95,187,.22);
    border-radius: 0;
    background: rgba(49,95,187,.06);
  }

  .public-shell .public-navbar .navbar-toggler-icon {
    filter: none;
  }

  .public-shell .public-menu-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 58px;
    border-radius: 10px !important;
    background: var(--public-orange) !important;
    border-color: var(--public-orange) !important;
    color: #fff !important;
    box-shadow: 0 10px 24px rgba(255,145,0,.18) !important;
    font-family: 'Montserrat', sans-serif;
    font-size: 15px;
    line-height: 1;
    text-transform: uppercase;
    padding: 1.1rem 1.8rem !important;
  }

  .public-shell .public-menu-cta-item {
    display: flex;
    align-items: center;
  }

  .public-shell .public-menu-cta-item::before {
    content: "";
    width: 1px;
    height: 34px;
    margin: 0 1.6rem 0 .8rem;
    background: rgba(16,24,40,.18);
  }

  .public-shell .public-menu-cta:hover {
    background: var(--public-blue) !important;
    border-color: var(--public-blue) !important;
    color: #fff !important;
  }

  @media (min-width: 992px) and (max-width: 1299px) {
    .public-shell .public-navbar .navbar-brand {
      min-height: 92px;
      margin-left: .75rem;
      margin-right: 1.25rem;
    }

    .public-shell .public-navbar .navbar-brand img {
      height: 84px;
    }

    .public-shell .public-navbar .nav-link {
      font-size: 11.5px;
      margin: 0 .58rem;
    }

    .public-shell .public-menu-cta {
      min-height: 48px;
      font-size: 11.5px;
      padding: .85rem 1rem !important;
    }

    .public-shell .public-menu-cta-item::before {
      margin-inline: .65rem 1rem;
    }
  }

  @media (max-width: 991px) {
    .public-shell .public-navbar {
      min-height: 84px;
      border-radius: 0 0 20px 20px;
    }

    .public-shell .public-navbar .navbar-brand {
      min-height: 68px;
      margin-left: .5rem;
      margin-right: 1rem;
    }

    .public-shell .public-navbar .navbar-brand img {
      height: 66px;
    }

    .public-shell .public-navbar .nav-link {
      margin: 0;
      padding: .85rem 0 !important;
      border-bottom: 1px solid rgba(49,95,187,.12);
    }

    .public-shell .public-navbar .nav-link::after {
      display: none;
    }

    .public-shell .public-navbar .navbar-collapse {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .public-shell .public-menu-cta {
      width: 100%;
      padding-block: .9rem !important;
    }

    .public-shell .public-menu-cta-item::before {
      display: none;
    }
  }

  @media (max-width: 575px) {
    .public-shell .public-topbar {
      font-size: 11px;
    }

    .public-shell .public-topbar-contact a + a::before,
    .public-shell .public-topbar-actions::before,
    .public-shell .public-topbar-actions::after {
      display: none;
    }

    .public-shell .public-topbar-actions {
      width: 100%;
      min-height: 0;
      flex-wrap: wrap;
      justify-content: center;
      margin-block: 0;
      padding: .7rem 1rem;
      border-radius: 0;
    }

    .public-shell .public-topbar-actions a {
      min-height: 38px;
      padding: .65rem .9rem;
    }

    .public-shell .public-navbar .navbar-brand {
      min-height: 62px;
      margin-left: .25rem;
      margin-right: 1rem;
      padding: 0;
    }

    .public-shell .public-navbar .navbar-brand img {
      height: 58px;
    }
  }
</style>

<header class="public-site-header">
  <div class="public-topbar py-2">
    <div class="container-fluid px-4 px-xl-5 d-flex flex-column flex-lg-row justify-content-between align-items-center gap-2">
      <div class="public-topbar-contact d-flex flex-column flex-md-row align-items-center justify-content-center justify-content-lg-start text-center text-lg-start">
        <a href="tel:+212522713572"><i class="fa-solid fa-phone me-1"></i>Tel: +212 5 22 71 35 72</a>
        <a href="mailto:3sk.partsauto@gmail.com"><i class="fa-solid fa-envelope me-1"></i>3sk.partsauto@gmail.com</a>
      </div>
      <div class="d-flex align-items-center justify-content-center">
        <div class="public-topbar-actions">
          <a href="{{ path('app_login') }}" class="fw-semibold"><i class="fa-solid fa-unlock-keyhole"></i>Se connecter</a>
          <span class="public-topbar-separator" aria-hidden="true"></span>
          <a href="{{ public_header_anchor_prefix }}#contact"><i class="fa-solid fa-user-plus"></i>Devenir client</a>
        </div>
      </div>
    </div>
  </div>

  <nav class="navbar navbar-expand-lg public-navbar">
    <div class="container-fluid px-4 px-xl-5 py-2">
      <a class="navbar-brand" href="{{ public_header_anchor_prefix }}#accueil">
        <img src="{{ asset('img/logo-3sk-partsauto-transparent.png') }}" alt="3SK Parts Auto">
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#{{ public_header_nav_id }}" aria-controls="{{ public_header_nav_id }}" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="{{ public_header_nav_id }}">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item"><a class="nav-link fw-semibold {{ public_header_is_home ? 'active' : '' }}" href="{{ public_header_anchor_prefix }}#accueil" {{ public_header_is_home ? 'aria-current="page"' : '' }}>Accueil</a></li>
          <li class="nav-item"><a class="nav-link fw-semibold" href="{{ public_header_anchor_prefix }}#qui-sommes-nous">Qui sommes-nous</a></li>
          <li class="nav-item"><a class="nav-link fw-semibold" href="{{ public_header_anchor_prefix }}#services">Services</a></li>
          <li class="nav-item"><a class="nav-link fw-semibold" href="{{ public_header_anchor_prefix }}#marques">Marques</a></li>
          <li class="nav-item"><a class="nav-link fw-semibold" href="{{ public_header_anchor_prefix }}#contact">Contact</a></li>
          <li class="nav-item public-menu-cta-item mt-2 mt-lg-0">
            <a href="{{ path('app_login') }}" class="btn btn-primary public-menu-cta px-4 fw-bold"><i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Espace client</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
