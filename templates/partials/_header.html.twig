{# templates/partials/_header.html.twig #}
<style>
  :root{
    --hd-radius: 18px;
    --hd-border: rgba(0,0,0,.08);
    --hd-shadow: 0 14px 34px rgba(0,0,0,.08);
    --hd-glass: rgba(255,255,255,1);
    --hd-glass2: rgba(255,255,255,.62);
    --hd-text: rgba(0,0,0,.78);
    --hd-muted: rgba(0,0,0,.56);
  }

  body.theme-dark{
    --hd-border: rgba(255,255,255,.14);
    --hd-shadow: 0 16px 44px rgba(0,0,0,.35);
    --hd-glass: rgba(18,18,22,.72);
    --hd-glass2: rgba(18,18,22,.55);
    --hd-text: rgba(255,255,255,.86);
    --hd-muted: rgba(255,255,255,.62);
    background: #0f1115;
    color: rgba(255,255,255,.86);
  }

  .site__header{
    position: sticky;
    top: 0;
    z-index: 1025;
  }

  .header-wrap{
    border-bottom: 1px solid var(--hd-border);
    background: var(--hd-glass);
  }

  .header-topbar{
    position: relative;
    overflow: visible !important;
    border-bottom: 1px solid var(--hd-border);
    background:
      radial-gradient(800px circle at 10% 20%, rgba(var(--bs-primary-rgb), .16), transparent 40%),
      radial-gradient(900px circle at 90% 40%, rgba(var(--bs-secondary-rgb), .14), transparent 38%),
      linear-gradient(180deg, rgba(0,0,0,.02), transparent);
    z-index: 1030;
  }

  body.theme-dark .header-topbar{
    background:
      radial-gradient(800px circle at 10% 20%, rgba(13,110,253,.18), transparent 40%),
      radial-gradient(900px circle at 90% 40%, rgba(25,135,84,.18), transparent 38%),
      linear-gradient(180deg, rgba(255,255,255,.03), transparent);
  }

  .header-topbar .dropdown-menu{
    z-index: 2000;
  }

  .topbar-row{
    display:flex;
    align-items:center;
    gap:12px;
    padding: 10px 0;
    color: var(--hd-text);
  }

  .topbar-welcome{
    font-weight: 700;
    color: var(--hd-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 520px;
  }

  .topbar-welcome .account-name{
    font-weight: 600;
    color: var(--hd-text);
  }

  .topbar-phone{
    margin-left: 8px;
    text-decoration:none;
    display:flex;
    align-items:center;
    gap:10px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--hd-glass2);
    color: var(--hd-text);
    font-weight: 550;
  }

  .topbar-phone:hover{
    filter: brightness(.98);
  }

  .topbar-spacer{
    flex:1;
  }

  .hd-iconbtn{
    width: 38px;
    height: 38px;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,.08);
    background: rgba(255,255,255,.72);
    display:grid;
    place-items:center;
    color: rgba(0,0,0,.72);
    text-decoration:none;
    transition: transform .08s ease, filter .12s ease;
  }

  body.theme-dark .hd-iconbtn{
    border-color: rgba(255,255,255,.10);
    background: rgba(255,255,255,.08);
    color: rgba(255,255,255,.82);
  }

  .hd-iconbtn:hover{
    transform: translateY(-1px);
    filter: brightness(.98);
  }

  .hd-badge{
    position:absolute;
    top:-5px;
    right:-5px;
    border-radius:999px;
    padding: 2px 5px;
    font-size:.64rem;
    border: 1px solid rgba(0,0,0,.08);
    box-shadow: none;
  }

  body.theme-dark .hd-badge{
    border-color: rgba(255,255,255,.12);
  }

  .hd-dropdown .dropdown-menu{
    border-radius: 14px;
    box-shadow: 0 10px 24px rgba(0,0,0,.08);
    border: 1px solid rgba(0,0,0,.08);
    overflow: hidden;
    min-width: 260px;
    max-width: 280px;
    background: rgba(255,255,255,.96);
    color: rgba(0,0,0,.78);
    padding: 0;
  }

  body.theme-dark .hd-dropdown .dropdown-menu{
    background: rgba(28,28,34,.96);
    border-color: rgba(255,255,255,.10);
    box-shadow: 0 12px 28px rgba(0,0,0,.28);
    color: rgba(255,255,255,.86);
  }

  .notif-head{
    padding: 10px 12px;
    border-bottom: 1px solid rgba(0,0,0,.06);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 8px;
  }

  body.theme-dark .notif-head{
    border-bottom-color: rgba(255,255,255,.08);
  }

  .notif-head h6{
    margin:0;
    font-weight: 550;
    font-size:.92rem;
    color: rgba(0,0,0,.78);
  }

  body.theme-dark .notif-head h6{
    color: rgba(255,255,255,.86);
  }

  .notif-head button{
    border:none;
    background: transparent;
    font-weight:700;
    font-size:.78rem;
    color: rgba(13,110,253,.92);
    padding: 0;
  }

  body.theme-dark .notif-head button{
    color: rgba(127,176,255,.95);
  }

  .notif-item{
    display:flex;
    gap:8px;
    padding: 10px 12px;
    text-decoration:none;
    color: rgba(0,0,0,.76);
    border-bottom: 1px solid rgba(0,0,0,.05);
    transition: background .12s ease;
  }

  body.theme-dark .notif-item{
    color: rgba(255,255,255,.84);
    border-bottom-color: rgba(255,255,255,.06);
  }

  .notif-item:hover{
    background: rgba(13,110,253,.05);
  }

  body.theme-dark .notif-item:hover{
    background: rgba(255,255,255,.04);
  }

  .notif-dot{
    width: 8px;
    height: 8px;
    border-radius: 999px;
    margin-top: 5px;
    background: rgba(220,53,69,.92);
    box-shadow: 0 0 0 3px rgba(220,53,69,.10);
    flex: 0 0 auto;
  }

  .notif-content p{
    margin:0;
    font-size:.82rem;
    line-height:1.25;
    color: inherit;
  }

  .notif-time{
    margin-top:4px;
    font-size:.72rem;
    color: rgba(0,0,0,.48);
    display:block;
  }

  body.theme-dark .notif-time{
    color: rgba(255,255,255,.52);
  }

  #notifDropdownList .p-3{
    padding: 10px 12px !important;
    font-size: .78rem;
  }

  .hd-dropdown .border-top{
    border-top: 1px solid rgba(0,0,0,.06) !important;
  }

  body.theme-dark .hd-dropdown .border-top{
    border-top-color: rgba(255,255,255,.08) !important;
  }

  .hd-dropdown .border-top .btn{
    font-size: .78rem;
    padding: .38rem .55rem;
    border-radius: 10px;
  }

  .settings-btn{
    border-radius: 999px !important;
    border: 1px solid var(--hd-border) !important;
    background: var(--hd-glass2) !important;
    color: var(--hd-text) !important;
    font-weight: 550 !important;
    padding: 8px 12px !important;
  }

  .header-main-row{
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-box{
    flex: 0 0 auto;
  }

  .brand-logo{
    height: 56px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex: 0 0 auto;
  }

  .brand-logo img{
    display:block;
    max-height: 50px;
    width: auto;
    object-fit: contain;
    padding: 0;
  }

  .brand-name{
    display:flex;
    flex-direction:column;
    line-height:1.05;
  }

  .brand-name strong{
    font-weight: 650;
    color: var(--hd-text);
  }

  .brand-name span{
    font-size:.82rem;
    color: var(--hd-muted);
    font-weight: 700;
  }

  .header-search{
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .header-search .form-select{
    max-width: 210px;
    border-top-left-radius: 999px;
    border-bottom-left-radius: 999px;
  }

  .header-search .form-control{
    border-radius: 0;
  }

  .header-search .btn{
    border-top-right-radius: 999px;
    border-bottom-right-radius: 999px;
    font-weight: 600;
  }

  .header-search form{
    width: 100%;
  }

  .header-search .search-wrap{
    width: 100%;
  }

  .d-none.d-lg-flex.align-items-center.gap-2{
    flex: 0 0 auto;
  }

  .header-nav{
    border-top: 1px solid var(--hd-border);
    background: rgba(0,0,0,.015);
  }

  body.theme-dark .header-nav{
    background: rgba(255,255,255,.03);
  }

  .nav-list{
    display:flex;
    gap:6px;
    flex-wrap:wrap;
    padding: 10px 0;
    margin: 0;
    list-style: none;
  }

  .nav-list a{
    display:flex;
    align-items:center;
    gap:10px;
    padding: 10px 14px;
    border-radius: 999px;
    text-decoration:none;
    border: 1px solid transparent;
    color: var(--hd-text);
    font-weight: 600;
    transition: background .12s ease, transform .08s ease, border-color .12s ease;
  }

  .nav-list a:hover{
    background: rgba(13,110,253,.08);
    border-color: rgba(13,110,253,.18);
    transform: translateY(-1px);
  }

  .nav-list .dropdown-menu{
    border-radius: 18px;
    border: 1px solid var(--hd-border);
    box-shadow: var(--hd-shadow);
    background: var(--hd-glass);
  }

  .indicator-btn{
    display:flex;
    align-items:center;
    gap:10px;
    padding: 8px 12px;
    border-radius: 16px;
    background: var(--hd-glass2);
    text-decoration:none;
    color: var(--hd-text);
    min-height: 46px;
  }

  .indicator-btn.indicator-cart{
    padding: 10px 16px;
    min-width: 245px;
    margin-bottom: 10px;
  }

  .indicator-btn.indicator-cart #cartTotalMini{
    font-weight: 650 !important;
    font-size: 1.2rem;
    color: var(--hd-text);
  }

  .indicator-btn.indicator-deals{
    padding: 10px 16px;
    min-width: 220px;
    margin-bottom: 10px;
  }

  .indicator-btn.indicator-deals .indicator-title{
    white-space: nowrap;
  }

  .indicator-title{
    font-size:1.2rem;
    font-weight: 600;
    line-height:1;
  }

  .indicator-value{
    font-size:.78rem;
    color: var(--hd-muted);
    font-weight: 550;
  }

  .indicator-icon{
    position: relative;
    width: 45px;
    height: 45px;
    border-radius: 14px;
    display:grid;
    place-items:center;
  }

  body.theme-dark .indicator-icon{
    background: rgba(13,110,253,.16);
  }

  .theme-toggle{
    border:none;
    background: var(--hd-glass2);
    border: 1px solid var(--hd-border);
    border-radius: 999px;
    padding: 7px 10px;
    display:flex;
    align-items:center;
    gap:8px;
    color: var(--hd-text);
    font-weight: 600;
  }

  .theme-toggle .dot{
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: rgba(255,193,7,.95);
    box-shadow: 0 0 0 4px rgba(255,193,7,.18);
  }

  body.theme-dark .theme-toggle .dot{
    background: rgba(13,110,253,.95);
    box-shadow: 0 0 0 4px rgba(13,110,253,.18);
  }

  .offcanvas{
    border-left: 1px solid var(--hd-border);
    background: var(--hd-glass);
    color: var(--hd-text);
  }

  .offcanvas .offcanvas-title{
    font-weight: 650;
  }

  .offcanvas a{
    color: var(--hd-text);
  }

  .theme-switch-wrap{
    display:flex;
    align-items:center;
  }

  .theme-switch{
    width: 58px !important;
    height: 30px !important;
    border-radius: 999px !important;
    cursor: pointer;
    border: 1px solid var(--hd-border) !important;
    position: relative;
    background: rgba(255,193,7,.30) !important;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.04);
    transition: background .22s ease, border-color .22s ease, box-shadow .22s ease;
  }

  body.theme-dark .theme-switch{
    background: rgba(233,236,239,.75) !important;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
  }

  .theme-switch:focus{
    box-shadow: 0 0 0 .2rem rgba(13,110,253,.20) !important;
  }

  .theme-switch::before{
    content:"";
    position:absolute;
    top: 50%;
    left: 3px;
    width: 24px;
    height: 24px;
    transform: translateY(-50%);
    border-radius: 999px;
    background: rgba(255,255,255,.98);
    border: 1px solid rgba(0,0,0,.10);
    box-shadow: 0 10px 20px rgba(0,0,0,.12);
    transition: left .26s ease, background .22s ease, border-color .22s ease;
    z-index: 1;
  }

  .theme-switch::after{
    content:"\f185";
    font-family: "Font Awesome 6 Free";
    font-weight: 600;
    position:absolute;
    top: 50%;
    left: 3px;
    width: 24px;
    height: 24px;
    transform: translateY(-50%);
    display:grid;
    place-items:center;
    color: rgba(255,140,0,.95);
    transition: left .26s ease, transform .26s ease, opacity .18s ease;
    z-index: 2;
  }

  .theme-switch:checked::before{
    left: calc(100% - 3px - 24px);
    background: rgba(255,255,255,.98);
  }

  .theme-switch:checked::after{
    left: calc(100% - 3px - 24px);
    content:"\f186";
    color: rgba(55,65,81,.95);
  }

  .theme-switch:active::before{
    width: 28px;
  }

  .theme-switch:active::after{
    transform: translateY(-50%) scale(1.05);
  }

  .theme-switch-label{
    margin:0;
    padding:0;
  }

  .cart-summary-card{
    border-radius: 22px;
    border: 1px solid var(--hd-border);
    background:
      radial-gradient(600px circle at 10% 10%, rgba(var(--bs-primary-rgb), .10), transparent 40%),
      radial-gradient(600px circle at 90% 20%, rgba(var(--bs-secondary-rgb), .08), transparent 35%),
      var(--hd-glass2);
    box-shadow: var(--hd-shadow);
    padding: 16px;
    backdrop-filter: blur(8px);
  }

  .cart-summary-head{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  .cart-summary-kicker{
    font-size: .74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--hd-muted);
  }

  .cart-summary-title{
    font-size: 1rem;
    font-weight: 650;
    color: var(--hd-text);
    line-height: 1.1;
  }

  .cart-summary-badge{
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(220,53,69,.12);
    color: rgba(220,53,69,.95);
    border: 1px solid rgba(220,53,69,.18);
    font-size: .78rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .cart-summary-badge.d-none{
    display: none !important;
  }

  .cart-discount-chip{
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(220,53,69,.10);
    color: rgba(220,53,69,.95);
    border: 1px solid rgba(220,53,69,.16);
    font-size: .72rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .cart-summary-grid{
    display:grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 12px;
  }

  .cart-summary-box{
    border-radius: 16px;
    border: 1px solid var(--hd-border);
    background: rgba(255,255,255,.55);
    padding: 12px;
  }

  body.theme-dark .cart-summary-box{
    background: rgba(18,18,22,.45);
  }

  .cart-summary-label{
    display:block;
    font-size: .78rem;
    font-weight: 550;
    color: var(--hd-muted);
    margin-bottom: 4px;
  }

  .cart-summary-value{
    display:block;
    font-size: 1rem;
    font-weight: 650;
    color: var(--hd-text);
  }

  .cart-summary-line{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 10px;
    padding: 10px 0 8px 0;
    border-top: 1px dashed var(--hd-border);
    color: var(--hd-text);
    font-size: .92rem;
  }

  .cart-summary-total{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 10px;
    margin-top: 4px;
    padding: 12px 14px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(13,110,253,.12), rgba(13,110,253,.04));
    border: 1px solid rgba(13,110,253,.18);
  }

  .cart-summary-total span{
    font-size: .90rem;
    font-weight: 600;
    color: var(--hd-text);
  }

  .cart-summary-total strong{
    font-size: 1.25rem;
    font-weight: 650;
    color: var(--hd-text);
  }

  .cart-summary-foot{
    margin-top: 10px;
    font-size: .78rem;
    font-weight: 550;
    color: var(--hd-muted);
    text-align: center;
  }

  .cart-item{
    display:flex;
    gap: 12px;
    align-items:center;
    padding: 10px;
    border-radius: 16px;
    border: 1px solid var(--hd-border);
    background: var(--hd-glass2);
  }

  .cart-thumb{
    width: 56px;
    height: 56px;
    border-radius: 14px;
    border: 1px solid var(--hd-border);
    background: rgba(0,0,0,.03);
    object-fit: contain;
    padding: 6px;
    flex: 0 0 auto;
  }

  body.theme-dark .cart-thumb{
    background: rgba(255,255,255,.05);
  }

  .cart-info{
    min-width: 0;
    flex: 1;
  }

  .cart-title{
    font-weight: 650;
    font-size: .92rem;
    line-height: 1.12;
    color: var(--hd-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-ref{
    margin-top: 4px;
    font-size: .80rem;
    font-weight: 600;
    color: var(--hd-muted);
  }

  .cart-right{
    display:flex;
    flex-direction: column;
    align-items:flex-end;
    gap: 6px;
    flex: 0 0 auto;
  }

  .cart-qty{
    border-radius: 999px;
    padding: 6px 10px;
    font-size: .78rem;
    font-weight: 650;
    border: 1px solid var(--hd-border);
    background: rgba(255,255,255,.70);
    color: var(--hd-text);
    white-space: nowrap;
  }

  body.theme-dark .cart-qty{
    background: rgba(18,18,22,.55);
  }

  .cart-subtotal{
    font-size: .82rem;
    font-weight: 650;
    color: var(--hd-text);
    white-space: nowrap;
  }

  .cart-remove-btn{
    width: 32px;
    height: 32px;
    border-radius: 10px;
    border: 1px solid rgba(220,53,69,.18);
    background: rgba(220,53,69,.08);
    color: rgba(220,53,69,.95);
    display: inline-grid;
    place-items: center;
    padding: 0;
    transition: transform .08s ease, background .12s ease, filter .12s ease;
  }

  .cart-remove-btn:hover{
    background: rgba(220,53,69,.14);
    transform: translateY(-1px);
  }

  body.theme-dark .cart-remove-btn{
    border-color: rgba(220,53,69,.24);
    background: rgba(220,53,69,.12);
    color: rgba(255,120,120,.95);
  }

  .header-search .search-wrap{
    position: relative;
    width: 100%;
  }

  .header-search .search-suggestions{
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 8px);
    z-index: 2300;
    display: none;
    max-height: min(420px, 72vh);
    overflow: auto;
    padding: 8px;
    border: 1px solid var(--hd-border);
    border-radius: 18px;
    background: rgba(255,255,255,.98);
    box-shadow: 0 18px 46px rgba(16, 24, 40, .16);
  }

  .header-search .search-suggestions.is-open{
    display: block;
  }

  body.theme-dark .header-search .search-suggestions{
    background: rgba(18,18,22,.98);
    border-color: rgba(255,255,255,.12);
    box-shadow: 0 20px 54px rgba(0,0,0,.40);
  }

  .search-suggestions__head{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 8px 8px;
    color: var(--hd-muted);
    font-size: .76rem;
  }

  .search-suggestions__head strong{
    color: var(--hd-text);
    font-weight: 650;
  }

  .search-suggestion-item{
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    width: 100%;
    padding: 10px 11px;
    border-radius: 14px;
    color: var(--hd-text);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background .14s ease, border-color .14s ease, transform .12s ease;
  }

  .search-suggestion-item:hover,
  .search-suggestion-item.is-active{
    background: rgba(var(--bs-primary-rgb), .08);
    border-color: rgba(var(--bs-primary-rgb), .16);
    color: var(--hd-text);
    transform: translateY(-1px);
  }

  body.theme-dark .search-suggestion-item:hover,
  body.theme-dark .search-suggestion-item.is-active{
    background: rgba(255,255,255,.06);
    border-color: rgba(255,255,255,.12);
  }

  .search-suggestion-item__title{
    display: block;
    overflow: hidden;
    color: var(--hd-text);
    font-size: .9rem;
    font-weight: 650;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-suggestion-item__meta{
    display: block;
    margin-top: 3px;
    overflow: hidden;
    color: var(--hd-muted);
    font-size: .76rem;
    line-height: 1.25;
