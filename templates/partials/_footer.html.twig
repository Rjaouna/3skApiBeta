{# templates/partials/_footer.html.twig #}

<style>
  :root{
    --ft-border: rgba(255,255,255,.2);
    --ft-text: #ffffff;
    --ft-muted: rgba(255,255,255,.75);
    --ft-bg: var(--bs-primary);
    --ft-bg2: rgba(255,255,255,.1);
    --ft-link: rgba(255,255,255,.85);
  }

  .site-footer{
    margin-top: 34px;
    border-top: 1px solid var(--ft-border);
    background: var(--bs-primary);
    color: var(--ft-text);
  }

  .ft-top{
    padding: 26px 0 18px;
  }

  .ft-brand{
    display:flex;
    align-items:center;
    gap: 12px;
    text-decoration:none;
    color: inherit;
  }

  .ft-logo{
    height: 44px;
    width: 150px;
    object-fit: contain;
  }

  .ft-desc{
    margin: 6px 0 0;
    color: var(--ft-muted);
    font-weight: 300;
    max-width: 52ch;
  }

  .ft-title{
    font-weight: 950;
    letter-spacing: .02em;
    margin-bottom: 10px;
    color: #ff9100;
    font-size: 1.5rem;
  }

  .ft-list{
    list-style:none;
    padding:0;
    margin:0;
    display:grid;
    gap: 8px;
  }

  .ft-link{
    display:inline-flex;
    align-items:center;
    gap: 10px;
    padding: 6px 0;
    color: var(--ft-link);
    text-decoration:none;
    font-weight: 300;
    transition: color .12s ease, transform .12s ease, opacity .12s ease;
  }

  .ft-link:hover{
    color: #ffffff;
    transform: translateX(2px);
  }

  .ft-link i{
    opacity:.85;
    width: 18px;
    text-align:center;
  }

  .ft-meta{
    color: var(--ft-muted);
    font-weight: 300;
    line-height: 1.35;
  }

  .ft-pillbar{
    display:flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }

  .ft-pill{
    display:inline-flex;
    align-items:center;
    gap: 8px;
    padding: 9px 12px;
    border-radius: 999px;
    border: 1px solid var(--ft-border);
    background: rgba(255,255,255,.1);
    color: #ffffff;
    text-decoration:none;
    font-weight: 700;
    backdrop-filter: blur(6px);
  }

  .ft-divider{
    height: 1px;
    background: var(--ft-border);
  }

  .ft-bottom{
    padding: 14px 0 18px;
    color: var(--ft-muted);
    font-weight: 300;
    font-size: .92rem;
  }

  .ft-social a{
    width: 40px; 
    height: 40px;
    border-radius: 14px;
    border: 1px solid var(--ft-border);
    display:grid;
    place-items:center;
    text-decoration:none;
    color: #ffffff;
    background: rgba(255,255,255,.1);
    transition: transform .10s ease, border-color .12s ease, background .12s ease;
  }

  .ft-social a:hover{
    transform: translateY(-1px);
    border-color: rgba(255,255,255,.35);
    background: rgba(255,255,255,.2);
  }

  @media (max-width: 575.98px){
    .ft-top{ padding-top: 22px; }
    .ft-logo{ width: 130px; }
  }
</style>

<footer class="site-footer">
  <div class="container">

    <div class="ft-top">
      <div class="row g-4 align-items-start">

        <div class="col-12 col-lg-5">
          <a class="ft-brand" href="{{ path('home') }}">
            <div class="d-none d-sm-block">
              <div class="fw-bold" style="font-weight:950;">3sk parts auto</div>
              <div class="small" style="color:var(--ft-muted); font-weight:800;">
                Pièces & accessoires • Casablanca
              </div>
            </div>
          </a>

          <p class="ft-desc">
            Catalogue clair, disponibilité rapide et commande simple.
            Besoin d’une référence ? On vous répond vite.
          </p>

          <div class="ft-pillbar">
            <a class="ft-pill" href="tel:+212522994484">
              <i class="fa-solid fa-phone"></i><span>+212 522 99 44 84</span>
            </a>
            <a class="ft-pill" href="mailto:contact@3skpartsauto.com">
              <i class="fa-solid fa-envelope"></i><span>contact@3skpartsauto.ma</span>
            </a>
          </div>
        </div>

        <div class="col-6 col-lg-2">
          <div class="ft-title">Catalogue</div>
          <ul class="ft-list">
            <li><a class="ft-link" href="{{ path('articles_page') }}"><i class="fa-solid fa-boxes-stacked"></i>Articles</a></li>
            <li><a class="ft-link" href="{{ path('articles_page', { new: 1, newDays: 5 }) }}"><i class="fa-solid fa-bolt"></i>Nouveautés</a></li>
            <li><a class="ft-link" href="{{ path('articles_page') }}#categories"><i class="fa-solid fa-list"></i>Catégories</a></li>
            <li><a class="ft-link" href="{{ path('cart_index') }}"><i class="fa-solid fa-cart-shopping"></i>Panier</a></li>
          </ul>
        </div>

        <div class="col-6 col-lg-2">
          <div class="ft-title">Compte</div>
          <ul class="ft-list">
            <li><a class="ft-link" href="{{ path('cart_index') }}"><i class="fa-solid fa-receipt"></i>Mes commandes</a></li>

            {% if app.user %}
              <li><a class="ft-link" href="#"><i class="fa-solid fa-id-card"></i>Mon profil</a></li>
              <li><a class="ft-link" href="{{ path('app_logout') }}" style="color:#ffdddd;">
                <i class="fa-solid fa-right-from-bracket"></i>Déconnexion
              </a></li>
            {% else %}
              <li><a class="ft-link" href="{{ path('app_login') }}"><i class="fa-solid fa-right-to-bracket"></i>Connexion</a></li>
              <li><a class="ft-link" href="#"><i class="fa-solid fa-user-plus"></i>Créer un compte</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="col-12 col-lg-3">
          <div class="ft-title">Infos</div>
          <div class="ft-meta">
            <div class="mb-2">
              <i class="fa-solid fa-location-dot me-2"></i>
             Hay Ennasr 2 N6 Lahraouine Casablanca, Casablanca, Morocco
            </div>
            <div>
              <i class="fa-regular fa-clock me-2"></i>
              Lun–Ven : 09:00 → 18:30 • Sam : 09:00 → 13:00
            </div>
          </div>

          <div class="d-flex gap-2 mt-3 ft-social">
            <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="#"><i class="fa-brands fa-instagram"></i></a>
            <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
          </div>
        </div>

      </div>
    </div>

    <div class="ft-divider"></div>

    <div class="ft-bottom">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>© {{ "now"|date("Y") }} 3sk parts auto • Tous droits réservés.</div>
        <div class="d-flex gap-3 flex-wrap">
          <a href="#" class="text-decoration-none" style="color:#ffffff;">Mentions légales</a>
          <a href="#" class="text-decoration-none" style="color:#ffffff;">Confidentialité</a>
        </div>
      </div>
    </div>

  </div>
</footer>