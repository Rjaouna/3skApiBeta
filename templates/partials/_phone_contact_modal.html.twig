<style>
  .phone-contact-trigger {
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .public-shell .public-topbar .phone-contact-trigger {
    color: var(--public-blue);
    text-decoration: none;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    background: transparent;
    padding: 0;
    text-transform: uppercase;
  }

  .public-shell .public-topbar .phone-contact-trigger:hover {
    color: var(--public-orange);
  }

  .public-shell .public-topbar-contact .phone-contact-trigger + a::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 22px;
    margin: 0 22px 0 18px;
    background: rgba(49,95,187,.2);
    vertical-align: middle;
  }

  .site-footer .phone-contact-trigger {
    display: inline;
    color: var(--public-muted, #667085);
    background: transparent;
    padding: 0;
    text-align: left;
  }

  .site-footer .phone-contact-trigger:hover {
    color: var(--public-blue, #315fbb);
  }

  .phone-contact-modal .modal-content {
    border: 0;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 28px 70px rgba(16,24,40,.24);
  }

  .phone-contact-modal__head {
    padding: 1.1rem 1.25rem;
    background:
      radial-gradient(circle at 12% 15%, rgba(255,145,0,.18), transparent 34%),
      linear-gradient(135deg, var(--public-blue, #315fbb), #163c7a);
    color: #fff;
  }

  .phone-contact-modal__icon {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    display: inline-grid;
    place-items: center;
    background: rgba(255,255,255,.14);
    color: #fff;
  }

  .phone-contact-list {
    display: grid;
    gap: .75rem;
  }

  .phone-contact-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .9rem;
    padding: .85rem;
    border: 1px solid rgba(49,95,187,.12);
    border-radius: 16px;
    background: rgba(49,95,187,.035);
  }

  .phone-contact-item__label {
    display: block;
    color: var(--public-muted, #667085);
    font-size: .76rem;
    font-weight: 500;
  }

  .phone-contact-item__number {
    display: block;
    color: var(--public-ink, #111827);
    font-size: .98rem;
    font-weight: 600;
    letter-spacing: .01em;
  }

  .phone-contact-item__call {
    flex: 0 0 auto;
    min-width: 44px;
    height: 44px;
    border-radius: 14px;
    display: inline-grid;
    place-items: center;
    color: #fff !important;
    background: var(--public-blue, #315fbb);
    text-decoration: none;
    box-shadow: 0 12px 22px rgba(49,95,187,.18);
  }

  .phone-contact-item__call:hover {
    background: var(--public-orange, #ff9100);
    color: #fff !important;
  }

  @media (max-width: 575.98px) {
    .public-shell .public-topbar-contact .phone-contact-trigger + a::before {
      display: none;
    }

    .phone-contact-item {
      padding: .75rem;
    }
  }
</style>

