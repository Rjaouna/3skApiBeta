{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-4">
  <div class="notification-page-hero d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
      <h3 class="mb-1">Mes notifications</h3>
      <div class="text-muted small">
        {{ unreadCount }} non lue{{ unreadCount > 1 ? 's' : '' }}
      </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <a class="btn {{ filter == '' ? 'btn-primary' : 'btn-outline-primary' }}" href="{{ path('notification_index') }}">
        Toutes
      </a>
      <a class="btn {{ filter == 'unread' ? 'btn-primary' : 'btn-outline-primary' }}" href="{{ path('notification_index', {filter: 'unread'}) }}">
        Non lues
      </a>
      <button class="btn btn-outline-secondary" type="button" id="markAllReadBtn">
        Tout marquer comme lu
      </button>
    </div>
  </div>

  <div class="alert alert-success d-none" id="notifSuccess"></div>
  <div class="alert alert-danger d-none" id="notifError"></div>

  {% if notifications is empty %}
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body text-muted">
        Aucune notification.
      </div>
    </div>
  {% else %}
    <div class="d-grid gap-3">
      {% for notification in notifications %}
        {% set data = notification.data ?? {} %}
        {% set link = null %}
        {% if data.route is defined and data.route %}
          {% set link = path(data.route, data.routeParams|default({})) %}
        {% elseif notification.targetType == 'order' and notification.targetId %}
          {% set link = path('order_show', {id: notification.targetId}) %}
        {% endif %}

        <div class="card border-0 shadow-sm rounded-4 notification-card {{ notification.isRead ? 'opacity-75' : '' }}"
             data-notification-card
             data-id="{{ notification.id }}">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3">
              <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  {% if not notification.isRead %}
                    <span class="badge text-bg-primary">Nouveau</span>
                  {% endif %}

                  <span class="badge
                    {% if notification.level == 'success' %}text-bg-success
                    {% elseif notification.level == 'warning' %}text-bg-warning
                    {% elseif notification.level == 'danger' %}text-bg-danger
                    {% else %}text-bg-light border{% endif %}">
                    {{ notification.type }}
                  </span>
                </div>

                <div class="fw-bold">{{ notification.title }}</div>
                <div class="text-muted small mt-1">{{ notification.message }}</div>
                <div class="small text-muted mt-2">{{ notification.createdAt|date('d/m/Y H:i') }}</div>
              </div>

              <div class="d-flex gap-2 flex-wrap">
                {% if link %}
                  <a href="{{ link }}" class="btn btn-outline-primary btn-sm" data-notification-link data-id="{{ notification.id }}">
                    Ouvrir
                  </a>
                {% endif %}

                {% if not notification.isRead %}
                  <button class="btn btn-outline-secondary btn-sm" type="button" data-mark-read data-id="{{ notification.id }}">
                    Marquer comme lu
                  </button>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if pages > 1 %}
      <div class="d-flex justify-content-end gap-2 mt-3">
        {% for p in 1..pages %}
          <a class="btn {{ p == page ? 'btn-primary' : 'btn-outline-primary' }} btn-sm"
             href="{{ path('notification_index', {page: p, filter: filter}) }}">
            {{ p }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</div>

<script>
(function(){
  const successBox = document.getElementById('notifSuccess');
  const errorBox = document.getElementById('notifError');
  const markAllBtn = document.getElementById('markAllReadBtn');

  function showSuccess(message){
    if (!successBox) return;
    successBox.textContent = message || '';
    successBox.classList.toggle('d-none', !message);
    if (errorBox) errorBox.classList.add('d-none');
  }

  function showError(message){
    if (!errorBox) return;
    errorBox.textContent = message || '';
    errorBox.classList.toggle('d-none', !message);
    if (successBox) successBox.classList.add('d-none');
  }

  async function markRead(id){
    const res = await fetch(`/api/notifications/${id}/read`, {
      method: 'POST',
      headers: { 'Accept': 'application/json' }
    });

    return res.json().catch(() => ({}));
  }

  document.querySelectorAll('[data-mark-read]').forEach(btn => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;

      try {
        const data = await markRead(btn.dataset.id);
        if (!data.ok) {
          showError(data.message || 'Erreur.');
          btn.disabled = false;
          return;
        }

        const card = btn.closest('[data-notification-card]');
        if (card) card.classList.add('opacity-75');
        btn.remove();

        showSuccess('Notification mise à jour.');
        window.dispatchEvent(new CustomEvent('notification:refresh'));
      } catch(e) {
        showError('Erreur réseau.');
        btn.disabled = false;
      }
    });
  });

  document.querySelectorAll('[data-notification-link]').forEach(link => {
    link.addEventListener('click', async (e) => {
      const id = link.dataset.id;
      if (!id) return;

      e.preventDefault();

      try {
        await markRead(id);
      } catch(e) {}

      window.dispatchEvent(new CustomEvent('notification:refresh'));
      window.location.href = link.getAttribute('href');
    });
  });

  markAllBtn?.addEventListener('click', async () => {
    markAllBtn.disabled = true;

    try {
      const res = await fetch('{{ path('notification_read_all') }}', {
        method: 'POST',
        headers: { 'Accept': 'application/json' }
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        showError(data.message || 'Erreur.');
        markAllBtn.disabled = false;
        return;
      }

      showSuccess('Toutes les notifications ont été marquées comme lues.');
      window.dispatchEvent(new CustomEvent('notification:refresh'));
      window.location.reload();
    } catch(e) {
      showError('Erreur réseau.');
      markAllBtn.disabled = false;
    }
  });
})();
</script>
{% endblock %}
