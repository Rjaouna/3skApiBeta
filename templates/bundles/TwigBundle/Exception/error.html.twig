{% extends 'base.html.twig' %}

{% block title %}Erreur - 3SK Parts Auto{% endblock %}

{% block body %}
  {% set status = status_code|default(500) %}
  {% set title = 'Une erreur est survenue' %}
  {% set message = 'La page demandée ne peut pas être affichée pour le moment. Notre équipe peut vous accompagner si le problème persiste.' %}

  <main class="container-fluid py-5">
    <section class="page-hero mx-auto" style="max-width: 920px;">
      <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-4">
        <div>
          <span class="badge bg-warning text-dark mb-3">Erreur {{ status }}</span>
          <h1 class="display-6 fw-bold mb-3">{{ title }}</h1>
          <p class="subtitle mb-0">{{ message }}</p>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2">
          <a href="{{ path('home') }}" class="btn btn-primary">
            <i class="fa-solid fa-house"></i>
            Accueil
          </a>
          <a href="tel:+212522713572" class="btn btn-outline-secondary">
            <i class="fa-solid fa-phone"></i>
            Appeler
          </a>
        </div>
      </div>
    </section>
  </main>
{% endblock %}
