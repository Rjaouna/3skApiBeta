{# templates/security/login.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<style>
  :root{
    --brand-primary: var(--bs-primary);
    --brand-black: #1b1b1b;
    --brand-soft: rgba(255,255,255,.84);
    --brand-border: rgba(0,0,0,.10);
    --brand-shadow: 0 18px 50px rgba(0,0,0,.12);
    --brand-muted: rgba(0,0,0,.58);
    --login-blue-night: rgba(7,26,58,.86);
    --login-blue-deep: rgba(9,31,73,.72);
  }

  body.theme-dark{
    --brand-soft: rgba(18,18,22,.76);
    --brand-border: rgba(255,255,255,.12);
    --brand-shadow: 0 24px 70px rgba(0,0,0,.50);
    --brand-muted: rgba(255,255,255,.66);
  }

  .login-public-shell{
    position:relative;
    z-index:3;
    font-family:'Roboto', sans-serif;
  }

  .login-public-shell a{
    transition: color .15s ease, background .15s ease, border-color .15s ease, transform .15s ease;
  }

  .login-public-shell .public-site-header{
    position:sticky;
    top:0;
    z-index:1030;
    box-shadow:0 12px 34px rgba(0,0,0,.28);
  }

  .login-public-shell .public-topbar{
    position:relative;
    overflow:hidden;
    background:#05070d;
    border-bottom:1px solid rgba(255,255,255,.78);
    color:rgba(255,255,255,.84);
    font-family:'Montserrat', sans-serif;
    font-size:11px;
    min-height:37px;
    text-transform:uppercase;
  }

  .login-public-shell .public-topbar a{
    color:rgba(255,255,255,.9);
    text-decoration:none;
    font-weight:600;
    line-height:1;
    white-space:nowrap;
  }

  .login-public-shell .public-topbar a:hover{
    color:#fff;
  }

  .login-public-shell .public-topbar-contact{
    min-height:37px;
  }

  .login-public-shell .public-topbar-contact a + a::before{
    content:"";
    display:inline-block;
    width:1px;
    height:12px;
    margin:0 14px 0 10px;
    background:rgba(255,255,255,.38);
    vertical-align:middle;
  }

  .login-public-shell .public-topbar-actions{
    position:relative;
    display:inline-flex;
    align-items:center;
    gap:.85rem;
    min-height:37px;
    padding:0 1.05rem;
    margin-block:-0.5rem;
    background:rgba(var(--bs-secondary-rgb), .88);
    color:#fff;
  }

  .login-public-shell .public-topbar-actions::before,
  .login-public-shell .public-topbar-actions::after{
    content:"";
    position:absolute;
    top:0;
    width:0;
    height:0;
    border-style:solid;
  }

  .login-public-shell .public-topbar-actions::before{
    right:100%;
    border-width:0 13px 37px 0;
    border-color:transparent rgba(var(--bs-secondary-rgb), .88) transparent transparent;
  }

  .login-public-shell .public-topbar-actions::after{
    left:100%;
    border-width:37px 0 0 11px;
    border-color:transparent transparent transparent rgba(var(--bs-secondary-rgb), .88);
  }

  .login-public-shell .public-topbar-actions a{
    display:inline-flex;
    align-items:center;
    gap:.42rem;
    color:#fff;
  }

  .login-public-shell .public-topbar-actions a:hover{
    color:rgba(255,255,255,.82);
  }

  .login-public-shell .public-topbar-separator{
    width:1px;
    height:12px;
    background:rgba(255,255,255,.55);
  }

  .login-public-shell .public-navbar{
    border-bottom:1px solid rgba(255,255,255,.08);
    background:#000;
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
  }

  .login-public-shell .public-navbar .navbar-brand{
    --logo-panel-height:112px;
    --logo-panel-angle:34px;
    position:relative;
    isolation:isolate;
    display:inline-flex;
    align-items:center;
    min-height:var(--logo-panel-height);
    background:#fff;
    border-radius:0;
    padding:.38rem 1.35rem;
    margin-left:1.25rem;
    margin-right:1.55rem;
    box-shadow:none;
  }

  .login-public-shell .public-navbar .navbar-brand::before,
  .login-public-shell .public-navbar .navbar-brand::after{
    content:"";
    position:absolute;
    top:0;
    width:0;
    height:0;
    border-style:solid;
  }

  .login-public-shell .public-navbar .navbar-brand::before{
    right:100%;
    border-width:0 var(--logo-panel-angle) var(--logo-panel-height) 0;
    border-color:transparent #fff transparent transparent;
  }

  .login-public-shell .public-navbar .navbar-brand::after{
    left:100%;
    border-width:var(--logo-panel-height) 0 0 var(--logo-panel-angle);
    border-color:transparent transparent transparent #fff;
  }

  .login-public-shell .public-navbar .navbar-brand img{
    height:100px;
    width:auto;
    object-fit:contain;
    display:block;
  }

  .login-public-shell .public-navbar .nav-link{
    color:#fff;
    font-family:'Montserrat', sans-serif;
    font-size:11px;
    font-weight:600;
    letter-spacing:.015em;
    text-transform:uppercase;
    position:relative;
    padding:1.75rem 0 !important;
    margin:0 1.05rem;
  }

  .login-public-shell .public-navbar .nav-link::after{
    content:"";
    position:absolute;
    left:0;
    right:0;
    bottom:1.3rem;
    height:2px;
    background:var(--bs-secondary);
    transform:scaleX(0);
    transform-origin:left;
    transition:transform .16s ease;
  }

  .login-public-shell .public-navbar .nav-link:hover,
  .login-public-shell .public-navbar .nav-link:focus{
    color:rgba(255,255,255,.62);
  }

  .login-public-shell .public-navbar .nav-link:hover::after,
  .login-public-shell .public-navbar .nav-link:focus::after{
    transform:scaleX(1);
  }

  .login-public-shell .public-menu-cta{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border-radius:0 !important;
    background:var(--bs-secondary) !important;
    border-color:var(--bs-secondary) !important;
    color:#fff !important;
    box-shadow:none !important;
    font-family:'Montserrat', sans-serif;
    font-size:11px;
    line-height:1;
    text-transform:uppercase;
    padding-block:.68rem;
  }

  .login-public-shell .public-menu-cta:hover{
    background:#fff !important;
    border-color:#fff !important;
    color:#000 !important;
  }

  .login-public-shell .public-navbar .navbar-toggler{
    border-color:rgba(255,255,255,.20);
    border-radius:0;
    background:rgba(255,255,255,.10);
  }

  .login-public-shell .public-navbar .navbar-toggler-icon{
    filter:invert(1);
  }

  .login-public-shell .public-footer{
    border-top:4px solid var(--bs-secondary);
    padding-top:5.75rem !important;
    padding-bottom:5.25rem !important;
    background:var(--bs-primary);
    color:#fff;
    box-shadow:
      inset 0 1px 0 rgba(var(--bs-secondary-rgb), .34),
      inset 0 1px 0 rgba(255,255,255,.18);
  }

  .login-public-shell .public-footer h3{
    color:#fff;
    text-shadow:none;
  }

  .login-public-shell .public-footer h4{
    color:var(--bs-secondary);
    text-shadow:none;
  }

  .login-public-shell .public-footer h4{
    position:relative;
    padding-bottom:.7rem;
  }

  .login-public-shell .public-footer h4::after{
    content:"";
    position:absolute;
    left:0;
    bottom:0;
    width:42px;
    height:3px;
    background:#fff;
    border-radius:999px;
  }

  .login-public-shell .public-footer hr{
    border-color:rgba(255,255,255,.28);
    opacity:1;
  }

  .login-public-shell .public-footer a{
    color:rgba(255,255,255,.9);
    text-decoration:none;
  }

  .login-public-shell .public-footer a:hover{
    color:var(--bs-secondary);
  }

  .login-public-shell .public-footer-muted{
    color:rgba(255,255,255,.76);
  }

  .login-public-shell .public-footer-logo{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:min(100%, 285px);
    min-height:112px;
    padding:.85rem 1.35rem;
    margin-bottom:1.25rem;
    border-radius:8px;
    background:#fff;
    border:1px solid rgba(16,24,40,.09);
    box-shadow:0 18px 38px rgba(16,24,40,.12);
  }

  .login-public-shell .public-footer-logo:hover{
    transform:translateY(-1px);
  }

  .login-public-shell .public-footer-logo img{
    display:block;
    width:100%;
    max-width:240px;
    max-height:88px;
    object-fit:contain;
  }

  .login-public-shell .public-footer-pill{
    display:inline-flex;
    align-items:center;
    gap:.5rem;
    padding:.55rem .9rem;
    border-radius:999px;
    border:1px solid rgba(255,255,255,.34);
    background:rgba(255,255,255,.1);
    color:#fff !important;
    font-weight:900;
    text-decoration:none;
    box-shadow:0 10px 24px rgba(16,24,40,.14);
  }

  .login-public-shell .public-footer-pill:hover{
    background:var(--bs-secondary);
    border-color:var(--bs-secondary);
    color:#fff !important;
  }

  .login-public-shell .public-footer-account{
    height:100%;
    padding:1.35rem;
    border-radius:8px;
    border:1px solid rgba(16,24,40,.10);
    background:linear-gradient(145deg, #05070d, #0d1931);
    box-shadow:0 18px 38px rgba(16,24,40,.16);
  }

  .login-public-shell .public-footer-account p{
    color:rgba(255,255,255,.72);
  }

  .login-public-shell .public-footer-account a:not(.public-footer-login-btn){
    color:#fff;
  }

  .login-public-shell .public-footer-account a:not(.public-footer-login-btn):hover{
    color:var(--bs-secondary);
  }

  .login-public-shell .public-footer-login-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:.55rem;
    border-radius:8px !important;
    background:var(--bs-secondary) !important;
    border-color:var(--bs-secondary) !important;
    color:#fff !important;
    box-shadow:0 12px 26px rgba(0,0,0,.22);
  }

  .login-public-shell .public-footer-login-btn:hover{
    background:#fff !important;
    border-color:#fff !important;
    color:#05070d !important;
    transform:translateY(-1px);
  }

  .login-public-shell .public-footer-social a{
    width:40px;
    height:40px;
    border-radius:8px;
    border:1px solid rgba(255,255,255,.34);
    display:grid;
    place-items:center;
    color:#fff;
    background:rgba(255,255,255,.1);
    box-shadow:0 10px 24px rgba(16,24,40,.14);
  }

  .login-public-shell .public-footer-social a:hover{
    transform:translateY(-1px);
    background:var(--bs-secondary);
    border-color:var(--bs-secondary);
    color:#fff;
  }

  .login-bg-video{
    position:fixed;
    inset:0;
    z-index:0;
    width:100vw;
    height:100vh;
    object-fit:cover;
    pointer-events:none;
  }

  .login-video-overlay{
    position:fixed;
    inset:0;
    z-index:1;
    pointer-events:none;
    background:
      linear-gradient(90deg, var(--login-blue-night) 0%, rgba(49,95,187,.60) 46%, rgba(49,95,187,.30) 100%),
      linear-gradient(0deg, var(--login-blue-deep) 0%, transparent 52%),
      radial-gradient(920px circle at 18% 12%, rgba(var(--bs-primary-rgb), .34), transparent 42%),
      radial-gradient(780px circle at 88% 18%, rgba(var(--bs-secondary-rgb), .24), transparent 38%);
  }

  .login-video-overlay::after{
    content:"";
    position:absolute;
    inset:0;
    background:rgba(7,26,58,.12);
  }

  .login-page{
    min-height: auto;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:42px 0 46px;
    position:relative;
    z-index:2;
  }

  .login-page::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    background:
      radial-gradient(900px circle at 15% 10%, rgba(var(--bs-primary-rgb), .18), transparent 38%),
      radial-gradient(1000px circle at 90% 15%, rgba(var(--bs-secondary-rgb), .12), transparent 35%),
      radial-gradient(800px circle at 50% 100%, rgba(var(--bs-primary-rgb), .14), transparent 36%);
    z-index:0;
  }

  .login-stack{
    position:relative;
    z-index:1;
    width:min(620px, 94vw);
  }

  .login-card{
    border-radius:8px;
    border:1px solid rgba(255,255,255,.16);
    border-top:4px solid var(--bs-secondary);
    background:
      radial-gradient(760px circle at 100% 0%, rgba(var(--bs-primary-rgb), .22), transparent 42%),
      radial-gradient(620px circle at 0% 100%, rgba(var(--bs-secondary-rgb), .16), transparent 42%),
      linear-gradient(180deg, rgba(0,0,0,.86) 0%, rgba(5,7,13,.88) 54%, rgba(13,25,49,.88) 100%);
    box-shadow:0 28px 72px rgba(0,0,0,.38);
    backdrop-filter:blur(12px);
    overflow:hidden;
  }

  .login-head{
    padding:18px 24px 14px;
    border-bottom:1px solid rgba(255,255,255,.12);
    background:
      linear-gradient(135deg, rgba(var(--bs-secondary-rgb), .14), transparent 45%),
      linear-gradient(225deg, rgba(var(--bs-primary-rgb), .12), transparent 42%);
  }

  body.theme-dark .login-head{
    border-bottom-color:rgba(255,255,255,.08);
  }

  .login-title-row{
    display:flex;
    align-items:center;
    gap:14px;
  }

  .login-icon{
    width:52px;
    height:52px;
    border-radius:8px;
    display:grid;
    place-items:center;
    background:rgba(var(--bs-secondary-rgb), .16);
    border:1px solid rgba(var(--bs-secondary-rgb), .42);
    color:var(--bs-secondary);
    font-size:1.05rem;
    flex:0 0 52px;
  }

  .login-title{
    margin:0;
    font-size:1.45rem;
    font-weight:900;
    color:#fff;
  }

  body.theme-dark .login-title{
    color:rgba(255,255,255,.92);
  }

  .login-subtitle{
    margin-top:2px;
    color:rgba(255,255,255,.68);
    font-weight:700;
    font-size:.92rem;
  }

  .login-body{
    padding:20px 24px 22px;
  }

  .form-label{
    font-weight:900;
    margin-bottom:8px;
    color:rgba(255,255,255,.88);
  }

  .input-shell{
    position:relative;
  }

  .input-icon{
    position:absolute;
    left:14px;
    top:50%;
    transform:translateY(-50%);
    color:rgba(var(--bs-secondary-rgb), .88);
    z-index:2;
  }

  body.theme-dark .input-icon{
    color:rgba(255,255,255,.46);
  }

  .login-control{
    height:54px;
    border-radius:8px;
    border:1px solid rgba(255,255,255,.16);
    background:rgba(255,255,255,.08);
    color:#fff;
    padding-left:42px;
    font-weight:700;
    box-shadow:none !important;
  }

  .login-control::placeholder{
    color:rgba(255,255,255,.48);
  }

  .login-control:focus{
    border-color:rgba(var(--bs-secondary-rgb), .68);
    box-shadow:0 0 0 .22rem rgba(var(--bs-secondary-rgb), .14) !important;
    background:rgba(255,255,255,.12);
    color:#fff;
  }

  body.theme-dark .login-control{
    background:rgba(22,22,28,.88);
    border-color:rgba(255,255,255,.10);
    color:rgba(255,255,255,.92);
  }

  body.theme-dark .login-control::placeholder{
    color:rgba(255,255,255,.42);
  }

  .password-toggle{
    position:absolute;
    right:12px;
    top:50%;
    transform:translateY(-50%);
    border:0;
    background:transparent;
    width:34px;
    height:34px;
    border-radius:8px;
    color:rgba(255,255,255,.66);
  }

  body.theme-dark .password-toggle{
    color:rgba(255,255,255,.55);
  }

  .password-toggle:hover{
    background:rgba(255,145,0,.14);
    color:#fff;
  }

  body.theme-dark .password-toggle:hover{
    background:rgba(255,255,255,.06);
  }

  .login-btn{
    height:54px;
    border:0;
    border-radius:8px;
    font-weight:900;
    letter-spacing:.01em;
    background:linear-gradient(135deg, #d96d00, var(--bs-secondary));
    box-shadow:0 14px 30px rgba(var(--bs-secondary-rgb), .28);
  }

  .login-btn:hover{
    background:linear-gradient(135deg, var(--bs-secondary), #ffad3d);
    filter:brightness(1.05);
    transform:translateY(-1px);
  }

  .login-btn:active{
    transform:translateY(0);
  }

  .login-footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    margin-top:16px;
    flex-wrap:wrap;
  }

  .login-muted{
    color:rgba(255,255,255,.66);
    font-weight:700;
    font-size:.92rem;
  }

  .login-link{
    color:var(--bs-secondary);
    font-weight:900;
    text-decoration:none;
  }

  .login-link:hover{
    text-decoration:underline;
  }

  @media (max-width: 575px){
    .login-page{
      padding:28px 0 32px;
    }

    .login-card{
      border-radius:8px;
    }

    .login-head,
    .login-body{
      padding:18px;
    }

    .login-title{
      font-size:1.2rem;
    }
  }

  @media (max-width: 991px){
    .login-public-shell .public-navbar .nav-link{
      margin:0;
      padding:.85rem 0 !important;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .login-public-shell .public-navbar .nav-link::after{
      display:none;
    }

    .login-public-shell .public-navbar .navbar-collapse{
      padding-top:1rem;
      padding-bottom:1rem;
    }

    .login-public-shell .public-menu-cta{
      width:100%;
      padding-block:.9rem !important;
    }
  }

  @media (max-width: 575px){
    .login-public-shell .public-footer{
      padding-top:4.25rem !important;
      padding-bottom:4rem !important;
    }

    .login-public-shell .public-topbar{
      font-size:10px;
    }

    .login-public-shell .public-topbar-contact a + a::before,
    .login-public-shell .public-topbar-actions::before,
    .login-public-shell .public-topbar-actions::after{
      display:none;
    }

    .login-public-shell .public-topbar-actions{
      width:100%;
      justify-content:center;
      margin-block:0;
      padding:.7rem 1rem;
    }

    .login-public-shell .public-navbar .navbar-brand{
      --logo-panel-height:68px;
      --logo-panel-angle:20px;
      margin-left:1rem;
      margin-right:1rem;
      padding:.32rem 1rem;
    }

    .login-public-shell .public-navbar .navbar-brand img{
      height:58px;
    }
  }
</style>

<video class="login-bg-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
  <source src="{{ asset('videos/7186026_Paint_Ink_1280x720.mp4') }}" type="video/mp4">
</video>
