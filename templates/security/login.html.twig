{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/login.css') }}?v=20261016-2">
{% endblock %}

{% block body %}
<div class="login-public-shell public-shell">
  {% include 'partials/_public_header.html.twig' with {
    public_header_nav_id: 'publicLoginNav'
  } %}
</div>

<main class="login-page login-experience" aria-labelledby="login-title">
  <div class="login-layout">
    <div class="login-stack">
      <section class="login-card" aria-labelledby="login-title">
        <div class="login-head">
          <div class="login-title-row">
            <span class="login-icon" aria-hidden="true"><i class="fa-solid fa-shield-halved"></i></span>
            <div>
              <span class="login-eyebrow">Espace client</span>
              <h1 class="login-title" id="login-title">Connexion</h1>
            </div>
          </div>
          <p class="login-subtitle">Accédez à votre compte 3SK Parts Auto</p>
        </div>

        <div class="login-body">
          <form method="post" novalidate>
            {% if error %}
              <div class="alert alert-danger mb-3" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
              </div>
            {% endif %}

            {% if app.user %}
              <div class="alert alert-info mb-3" role="status">
                Vous êtes déjà connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                <a href="{{ logout_path() }}" class="ms-1">Déconnexion</a>
              </div>
            {% endif %}

            <div class="login-field">
              <label for="inputEmail" class="form-label">Email</label>
              <div class="input-shell">
                <i class="fa-solid fa-envelope input-icon" aria-hidden="true"></i>
                <input
                  type="email"
                  value="{{ last_username }}"
                  name="email"
                  id="inputEmail"
                  class="form-control login-control"
                  placeholder="ex : client@gmail.com"
                  autocomplete="email"
                  required
                  autofocus
                >
              </div>
            </div>

            <div class="login-field">
              <label for="inputPassword" class="form-label">Mot de passe</label>
              <div class="input-shell">
                <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
                <input
                  type="password"
                  name="password"
                  id="inputPassword"
                  class="form-control login-control"
                  placeholder="Votre mot de passe"
                  autocomplete="current-password"
                  required
                >
                <button type="button" class="password-toggle" id="togglePassword" aria-label="Afficher le mot de passe" aria-controls="inputPassword" aria-pressed="false" title="Afficher le mot de passe">
                  <i class="fa-solid fa-eye" aria-hidden="true"></i>
                </button>
              </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn login-btn" type="submit">
              <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
              Se connecter
              <i class="fa-solid fa-arrow-right login-btn-arrow" aria-hidden="true"></i>
            </button>
          </form>

          <div class="login-help">
            <span>Besoin d'aide ?</span>
            <button type="button" data-bs-toggle="modal" data-bs-target="#phoneContactModal"><i class="fa-solid fa-phone" aria-hidden="true"></i>Nous appeler</button>
          </div>
        </div>
      </section>
      <a class="login-back" href="{{ path('home') }}"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Retour à l'accueil</a>
    </div>

    <aside class="login-story" aria-labelledby="login-story-title">
      <span class="login-eyebrow login-story__eyebrow">Au service des professionnels</span>
      <h2 id="login-story-title">3SK Parts <span>Auto</span></h2>
      <p class="login-story__intro">Importateur et distributeur de pièces automobiles, carrosseries et accessoires.</p>
      <figure class="login-story__visual">
        <img src="{{ optimized_asset('img/bg-section/stock-entrepot-pieces-carrosserie-automobile-3sk-parts-auto.jpeg') }}" alt="Stock de pièces carrosserie dans l'entrepôt 3SK Parts Auto" width="1086" height="1448" decoding="async">
      </figure>
      <div class="login-story__signature">
        <span class="login-story__icon" aria-hidden="true"><i class="fa-solid fa-boxes-stacked"></i></span>
        <div><strong>Pièces carrosserie & accessoires</strong><span>Casablanca · Depuis 2014</span></div>
      </div>
    </aside>
  </div>
</main>

<div class="login-public-shell">
  {% include 'partials/_site_footer.html.twig' with {
    footer_connected: false,
    footer_home_href: path('home'),
    footer_anchor_prefix: path('home')
  } %}
</div>

<script>
(function () {
  const btn = document.getElementById('togglePassword');
  const input = document.getElementById('inputPassword');
  if (!btn || !input) return;

  btn.addEventListener('click', function () {
    const isPassword = input.getAttribute('type') === 'password';
    const label = isPassword ? 'Masquer le mot de passe' : 'Afficher le mot de passe';
    input.setAttribute('type', isPassword ? 'text' : 'password');
    btn.setAttribute('aria-pressed', String(isPassword));
    btn.setAttribute('aria-label', label);
    btn.setAttribute('title', label);
    btn.innerHTML = isPassword
      ? '<i class="fa-solid fa-eye-slash" aria-hidden="true"></i>'
      : '<i class="fa-solid fa-eye" aria-hidden="true"></i>';
  });
})();
</script>
{% endblock %}
