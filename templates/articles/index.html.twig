{% extends 'base.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/catalog-filters.css') }}?v=20261016-4">
{% endblock %}

{% block body %}

  {% set initial = initial|default({
    q: app.request.query.get('q', ''),
    family: app.request.query.get('family', ''),
    brand: app.request.query.get('brand', app.request.query.get('marque', '')),
    vehicle: app.request.query.get('vehicle', app.request.query.get('vehicule', '')),
    anneeFrom: app.request.query.get('anneeFrom', ''),
    anneeTo: app.request.query.get('anneeTo', ''),
    annee: app.request.query.get('annee', ''),
    inStock: app.request.query.get('inStock', ''),
    new: app.request.query.get('new', ''),
    newDays: (app.request.query.get('newDays', 5))
  }) %}

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@15.7.1/dist/nouislider.min.css">
  <script src="https://cdn.jsdelivr.net/npm/nouislider@15.7.1/dist/nouislider.min.js"></script>

  <style>
    :root{
      --pc-radius: 18px;
      --pc-border: rgba(0,0,0,.10);
      --pc-shadow: 0 14px 34px rgba(0,0,0,.08);
      --pc-muted: rgba(0,0,0,.58);
    }
    body.theme-dark{
      --pc-border: rgba(255,255,255,.14);
      --pc-shadow: 0 18px 46px rgba(0,0,0,.35);
      --pc-muted: rgba(255,255,255,.65);
    }

.page-hero{
  border-radius: 22px;
  border: 1px solid var(--pc-border);
  box-shadow: var(--pc-shadow);
  padding: 16px;
  background:
    radial-gradient(900px circle at 10% 10%, rgba(var(--bs-primary-rgb), .16), transparent 40%),
    radial-gradient(900px circle at 90% 30%, rgba(var(--bs-secondary-rgb), .14), transparent 38%),
    linear-gradient(180deg, rgba(0,0,0,.02), transparent);
}

.articles-reset-btn{
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-width: 76px;
  min-height: 38px;
  padding: 8px 12px !important;
  font-size: .9rem;
  font-weight: 600;
  border-color: rgba(var(--brand-blue-rgb), .35) !important;
  color: var(--app-blue, var(--bs-primary)) !important;
  background: rgba(255,255,255,.86) !important;
  text-indent: 0 !important;
  opacity: 1 !important;
  text-decoration: none !important;
  line-height: 1 !important;
  overflow: visible !important;
  white-space: nowrap !important;
}

.articles-reset-btn i,
.articles-reset-btn span{
  display: inline-flex !important;
  align-items: center;
  color: var(--app-blue, var(--bs-primary)) !important;
  font-size: .9rem !important;
  line-height: 1 !important;
  opacity: 1 !important;
  visibility: visible !important;
}

.articles-reset-btn:hover,
.articles-reset-btn:focus{
  border-color: var(--app-blue, var(--bs-primary)) !important;
  background: rgba(var(--brand-blue-rgb), .08) !important;
  color: var(--app-blue, var(--bs-primary)) !important;
}

    .filters-card{
      border-radius: 22px;
      border: 1px solid var(--pc-border);
      box-shadow: var(--pc-shadow);
      background: rgba(255,255,255,.75);
      backdrop-filter: blur(8px);
    }
    body.theme-dark .filters-card{ background: rgba(18,18,22,.62); }

    .product-grid{
      display:grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 14px;
    }
    @media (min-width: 768px){
      .product-grid{ grid-template-columns: repeat(4, minmax(0,1fr)); }
    }
    @media (min-width: 1200px){
      .product-grid{ grid-template-columns: repeat(5, minmax(0,1fr)); }
    }

    .product-card{
      position: relative;
      display:flex;
      flex-direction:column;
      border-radius: 16px;
      border: 1px solid rgba(var(--bs-primary-rgb), .18);
      box-shadow: 0 8px 18px rgba(var(--brand-anthracite-rgb), .055);
      background: #fff;
      overflow: hidden;
      padding: 12px;
      transition: transform .08s ease, box-shadow .12s ease, border-color .12s ease;
    }
    body.theme-dark .product-card{ background: rgba(18,18,22,.88); }

    .product-card:hover{
      transform: translateY(-2px);
      box-shadow: 0 14px 28px rgba(var(--brand-anthracite-rgb), .10);
      border-color: rgba(13,110,253,.22);
    }

    .wishlist-button{
      position:static;
      min-width: 0;
      height: auto;
      width: auto;
      padding: 3px 8px;
      border-radius: 999px;
      border: 1px solid rgba(25,135,84,.20);
      background: #198754;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      white-space: nowrap;
      line-height: 1;
      color: white !important;
    }

    .wishlist-button [data-stock-badge]{
      font-weight: 700;
      font-size: .66rem;
      line-height: 1;
      text-transform: uppercase;
    }
   
    body.theme-dark .wishlist-button{
      background: rgba(25,135,84,.18);
      border-color: rgba(25,135,84,.28);
    }

    .product-card__image{
      position: relative;
      padding: 0;
      margin-bottom: 10px;
      background: transparent;
    }

    .badge-pill{
      position:absolute;
      left: 8px;
      top: 8px;
      display:flex; align-items:center; gap:6px;
      padding: 6px 8px;
      border: 0;
      border-radius: 999px;
      background: var(--app-orange, #ff8a00);
      font-weight: 700;
      font-size: .68rem;
      z-index: 4;
      line-height: 1;
    }
    body.theme-dark .badge-pill{
      border-color: rgba(255,255,255,.14);
      background: rgba(18,18,22,.70);
    }

    .discount-badge{
      background: var(--app-orange, #ff8a00) !important;
      color: #fff !important;
    }

    .badge-newimg{
      position: absolute;
      top: 7px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 6;
      pointer-events: none;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .badge-newimg img{
      width: min(220px, 100%);
      height: auto;
      filter: drop-shadow(0 10px 18px rgba(0,0,0,.18));
    }
    body.theme-dark .badge-newimg img{
      filter: drop-shadow(0 14px 24px rgba(0,0,0,.55));
    }

    .product-img{
      width: 100%;
      aspect-ratio: 4/3;
      object-fit: contain;
      border-radius: 15px;
      background: #fff;
      padding: 10px;
      border: 1px solid rgba(var(--bs-primary-rgb), .16);
    }
    body.theme-dark .product-img{ background: rgba(255,255,255); border-color: rgba(255,255,255,.10); }

    .product-card__info{ padding: 0; }

    .refPlusCopy{
      display:flex; align-items:center; gap:8px;
      font-weight: 500;
      font-size: .78rem;
    }
    .product-reference{ text-decoration:none; color: inherit; }

    .designation{
      display:block;
      margin-top: 0;
      min-height: 38px;
      font-weight: 600;
      font-size: .82rem;
      line-height: 1.18;
      color: rgba(0,0,0,.88);
      text-decoration:none;
      text-transform: uppercase;
    }
    body.theme-dark .designation{ color: rgba(255,255,255,.86); }

    .vehicle-line{
      margin-top: 6px;
      min-height: 17px;
      color: var(--pc-muted);
      font-size: .71rem;
      text-transform: uppercase;
    }

    .meta-line{
      margin: 0 0 8px;
      font-size: .70rem;
      color: var(--pc-muted);
      display:flex;
      flex-wrap:wrap;
      gap: 6px;
    }
    .meta-chip{
      border: 1px solid rgba(var(--bs-primary-rgb), .18);
      background: rgba(var(--bs-primary-rgb), .08);
      border-radius: 999px;
      padding: 3px 7px;
      font-weight: 700;
      font-size: .66rem;
      line-height: 1;
      color: var(--bs-primary);
      text-transform: uppercase;
      max-width: 100%;
    }
    .meta-chip--family{
      border-color: rgba(var(--brand-orange-rgb), .25);
      background: rgba(var(--brand-orange-rgb), .10);
      color: var(--app-orange, #ff8a00);
    }
    .meta-chip--brand-logo{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 48px;
      height: 22px;
      padding: 2px 5px;
      border-color: rgba(var(--brand-anthracite-rgb), .14);
      background: #fff;
    }
    .meta-chip--brand-logo img{
      display: block;
      max-width: 68px;
      max-height: 16px;
      object-fit: contain;
    }
    .meta-chip--brand-logo img[hidden]{ display: none; }
    .meta-chip--brand-logo .brand-logo-fallback[hidden]{ display: none; }
    body.theme-dark .meta-chip{
      border-color: rgba(255,255,255,.14);
      background: rgba(18,18,22,.62);
    }
    body.theme-dark .meta-chip--brand-logo{
      background: #fff;
    }

    .product-card__footer{
      margin-top:auto;
      padding: 10px 0 0;
    }

    .product-card__prices{
      display:flex;
      justify-content:space-between;
      align-items:baseline;
      gap: 8px;
      font-weight: 700;
    }
    .price-ttc{
      font-size: 1.25rem;
      color: var(--bs-primary);
      letter-spacing: 0;
    }
    .price-label{
      font-size: .66rem;
      color: var(--pc-muted);
      font-weight: 500;
    }

    .catalog-info-list{
      margin-top: 10px;
      border-top: 1px solid rgba(var(--brand-anthracite-rgb), .10);
    }
    .catalog-info-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap: 10px;
      padding: 6px 0;
      border-bottom: 1px solid rgba(var(--brand-anthracite-rgb), .10);
      font-size: .72rem;
      line-height: 1.2;
    }
    .catalog-info-label{
      color: var(--pc-muted);
      font-weight: 500;
    }
    .catalog-info-value{
      color: rgba(var(--brand-anthracite-rgb), .90);
      text-align:right;
      font-weight: 500;
      max-width: 62%;
      overflow-wrap:anywhere;
    }
    body.theme-dark .catalog-info-row{
      border-color: rgba(255,255,255,.12);
    }
    body.theme-dark .catalog-info-value{
      color: rgba(255,255,255,.88);
    }

    .bottomFooterWrapper{
      margin-top: 10px;
      display:flex;
      align-items:center;
      gap: 6px;
    }

    .addcart{
      margin-left:0;
      height: 30px;
      flex: 1 1 auto;
      border-radius: 4px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap: 6px;
      padding: 0 8px;
      border: 1px solid var(--bs-primary);
      background: var(--bs-primary);
      color: #fff;
      font-weight: 700;
      font-size: .78rem;
    }
    .addcart:hover{
      background: var(--bs-primary);
      border-color: var(--bs-primary);
      color: #fff;
      filter: brightness(.96);
    }
    .addcart:disabled{
      opacity: .60;
      cursor: not-allowed;
      background: rgb(255, 255, 255);
      color: var(--pc-muted);
      border-color: rgba(0,0,0,.10);
    }

    .cart-count-btn{
      min-width: 18px;
      height: 18px;
      border-radius: 999px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      font-size: .68rem;
      line-height: 1;
      font-weight: 700;
      color: var(--bs-primary);
      background: #fff;
    }
    body.theme-dark .cart-count-btn{
      background: rgba(255,255,255,.10);
      border-color: rgba(255,255,255,.14);
    }

    .skeleton{
      height: 380px;
      border-radius: var(--pc-radius);
      border: 1px solid rgba(0,0,0,.06);
      background: linear-gradient(90deg, rgba(0,0,0,.04), rgba(0,0,0,.08), rgba(0,0,0,.04));
      background-size: 200% 100%;
      animation: sk 1.2s infinite;
    }
    @keyframes sk { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    #yearSlider{ margin-top: 8px; margin-bottom: 10px; }
    .noUi-target{
      border: 1px solid var(--pc-border);
      border-radius: 999px;
      box-shadow: none;
      background: rgba(0,0,0,.05);
      height: 10px;
    }
    body.theme-dark .noUi-target{ background: rgba(255,255,255,.10); }
    .noUi-connect{ background: rgb(191 191 191); }
    .noUi-handle{
      width: 22px !important;
      height: 22px !important;
      border-radius: 999px !important;
      border: 1px solid var(--pc-border) !important;
      background: rgba(255,255,255,.98) !important;
      box-shadow: 0 10px 20px rgba(0,0,0,.12) !important;
      top: -7px !important;
      right: -11px !important;
    }
    body.theme-dark .noUi-handle{
      background: rgba(18,18,22,.92) !important;
      box-shadow: 0 16px 32px rgba(0,0,0,.35) !important;
    }
    .noUi-handle:before,
    .noUi-handle:after{ display:none !important; }

    .qty-stepper{
      display:flex;
      align-items:stretch;
      height: 30px;
      border: 1px solid var(--pc-border);
      border-radius: 4px;
      overflow: hidden;
      background: rgba(255,255,255,.92);
      flex: 0 0 auto;
    }
    body.theme-dark .qty-stepper{ background: rgba(18,18,22,.70); }

    .qty-btn{
      width: 28px;
      border: 0;
      background: transparent;
      display:grid;
      place-items:center;
      font-weight: 600;
      color: rgba(0,0,0,.65);
      transition: background .12s ease, color .12s ease;
      flex: 0 0 28px;
    }
    body.theme-dark .qty-btn{ color: rgba(255,255,255,.75); }

    .qty-btn:hover{ background: rgba(0,0,0,.05); }
    body.theme-dark .qty-btn:hover{ background: rgba(255,255,255,.06); }

    .qty-btn:disabled{
      opacity: .45;
      cursor: not-allowed;
    }

    .qty-field{
      width: 48px;
      border: 0;
      outline: none;
      text-align: center;
      font-weight: 500;
      background: transparent;
      color: rgba(0,0,0,.85);
    }
    body.theme-dark .qty-field{ color: rgba(255,255,255,.90); }
    .qty-field:disabled{ opacity: .6; }
    .filters-panel{
  border-radius: 22px;
  border: 1px solid var(--pc-border);
  box-shadow: var(--pc-shadow);
  background: rgba(255,255,255,.78);
  backdrop-filter: blur(10px);
  padding: 16px;
  position: sticky;
  top: 92px;
}

body.theme-dark .filters-panel{
  background: rgba(18,18,22,.68);
}

.filters-panel__head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  margin-bottom:16px;
}

.filters-panel__kicker{
  font-size: .74rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--pc-muted);
}

.filters-panel__title{
  font-size: 1.02rem;
  font-weight: 650;
  line-height: 1.1;
}

.filters-panel__badge{
  width: 38px;
  height: 38px;
  border-radius: 14px;
  display:grid;
  place-items:center;
  border: 1px solid var(--pc-border);
  background: rgba(255,255,255,.65);
  color: rgba(var(--bs-primary-rgb), 1);
}

body.theme-dark .filters-panel__badge{
  background: rgba(255,255,255,.06);
}

.filters-section{
  margin-bottom: 12px;
}

.filters-label{
  font-size: .78rem;
  font-weight: 600;
  color: var(--pc-muted);
  text-transform: uppercase;
  letter-spacing: .04em;
  margin-bottom: 8px;
  display:block;
}

.filters-input-icon{
  position: relative;
}

.filters-input-icon i{
  position:absolute;
  left:14px;
  top:50%;
  transform:translateY(-50%);
  color: var(--pc-muted);
  pointer-events:none;
}

.filters-control{
  min-height: 46px;
  border-radius: 14px;
  border: 1px solid var(--pc-border);
  background: rgba(255,255,255,.82);
  color: inherit;
  font-weight: 700;
  box-shadow: none;
}

.filters-control-lg{
  padding-left: 40px !important;
}

.filters-control:focus{
  border-color: rgba(var(--bs-primary-rgb), .35);
  box-shadow: 0 0 0 .2rem rgba(var(--bs-primary-rgb), .10);
  background: rgba(255,255,255,.95);
}

body.theme-dark .filters-control{
  background: rgba(255,255,255,.06);
  color: rgba(255,255,255,.88);
}

body.theme-dark .filters-control:focus{
  background: rgba(255,255,255,.08);
}

.filters-year-box{
  border-radius: 16px;
  border: 1px solid var(--pc-border);
  background: rgba(255,255,255,.58);
  padding: 14px 12px 8px;
}

body.theme-dark .filters-year-box{
  background: rgba(255,255,255,.04);
}

.filters-year-badge{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width: 64px;
  padding: 5px 10px;
  border-radius: 999px;
  border: 1px solid var(--pc-border);
  background: rgba(255,255,255,.75);
  font-size: .76rem;
  font-weight: 600;
}

body.theme-dark .filters-year-badge{
  background: rgba(255,255,255,.06);
}

.filters-year-range{
  display:flex;
  justify-content:space-between;
  gap:12px;
  margin-top: 8px;
  font-size: .78rem;
  color: var(--pc-muted);
  font-weight: 550;
}

.filters-switch-box{
  margin-top: 8px;
  margin-bottom: 14px;
  border-radius: 16px;
  border: 1px solid var(--pc-border);
  background: rgba(255,255,255,.58);
  padding: 12px 14px;
}

body.theme-dark .filters-switch-box{
  background: rgba(255,255,255,.04);
}

.filters-actions{
  display:grid;
  gap:10px;
}

.filters-actions .btn{
  min-height: 46px;
  border-radius: 14px;
  font-weight: 600;
}

.filters-meta{
  margin-top: 14px;
  text-align:center;
  font-size: .8rem;
  color: var(--pc-muted);
  font-weight: 550;
}

@media (max-width: 991.98px){
  .filters-panel{
    position: static;
    top: auto;
  }
  
}
.empty-results-box{
  width: 100%;
  text-align: center;
  padding: 48px 24px;
  border-radius: 24px;
  border: 1px solid var(--pc-border);
  box-shadow: var(--pc-shadow);
  background:
    radial-gradient(700px circle at 10% 10%, rgba(var(--bs-primary-rgb), .10), transparent 40%),
    radial-gradient(700px circle at 90% 20%, rgba(var(--bs-secondary-rgb), .08), transparent 35%),
    rgba(255,255,255,.82);
  backdrop-filter: blur(8px);
}

body.theme-dark .empty-results-box{
  background:
    radial-gradient(700px circle at 10% 10%, rgba(13,110,253,.14), transparent 40%),
    radial-gradient(700px circle at 90% 20%, rgba(25,135,84,.10), transparent 35%),
    rgba(18,18,22,.70);
}

.empty-results-icon{
  width: 74px;
  height: 74px;
  margin: 0 auto 18px;
  border-radius: 22px;
  display: grid;
  place-items: center;
  background: rgba(var(--bs-primary-rgb), .10);
  color: var(--bs-primary);
  font-size: 1.8rem;
}

.empty-results-title{
  margin-bottom: 10px;
  font-weight: 650;
}

.empty-results-text{
  margin-bottom: 10px;
  color: var(--pc-muted);
  font-weight: 700;
}

.empty-results-subtext{
  margin-bottom: 22px;
  color: var(--pc-muted);
}

.empty-results-actions{
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

.empty-results-btn{
  min-height: 48px;
  padding: 10px 18px;
  border-radius: 999px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  border: 1px solid transparent;
  transition: transform .08s ease, filter .12s ease;
}

.empty-results-btn:hover{
  transform: translateY(-1px);
  filter: brightness(.98);
}

.empty-results-btn--phone{
  background: rgba(var(--bs-primary-rgb), .10);
  color: var(--bs-primary);
  border-color: rgba(var(--bs-primary-rgb), .18);
}

.empty-results-btn--whatsapp{
  background: rgba(37,211,102,.10);
  color: #1ea952;
  border-color: rgba(37,211,102,.20);
}

.articles-infinite-loader{
  grid-column: 1 / -1;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 14px;
  padding: 12px;
  color: var(--bs-primary);
  font-weight: 600;
  font-size: .9rem;
}

.articles-infinite-loader:not(.d-none){
  display: flex;
}

.articles-scroll-sentinel{
  height: 1px;
}

@media (max-width: 575.98px){
  .empty-results-actions{
    flex-direction: column;
  }

  .empty-results-btn{
    width: 100%;
    justify-content: center;
  }
}
  </style>

  <div class="container-fluid py-4 catalog-page"
       data-initial='{{ initial|json_encode(constant("JSON_UNESCAPED_UNICODE"))|e("html_attr") }}'>

    <div class="row g-3 catalog-layout">
      <div class="col-12 catalog-filters-area">
  <details class="filters-panel" data-catalog-filters open>
    <summary class="filters-panel__head">
      <span class="filters-panel__label">
        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
        <span class="filters-panel__title">Filtres produits</span>
      </span>
      <span class="filters-meta" id="resultMeta" aria-live="polite"></span>
      <span class="filters-panel__tools">
        <a class="filters-arrivals" id="catalogNewArrivals" href="{{ path('articles_page', { new: 1, newDays: 90 }) }}">Arrivages récents</a>
        <button class="filters-reset" id="resetFilters" type="button" title="Réinitialiser les filtres" aria-label="Réinitialiser les filtres">
          <i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span>Reset</span>
        </button>
      </span>
      <span class="filters-panel__badge">
        <i class="fa-solid fa-chevron-down filters-panel__chevron" aria-hidden="true"></i>
      </span>
    </summary>

    <div class="filters-panel__content">
    <div class="filters-section filters-section--keyword">
      <label class="filters-label" for="f_q">Mot-clé</label>
      <div class="filters-input-icon">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input class="form-control filters-control filters-control-lg" id="f_q" placeholder="Mot-clé / référence...">
      </div>
    </div>

    <div class="filters-section">
      <label class="filters-label" for="f_family">Famille</label>
      <select class="form-select filters-control" id="f_family">
        <option value="">Toutes</option>
      </select>
    </div>

    <div class="filters-section">
      <label class="filters-label" for="f_brand">Marque</label>
      <select class="form-select filters-control" id="f_brand">
        <option value="">Toutes</option>
      </select>
    </div>

    <div class="filters-section">
      <label class="filters-label" for="f_vehicle">Véhicule</label>
      <select class="form-select filters-control" id="f_vehicle">
        <option value="">Tous</option>
      </select>
    </div>

    <div class="filters-section filters-section--year">
      <label class="filters-label d-flex align-items-center justify-content-between">
        <span>Année</span>
        <span class="filters-year-badge" id="anneeBadge">—</span>
      </label>

      <div class="filters-year-box">
        <div id="yearSlider"></div>
      </div>

      <input type="hidden" id="f_yearFrom" value="1976">
      <input type="hidden" id="f_yearTo" value="2030">

      <div class="filters-year-range">
        <span id="yearMinLabel">—</span>
        <span id="yearMaxLabel">—</span>
      </div>
    </div>

    <div class="filters-switch-box">
      <div class="form-check form-switch m-0">
        <input class="form-check-input" type="checkbox" id="f_inStock">
        <label class="form-check-label small fw-bold" for="f_inStock">
          En stock uniquement
        </label>
      </div>
    </div>

    </div>
  </details>
</div>

      <div class="col-12 catalog-results-area">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
          <div class="small text-muted" id="statusLine" role="status" aria-live="polite">—</div>

          <div class="d-flex gap-2 align-items-center flex-wrap">
            <div class="d-flex align-items-center gap-2">
              <span class="small text-muted">Articles / page :</span>
              <select class="form-select form-select-sm" id="limitSelect" style="width:auto;">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="24" selected>24</option>
                <option value="40">40</option>
                <option value="60">60</option>
              </select>
            </div>

            <button class="btn btn-outline-secondary btn-sm" id="prevBtn" disabled>←</button>
            <span class="small" id="pageLabel">1</span>
            <button class="btn btn-outline-secondary btn-sm" id="nextBtn" disabled>→</button>
          </div>
        </div>

        <div id="grid" class="product-grid"></div>
        <div class="alert alert-danger mt-3 d-none" id="apiError"></div>

        <div class="articles-infinite-loader d-none" id="infiniteLoader" aria-live="polite">
          <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
          <span>Chargement des articles...</span>
        </div>
        <div id="infiniteScrollSentinel" class="articles-scroll-sentinel" aria-hidden="true"></div>

        <div class="d-flex align-items-center justify-content-end flex-wrap gap-2 mt-3">
          <button class="btn btn-outline-secondary btn-sm" id="prevBtnBottom" disabled>←</button>
          <span class="small" id="pageLabelBottom">1</span>
          <button class="btn btn-outline-secondary btn-sm" id="nextBtnBottom" disabled>→</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      const wrap = document.querySelector('[data-initial]');
      const initial = safeJsonParse(wrap?.getAttribute('data-initial') || '{}', {});

      const f_q = document.getElementById('f_q');
      const f_family = document.getElementById('f_family');
      const f_brand = document.getElementById('f_brand');
      const f_vehicle = document.getElementById('f_vehicle');

      const f_yearFrom = document.getElementById('f_yearFrom');
      const f_yearTo = document.getElementById('f_yearTo');

      const anneeBadge = document.getElementById('anneeBadge');
      const yearRangeBar = document.getElementById('yearRangeBar');
      const yearMinLabel = document.getElementById('yearMinLabel');
      const yearMaxLabel = document.getElementById('yearMaxLabel');

      const yearSliderEl = document.getElementById('yearSlider');
      let yearSlider = null;
      let sliderYearMin = null;
      let sliderYearMax = null;

      const f_inStock = document.getElementById('f_inStock');

      const resetBtn = document.getElementById('resetFilters');
      const newArrivalsLink = document.getElementById('catalogNewArrivals');
      const grid = document.getElementById('grid');
      const infiniteLoader = document.getElementById('infiniteLoader');
      const infiniteScrollSentinel = document.getElementById('infiniteScrollSentinel');

      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const pageLabel = document.getElementById('pageLabel');

      const prevBtnBottom = document.getElementById('prevBtnBottom');
      const nextBtnBottom = document.getElementById('nextBtnBottom');
      const pageLabelBottom = document.getElementById('pageLabelBottom');

      const limitSelect = document.getElementById('limitSelect');

      const statusLine = document.getElementById('statusLine');
      const resultMeta = document.getElementById('resultMeta');
      const apiError = document.getElementById('apiError');
      const headerSearchInput = document.getElementById('InputRechercheProduit');
      const headerSearchForm = document.getElementById('searchFormHeader');
      const canSeeExactStock = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};

      const FALLBACK_IMG = "{{ asset('img/default-piece.png')|e('js') }}";
      const NEW_BADGE_IMG = "{{ asset('img/new.png')|e('js') }}";
      const brandBadge = window.ProductBrandLogos.badge;

      const DEFAULT_YEAR_MIN = 1976;
      let dataYearMin = DEFAULT_YEAR_MIN;
      let dataYearMax = 2030;
      let yearBoundsInitialized = false;

      let facetsLoaded = false;
      let articleLoadController = null;
      let articleLoadSerial = 0;
      let keywordTimer = null;
      let totalPages = 1;
      let isLoadingArticles = false;
      let infiniteObserver = null;

      let state = {
        page: 1,
        limit: 24,
        q: initial.q || '',
        family: initial.family || '',
        brand: initial.brand || '',
        vehicle: initial.vehicle || '',
        inStock: initial.inStock || '',
        onlyNew: (initial.new === '1'),
        newDays: initial.newDays || 5,
      };

      function safeJsonParse(s, fallback){
        try { return JSON.parse(s); } catch(e){ return fallback; }
      }

      function esc(s){
        return String(s ?? '').replace(/[&<>"']/g, m => ({
          '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
        }[m]));
      }

      function money(v){
        const n = Number(String(v).replace(',', '.'));
        if (!isFinite(n)) return esc(v);
        return n.toFixed(2);
      }

      function truncate(s, max){
        s = String(s ?? '').trim();
        return (s.length <= max) ? s : (s.slice(0, max) + '…');
      }

      function normalizeCartObj(obj){
        if (!obj || typeof obj !== 'object') return {};
        const out = {};
        for (const [k, v] of Object.entries(obj)){
          if (!k) continue;
          if (typeof v === 'number') out[k] = Math.max(0, Math.floor(v));
          else if (v && typeof v === 'object' && v.qty != null) out[k] = { ...v, qty: Math.max(0, Math.floor(Number(v.qty) || 0)) };
          else out[k] = Math.max(0, Math.floor(Number(v) || 0));
        }
        return out;
      }

      function getCart(){
        const raw = safeJsonParse(localStorage.getItem('cart') || '{}', {});
        return normalizeCartObj(raw);
      }

      function getCartQtyFromObj(obj, code){
        const v = obj?.[code];
        if (v == null) return 0;
        if (typeof v === 'number') return v;
        if (typeof v === 'object' && v.qty != null) return Number(v.qty) || 0;
        return Number(v) || 0;
      }

      function setCartQtyInObj(obj, code, nextQty){
        const v = obj?.[code];
        if (v && typeof v === 'object') obj[code].qty = nextQty;
        else obj[code] = nextQty;
      }

      let _cartWriteGuard = false;

      function emitCartEvent(name){
        window.dispatchEvent(new CustomEvent(name));
      }

      function writeCart(obj, {emit=true, refreshHeader=true, eventName='cart:changed'} = {}){
        if (_cartWriteGuard) return;
        _cartWriteGuard = true;
        try{
          const normalized = normalizeCartObj(obj);
          localStorage.setItem('cart', JSON.stringify(normalized));
        } catch(e){}
        _cartWriteGuard = false;

        if (emit) emitCartEvent(eventName);

        if (refreshHeader && typeof window.refreshHeaderCounts === 'function'){
          try { window.refreshHeaderCounts(); } catch(e){}
        }
      }

      function clearLocalCart({emit=true, refreshHeader=true} = {}){
        writeCart({}, {emit, refreshHeader, eventName:'cart:cleared'});
        if (emit) emitCartEvent('cart:changed');
      }

      function refreshGridCartBadges(){
        if (!grid) return;
        const cart = getCart();

        grid.querySelectorAll('.product-card').forEach(card => {
          const code = card.dataset.code || '';
          if (!code) return;

          const qty = getCartQtyFromObj(cart, code);
          const badge = card.querySelector('[data-cart-qty]');
          if (badge) badge.textContent = String(qty);

          const stock = parseInt(card.dataset.stock || '0', 10) || 0;
          const available = Math.max(0, stock - qty);
          const stockBadge = card.querySelector('[data-stock-badge]');
          if (stockBadge) stockBadge.textContent = stockLabel(available);

          const stockBox = card.querySelector('.wishlist-button');
          if (stockBox) stockBox.setAttribute('style', stockStyle(available));

          if (typeof card._updateUI === 'function'){
            try { card._updateUI(); } catch(e){}
          }
        });
      }

      window.addEventListener('cart:cleared', () => {
        refreshGridCartBadges();
      });
      window.addEventListener('cart:changed', () => {
        refreshGridCartBadges();
      });

      window.addEventListener('storage', (e) => {
        if (!e || !e.key || e.key === 'cart'){
          refreshGridCartBadges();
        }
      });

      let _syncingFromServer = false;

      async function syncCartFromServer({emit=true} = {}){
        if (_syncingFromServer) return;
        _syncingFromServer = true;
        try{
          const res = await fetch('/api/cart', { headers: { 'Accept':'application/json' } });
          if (res.status === 401){ _syncingFromServer = false; return; }
          const data = await res.json().catch(()=> ({}));
          if (!res.ok || !data || !data.ok){
            _syncingFromServer = false;
            return;
          }

          const serverObj = {};
          const items = data.items || [];
          items.forEach(it => {
            const code = it.code ?? it.id ?? it.Id ?? it.ID ?? it.ref ?? '';
            const qty = Number(it.qty ?? it.quantity ?? 0) || 0;
            if (code) serverObj[String(code)] = Math.max(0, Math.floor(qty));
          });

          const localObj = getCart();
          const a = JSON.stringify(normalizeCartObj(localObj));
          const b = JSON.stringify(normalizeCartObj(serverObj));

          if (a !== b){
            if (Object.keys(serverObj).length === 0) {
              writeCart({}, {emit, refreshHeader:false, eventName:'cart:cleared'});
              if (emit) emitCartEvent('cart:changed');
            } else {
              writeCart(serverObj, {emit, refreshHeader:false, eventName:'cart:changed'});
            }
          } else {
            if (emit) emitCartEvent('cart:changed');
          }
        } catch(e){
        } finally {
          _syncingFromServer = false;
        }
      }

      (function wrapHeaderRefresh(){
        if (typeof window.refreshHeaderCounts !== 'function') return;
        if (window._hopicWrappedRefreshHeaderCounts) return;

        const orig = window.refreshHeaderCounts;
        window.refreshHeaderCounts = async function(...args){
          const r = await orig.apply(this, args);
          await syncCartFromServer({emit:true});
          return r;
        };
        window._hopicWrappedRefreshHeaderCounts = true;
      })();

      (function bindOffcanvasSync(){
        const oc = document.getElementById('cartOffcanvas');
        if (!oc) return;
        oc.addEventListener('hidden.bs.offcanvas', () => {
          syncCartFromServer({emit:true});
        });
      })();

      const limitFromQuery = parseInt(new URLSearchParams(window.location.search).get('limit') || '', 10);
      if (isFinite(limitFromQuery) && limitFromQuery > 0) state.limit = limitFromQuery;

      if (limitSelect) {
        const has = Array.from(limitSelect.options).some(o => Number(o.value) === Number(state.limit));
        if (!has) state.limit = 24;
        limitSelect.value = String(state.limit);

        limitSelect.addEventListener('change', () => {
          const v = parseInt(limitSelect.value || '24', 10);
          state.limit = (isFinite(v) && v > 0) ? v : 24;
          state.page = 1;
          syncUrlToBrowser();
          load();
        });
      }

      if (f_q) f_q.value = state.q;
      if (f_inStock) f_inStock.checked = (state.inStock === '1');

      function skeletons(){
        if (!grid) return;
        grid.innerHTML = '';
        for (let i=0; i<8; i++){
          const d = document.createElement('div');
          d.className = 'skeleton';
          grid.appendChild(d);
        }
      }

      function setInfiniteLoader(visible){
        infiniteLoader?.classList.toggle('d-none', !visible);
      }

      function countVisibleCards(){
        return grid ? grid.querySelectorAll('.product-card').length : 0;
      }

      function canLoadMoreArticles(){
        return !isLoadingArticles && state.page < totalPages;
      }

      function loadNextArticlesPage(){
        if (!canLoadMoreArticles()) return;
        state.page++;
        load({ append: true });
      }

      function maybeLoadMoreIfNeeded(){
        if (!infiniteScrollSentinel || !canLoadMoreArticles()) return;

        const rect = infiniteScrollSentinel.getBoundingClientRect();
        if (rect.top <= window.innerHeight + 520) {
          loadNextArticlesPage();
        }
      }

      function setupInfiniteScroll(){
        if (!infiniteScrollSentinel) return;

        if ('IntersectionObserver' in window) {
          infiniteObserver?.disconnect();
          infiniteObserver = new IntersectionObserver((entries) => {
            if (entries.some(entry => entry.isIntersecting)) {
              loadNextArticlesPage();
            }
          }, { root: null, rootMargin: '520px 0px', threshold: 0 });

          infiniteObserver.observe(infiniteScrollSentinel);
          return;
        }

        window.addEventListener('scroll', () => {
          const nearBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 520;
          if (nearBottom) loadNextArticlesPage();
        }, { passive: true });
      }

      function clampYears(from, to){
        from = Math.max(dataYearMin, Math.min(dataYearMax, from));
        to   = Math.max(dataYearMin, Math.min(dataYearMax, to));
        if (from > to) { const t = from; from = to; to = t; }
        return { from, to };
      }

      function updateYearUI(from, to){
        if (yearMinLabel) yearMinLabel.textContent = String(dataYearMin);
        if (yearMaxLabel) yearMaxLabel.textContent = String(dataYearMax);

        if (anneeBadge){
          if (from === dataYearMin && to === dataYearMax) anneeBadge.textContent = 'Tout';
          else if (from === to) anneeBadge.textContent = String(from);
          else anneeBadge.textContent = `${from} → ${to}`;
        }

        const range = (dataYearMax - dataYearMin) || 1;
        const leftPct = ((from - dataYearMin) / range) * 100;
        const rightPct = ((to - dataYearMin) / range) * 100;

        if (yearRangeBar){
          yearRangeBar.style.marginLeft = leftPct + '%';
          yearRangeBar.style.width = Math.max(0, rightPct - leftPct) + '%';
        }
      }

      function setYearValues(from, to, syncSlider=true){
        const c = clampYears(parseInt(from, 10), parseInt(to, 10));
        if (f_yearFrom) f_yearFrom.value = String(c.from);
        if (f_yearTo)   f_yearTo.value   = String(c.to);
        updateYearUI(c.from, c.to);

        if (syncSlider && yearSlider){
          const current = yearSlider.get();
          if (Number(current[0]) !== c.from || Number(current[1]) !== c.to) {
            yearSlider.set([c.from, c.to]);
          }
        }
      }

      function ensureYearSlider(){
        if (!yearSliderEl || yearSlider) return;
        if (typeof noUiSlider === 'undefined') return;

        noUiSlider.create(yearSliderEl, {
          start: [dataYearMin, dataYearMax],
          connect: true,
          step: 1,
          range: { min: dataYearMin, max: dataYearMax },
          format: { to: v => String(Math.round(v)), from: v => Number(v) }
        });

        yearSlider = yearSliderEl.noUiSlider;
        sliderYearMin = dataYearMin;
        sliderYearMax = dataYearMax;
        yearSliderEl.querySelectorAll('.noUi-handle').forEach((handle, index) => {
          handle.setAttribute('aria-label', index === 0 ? 'Année minimum' : 'Année maximum');
        });

        yearSlider.on('update', (values) => {
          const from = parseInt(values[0], 10);
          const to   = parseInt(values[1], 10);
          if (f_yearFrom) f_yearFrom.value = String(from);
          if (f_yearTo)   f_yearTo.value   = String(to);
          updateYearUI(from, to);
        });
        // A committed drag, tap or keyboard change filters once; API/reset .set() does not.
        yearSlider.on('change', () => applyFilters());
      }

      function updateYearSliderOptions(){
        ensureYearSlider();
        if (!yearSlider) {
          setYearValues(f_yearFrom?.value || dataYearMin, f_yearTo?.value || dataYearMax, false);
          return;
        }

        if (sliderYearMin !== dataYearMin || sliderYearMax !== dataYearMax) {
          yearSlider.updateOptions({ range: { min: dataYearMin, max: dataYearMax } });
          sliderYearMin = dataYearMin;
          sliderYearMax = dataYearMax;
        }
        setYearValues(f_yearFrom?.value || dataYearMin, f_yearTo?.value || dataYearMax, true);
      }

      function initYearFromQuery(){
        let from = initial.anneeFrom ? parseInt(initial.anneeFrom, 10) : NaN;
        let to   = initial.anneeTo   ? parseInt(initial.anneeTo, 10)   : NaN;

        if ((!isFinite(from) || !isFinite(to)) && initial.annee){
          const y = parseInt(initial.annee, 10);
          if (isFinite(y)){ from = y; to = y; }
        }

        if (!isFinite(from)) from = dataYearMin;
        if (!isFinite(to))   to   = dataYearMax;

        setYearValues(from, to, true);
      }

      function buildUrl(){
        const url = new URL('/api/articles', window.location.origin);
        url.searchParams.set('page', String(state.page));
        url.searchParams.set('limit', String(state.limit));

        if (state.q) url.searchParams.set('q', state.q);
        if (state.family) url.searchParams.set('family', state.family);
        if (state.brand) url.searchParams.set('brand', state.brand);
        if (state.vehicle) url.searchParams.set('vehicle', state.vehicle);
        if (state.inStock === '1') url.searchParams.set('inStock', '1');

        const from = parseInt(f_yearFrom?.value || String(dataYearMin), 10);
        const to   = parseInt(f_yearTo?.value   || String(dataYearMax), 10);
        const isAll = (from === dataYearMin && to === dataYearMax);
        if (!isAll){
          url.searchParams.set('anneeFrom', String(from));
          url.searchParams.set('anneeTo', String(to));
        }

        if (state.onlyNew) {
          url.searchParams.set('new', '1');
          url.searchParams.set('newDays', String(state.newDays));
        }

        if (!facetsLoaded) url.searchParams.set('facets', '1');
        return url.toString();
      }

      function syncUrlToBrowser(){
        const url = new URL('{{ path("articles_page") }}', window.location.origin);

        if (state.q) url.searchParams.set('q', state.q);
        if (state.family) url.searchParams.set('family', state.family);
        if (state.brand) url.searchParams.set('brand', state.brand);
        if (state.vehicle) url.searchParams.set('vehicle', state.vehicle);
        if (state.inStock === '1') url.searchParams.set('inStock', '1');

        const from = parseInt(f_yearFrom?.value || String(dataYearMin), 10);
        const to   = parseInt(f_yearTo?.value   || String(dataYearMax), 10);
        const isAll = (from === dataYearMin && to === dataYearMax);
        if (!isAll){
          url.searchParams.set('anneeFrom', String(from));
          url.searchParams.set('anneeTo', String(to));
        }

        if (state.onlyNew) {
          url.searchParams.set('new', '1');
          url.searchParams.set('newDays', String(state.newDays));
        }

        if (state.limit && state.limit !== 24) url.searchParams.set('limit', String(state.limit));
        else url.searchParams.delete('limit');

        history.replaceState({}, '', url.toString());
        document.querySelectorAll('#mainMenuDesktop a.main-menu__link').forEach(link => {
          const target = new URL(link.href, location.origin);
          const active = target.pathname === url.pathname && (target.searchParams.get('family') || '') === state.family;
          link.classList.toggle('is-active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      }

      function stockStyle(stock){
        if (!canSeeExactStock) {
          return stock > 0
            ? `color: #fff !important; background: #198754 !important; border-color: #198754 !important;`
            : `color: #fff !important; background: #dc3545 !important; border-color: #dc3545 !important;`;
        }

        if (stock === 0) return `color: #fff !important; background: #dc3545 !important; border-color: #dc3545 !important;`;
        if (stock < 5)  return `color: var(--brand-anthracite) !important; background: var(--brand-orange) !important; border-color: var(--brand-orange) !important;`;
        return `color: #fff !important; background: #198754 !important; border-color: #198754 !important;`;
      }

      function stockLabel(stock){
        if (canSeeExactStock) {
          return stock > 20 ? '+20' : String(stock);
        }

        return stock > 0 ? 'En stock' : 'Non dispo';
      }

      function render(items, imagesBaseUrl, append = false){
        if (!grid) return;

        const cartObj = getCart();
        if (!append) {
          grid.innerHTML = '';
        }

        if (!append && (!items || !items.length)){
          grid.innerHTML = `
           <div style="grid-column: 1 / -1;">
  <div class="empty-results-box">
    <div class="empty-results-icon">
      <i class="fa-solid fa-box-open"></i>
    </div>

    <h4 class="empty-results-title">Aucun article trouvé</h4>

    <p class="empty-results-text">
      Nous n'avons pas trouvé d’articles correspondant à votre recherche.
    </p>

    <p class="empty-results-subtext">
      Besoin d’aide pour trouver la bonne pièce ? Notre équipe peut vous orienter rapidement.
    </p>

    <div class="empty-results-actions">
      <a class="empty-results-btn empty-results-btn--phone" href="tel:+212522713572">
        <i class="fa-solid fa-phone-volume"></i>
        <span>+212 522 71 35 72/77</span>
      </a>

      <a class="empty-results-btn empty-results-btn--whatsapp"
         href="https://wa.me/212613577138"
         target="_blank"
         rel="noopener">
        <i class="fa-brands fa-whatsapp"></i>
        <span>Contacter sur WhatsApp</span>
      </a>
    </div>
  </div>
</div>
          `;
          return;
        }

        if (append && (!items || !items.length)){
          return;
        }

        const base = (imagesBaseUrl || '').replace(/\/$/, '');

        items.forEach(a => {
          const uid = a.UniqueId;
          const code = a.Id;
          const desFull = a.DesComClear || '';
          const des = truncate(desFull, 58);
          const position = a.xx_Position || a.xxPosition || '';
          const family = a.FamilyName || '';
          const vehicle = a.xx_Vehicule || a.xxVehicule || '';
          const year = a.xx_Annee || a.xxAnnee || '';
const reduction = String(a.reduction ?? '').trim();
const hasReduction = reduction !== '' && !Number.isNaN(Number(reduction));

          const img = (base && uid) ? (base + '/' + uid + '.png') : FALLBACK_IMG;

          const stock = Math.max(0, Number(a.RealStock || 0));
          const inCartQty = getCartQtyFromObj(cartObj, code);
          const availableStock = Math.max(0, stock - inCartQty);
          const stockDisplay = stockLabel(availableStock);
          const isNew = !!a.isNew;

          const cartAlert = a.cartAlert || {};
          const showCartAlert = !!cartAlert.showBadge;
          const cartAlertText = cartAlert.message || '';
          const shortCartAlertText = cartAlert.totalReserved
            ? `Attention : ${cartAlert.totalReserved} article(s)`
            : 'Attention';

          const card = document.createElement('div');
          card.className = 'product-card';
          card.dataset.code = String(code || '');
          card.dataset.stock = String(stock);

          card.innerHTML = `
            <div class="product-card__image">
              ${hasReduction ? `<div class="badge-pill discount-badge" title="Remise">-${esc(reduction)}%</div>` : ''}

              ${isNew ? `<div class="badge-newimg" title="Nouveauté" aria-hidden="true">
                <img src="${NEW_BADGE_IMG}" alt="Nouveauté">
              </div>` : ''}
<a class="view-button"
   href="/articles/${encodeURIComponent(code)}"
   title="Voir le détail">
              <img class="product-img" src="${esc(img)}" alt="${esc(code)}"
                   onerror="this.onerror=null;this.src='${FALLBACK_IMG}'"></a>
            </div>

            <div class="product-card__info">
              <div class="meta-line">
                ${brandBadge(a.xx_Marque)}
                ${family ? `<span class="meta-chip meta-chip--family">${esc(truncate(family, 8))}</span>` : ''}
                <span class="wishlist-button" title="${availableStock > 0 ? 'Stock disponible' : 'Non disponible'}" style="${stockStyle(availableStock)}">
                  <span data-stock-badge>${esc(stockDisplay)}</span>
                </span>
              </div>

              <a href="/articles/${encodeURIComponent(code)}" class="designation" title="${esc(desFull)}">${esc(des)}</a>
              <div class="vehicle-line">${esc([vehicle, year].filter(Boolean).join(' · '))}</div>
            </div>

            <div class="product-card__footer">
              <div class="product-card__prices">
                <span class="price-ttc">${money(a.SalePriceVatIncluded)} DH</span>
                <span class="price-label">[TTC]</span>
              </div>

              ${showCartAlert ? `
                <div
                  class="alert alert-warning py-2 px-2 mt-2 mb-2 small"
                  data-cart-alert
                  data-bs-toggle="tooltip"
                  data-bs-placement="top"
                  data-bs-html="false"
                  data-bs-title="${esc(cartAlertText)}"
                  style="cursor: help;"
                >
                  <i class="fa-solid fa-triangle-exclamation me-1"></i>
                  ${esc(shortCartAlertText)}
                </div>
              ` : `<div class="d-none" data-cart-alert></div>`}

              <div class="catalog-info-list">
                <div class="catalog-info-row">
                  <span class="catalog-info-label">Reference</span>
                  <span class="catalog-info-value">${esc(code || uid || '-')}</span>
                </div>
                ${position ? `
                  <div class="catalog-info-row">
                    <span class="catalog-info-label">Position</span>
                    <span class="catalog-info-value">${esc(position)}</span>
                  </div>
                ` : ''}
                ${canSeeExactStock ? `
                  <div class="catalog-info-row">
                    <span class="catalog-info-label">Stock</span>
                    <span class="catalog-info-value">${esc(stockDisplay)}</span>
                  </div>
                ` : ''}
              </div>

              <div class="bottomFooterWrapper">
                <div class="qty-stepper" data-qty-stepper>
                  <button class="qty-btn" type="button" data-qty-minus aria-label="Diminuer">
                    <i class="fa-solid fa-minus"></i>
                  </button>

                  <input class="qty-field" type="text" inputmode="numeric" value="1" data-qty-input>

                  <button class="qty-btn" type="button" data-qty-plus aria-label="Augmenter">
                    <i class="fa-solid fa-plus"></i>
                  </button>
                </div>

                <button class="addcart" type="button" title="Ajouter au panier">
                  <i class="fa-solid fa-cart-plus"></i>
                  <span class="cart-count-btn" data-cart-qty>${esc(inCartQty)}</span>
                </button>
              </div>

              <div class="small text-danger mt-2 d-none" data-stock-msg></div>
            </div>
          `;

          card.querySelector('.copy-icon')?.addEventListener('click', async () => {
            try { await navigator.clipboard.writeText(String(code || '')); } catch {}
          });

          let cartQtyEl = card.querySelector('[data-cart-qty]');
          const qtyField  = card.querySelector('[data-qty-input]');
          const btnMinus  = card.querySelector('[data-qty-minus]');
          const btnPlus   = card.querySelector('[data-qty-plus]');
          const addBtn    = card.querySelector('.addcart');
          const msgEl     = card.querySelector('[data-stock-msg]');

          const showMsg = (text)=>{
            if (!msgEl) return;
            msgEl.textContent = text;
            msgEl.classList.remove('d-none');
            clearTimeout(msgEl._t);
            msgEl._t = setTimeout(()=> msgEl.classList.add('d-none'), 2200);
          };

          const getAvailNow = ()=>{
            const currentInCart = parseInt(cartQtyEl?.textContent || '0', 10) || 0;
            return Math.max(0, stock - currentInCart);
          };

          const sanitizeQty = ()=>{
            if (!qtyField) return 1;
            qtyField.value = (qtyField.value || '').replace(/\D+/g,'') || '1';
            let v = parseInt(qtyField.value, 10);
            if (!isFinite(v) || v < 1) v = 1;
            return v;
          };

          const setUI = ()=>{
            const max = getAvailNow();
            let v = sanitizeQty();

            if (max > 0) v = Math.min(v, max);
            if (qtyField) qtyField.value = String(v);

            const disabledAll = (max <= 0);

            if (qtyField) qtyField.disabled = disabledAll;
            if (addBtn) addBtn.disabled = disabledAll;

            if (btnMinus) btnMinus.disabled = disabledAll || v <= 1;
            if (btnPlus)  btnPlus.disabled  = disabledAll || v >= max;
          };

          card._updateUI = setUI;

          btnMinus?.addEventListener('click', ()=>{
            const cur = sanitizeQty();
            if (qtyField) qtyField.value = String(Math.max(1, cur - 1));
            setUI();
          });

          btnPlus?.addEventListener('click', ()=>{
            const cur = sanitizeQty();
            if (qtyField) qtyField.value = String(cur + 1);
            setUI();
          });

          qtyField?.addEventListener('input', ()=>{
            sanitizeQty();
            setUI();
          });

          addBtn?.addEventListener('click', async ()=>{
            setUI();
            const max = getAvailNow();

            if (max <= 0){
              showMsg('Stock indisponible.');
              return;
            }

            const qty = Math.max(1, sanitizeQty());
            if (qty > max){
              showMsg(`Stock dispo: ${max}`);
              if (qtyField) qtyField.value = String(max);
              setUI();
              return;
            }

            const oldHtml = addBtn.innerHTML;
            addBtn.disabled = true;
            addBtn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>`;

            try{
              const res = await fetch('/api/cart/add', {
                method: 'POST',
                headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
                body: JSON.stringify({ code, qty })
              });

              const data = await res.json().catch(() => ({}));

              if (res.status === 401){
                showMsg('Connectez-vous pour ajouter au panier.');
              } else if (res.ok && data.ok){
                const freshCart = getCart();
                const current = parseInt((cartQtyEl?.textContent || '0'), 10) || 0;
                const next = current + qty;

                setCartQtyInObj(freshCart, String(code), next);
                writeCart(freshCart, {emit:true, refreshHeader:true, eventName:'cart:changed'});

                if (qtyField) qtyField.value = '1';

                if (data.cartAlert?.showBadge) {
                  showMsg('Attention : plusieurs paniers demandent cet article.');
                }

                return;
              } else {
                showMsg(data?.message || 'Erreur ajout panier.');
              }
            } catch(e){
              showMsg('Erreur réseau.');
            } finally {
              addBtn.innerHTML = oldHtml;
              cartQtyEl = addBtn.querySelector('[data-cart-qty]');
              const latestCart = getCart();
              const visibleQty = getCartQtyFromObj(latestCart, code);
              if (cartQtyEl) cartQtyEl.textContent = String(visibleQty);
              addBtn.disabled = (getAvailNow() <= 0);
              setUI();
            }
          });

          setUI();
          grid.appendChild(card);
        });

        refreshGridCartBadges();
      }

      function fillSelect(selectEl, options, selectedValue){
        if (!selectEl) return;
        const keep0 = selectEl.options[0];
        selectEl.innerHTML = '';
        selectEl.appendChild(keep0);

        (options || []).forEach(v => {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = v;
          selectEl.appendChild(opt);
        });

        if (selectedValue) selectEl.value = selectedValue;
      }

      function initTooltips(scope = document){
        if (typeof bootstrap === 'undefined' || !scope) return;

        scope.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
          const existing = bootstrap.Tooltip.getInstance(el);
          if (existing) existing.dispose();

          new bootstrap.Tooltip(el);
        });
      }

      async function load(options = {}){
        const append = options.append === true;
        if (isLoadingArticles && append) return;

        const currentLoadSerial = ++articleLoadSerial;
        if (!append && articleLoadController) {
          articleLoadController.abort();
        }
        articleLoadController = new AbortController();
        isLoadingArticles = true;
        grid?.setAttribute('aria-busy', 'true');
        updateFilterMeta();
        let loadSucceeded = false;

        if (apiError) apiError.classList.add('d-none');
        if (append) {
          setInfiniteLoader(true);
        } else {
          skeletons();
          setInfiniteLoader(false);
        }
        if (!append && statusLine) statusLine.textContent = 'Chargement...';

        try{
          const res = await fetch(buildUrl(), {
            headers: { 'Accept': 'application/json' },
            signal: articleLoadController.signal
          });
          const text = await res.text();

          const data = safeJsonParse(text, {});
          if (currentLoadSerial !== articleLoadSerial) {
            return;
          }

          if (!res.ok || !data.ok){
            if (apiError){
              apiError.classList.remove('d-none');
              apiError.innerHTML = `<div class="fw-bold">Erreur API</div>
                <div class="small">Status: ${res.status}</div>
                <div class="small">Début: <code>${esc(text.slice(0, 280))}</code></div>`;
            }
            if (statusLine) statusLine.textContent = 'Erreur API';
            if (!append && grid) grid.innerHTML = '';
            if (prevBtn) prevBtn.disabled = true;
            if (nextBtn) nextBtn.disabled = true;
            if (prevBtnBottom) prevBtnBottom.disabled = true;
            if (nextBtnBottom) nextBtnBottom.disabled = true;
            return;
          }

          const yMin = parseInt(data.yearMin, 10);
          const yMax = parseInt(data.yearMax, 10);

          if (isFinite(yMin) && isFinite(yMax) && yMin <= yMax){
            const first = !yearBoundsInitialized;
            yearBoundsInitialized = true;

            dataYearMin = Math.min(yMin, DEFAULT_YEAR_MIN);
            dataYearMax = yMax;
            if (dataYearMax < dataYearMin) dataYearMax = dataYearMin;

            updateYearSliderOptions();
            if (first) initYearFromQuery();
            else setYearValues(f_yearFrom?.value || dataYearMin, f_yearTo?.value || dataYearMax, true);
          } else {
            updateYearSliderOptions();
            setYearValues(f_yearFrom?.value || dataYearMin, f_yearTo?.value || dataYearMax, true);
          }

          if (!facetsLoaded && data.facets){
            facetsLoaded = true;
            fillSelect(f_family, data.facets.families || [], state.family);
            fillSelect(f_brand, data.facets.brands || [], state.brand);
            fillSelect(f_vehicle, data.facets.vehicles || [], state.vehicle);
          }

          const total = data.total || 0;
          const pages = data.pages || 1;
          totalPages = Math.max(1, pages);

          if (pageLabel) pageLabel.textContent = `${state.page} / ${totalPages}`;
          if (prevBtn) prevBtn.disabled = state.page <= 1;
          if (nextBtn) nextBtn.disabled = state.page >= totalPages;

          if (pageLabelBottom) pageLabelBottom.textContent = `${state.page} / ${totalPages}`;
          if (prevBtnBottom) prevBtnBottom.disabled = state.page <= 1;
          if (nextBtnBottom) nextBtnBottom.disabled = state.page >= totalPages;

          if (statusLine) {
            const shown = append ? countVisibleCards() + (data.items || []).length : (data.items || []).length;
            statusLine.textContent = `${shown} / ${total} article(s)`;
          }

          updateFilterMeta();

          render(data.items || [], data.imagesBaseUrl || '', append);
          initTooltips(grid);
          loadSucceeded = true;
        } catch(e){
          if (e.name === 'AbortError') {
            return;
          }

          if (apiError){
            apiError.classList.remove('d-none');
            apiError.innerHTML = `<div class="fw-bold">Erreur JS</div><div class="small">${esc(e.message || e)}</div>`;
          }
          if (statusLine) statusLine.textContent = 'Erreur JS';
          if (!append && grid) grid.innerHTML = '';
          if (append && state.page > 1) state.page--;
        } finally {
          // An aborted older request must not unlock a newer filter request.
          if (currentLoadSerial === articleLoadSerial) {
            isLoadingArticles = false;
            grid?.setAttribute('aria-busy', 'false');
            setInfiniteLoader(false);
            if (loadSucceeded) {
              window.setTimeout(maybeLoadMoreIfNeeded, 120);
            }
          }
        }
      }

      ensureYearSlider();
      updateYearSliderOptions();
      initYearFromQuery();
      setupInfiniteScroll();

      if (f_family) f_family.value = state.family;
      if (f_brand)  f_brand.value = state.brand;
      if (f_vehicle)f_vehicle.value = state.vehicle;
      if (f_inStock) f_inStock.checked = state.inStock === '1';
      if (f_q) f_q.value = state.q;
      if (headerSearchInput && headerSearchInput.value !== state.q) {
        headerSearchInput.value = state.q;
      }

      function cleanKeywordQuery(query){
        return String(query || '').replace(/\s+/g, ' ').trim();
      }

      function syncKeywordInputs(rawQuery, sourceInput = null){
        const value = String(rawQuery || '');

        if (f_q && f_q !== sourceInput && f_q.value !== value) {
          f_q.value = value;
        }

        if (headerSearchInput && headerSearchInput !== sourceInput && headerSearchInput.value !== value) {
          headerSearchInput.value = value;
        }
      }

      function applyKeywordSearch(query, sourceInput = null){
        const rawQuery = String(query || '');
        const normalizedQuery = cleanKeywordQuery(rawQuery);
        const previousPage = state.page;

        state.page = 1;
        syncKeywordInputs(rawQuery, sourceInput);

        if (state.q === normalizedQuery && previousPage === 1) {
          syncUrlToBrowser();
          return;
        }

        state.q = normalizedQuery;
        syncUrlToBrowser();
        load();
      }

      function scheduleKeywordSearch(query, sourceInput = null){
        clearTimeout(keywordTimer);
        keywordTimer = setTimeout(() => {
          applyKeywordSearch(query, sourceInput);
        }, 300);
      }

      function updateFilterMeta(){
        const hasYears = Number(f_yearFrom?.value) !== dataYearMin || Number(f_yearTo?.value) !== dataYearMax;
        const count = [state.q, state.family, state.brand, state.vehicle, state.inStock === '1', state.onlyNew, hasYears].filter(Boolean).length;
        if (resultMeta) resultMeta.textContent = count ? `${count} filtre${count > 1 ? 's' : ''} actif${count > 1 ? 's' : ''}` : 'Tous les articles';
        newArrivalsLink?.classList.toggle('is-active', state.onlyNew);
      }

      function applyFilters(){
        clearTimeout(keywordTimer);
        state.page = 1;
        state.q = cleanKeywordQuery(f_q?.value || '');
        state.family = (f_family?.value || '').trim();
        state.brand = (f_brand?.value || '').trim();
        state.vehicle = (f_vehicle?.value || '').trim();
        state.inStock = f_inStock?.checked ? '1' : '';
        syncKeywordInputs(f_q?.value || '', f_q);
        syncUrlToBrowser();
        load();
      }

      [f_family, f_brand, f_vehicle, f_inStock].forEach(control => control?.addEventListener('change', applyFilters));

      resetBtn?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        clearTimeout(keywordTimer);
        state.page = 1;
        state.q = '';
        state.family = '';
        state.brand = '';
        state.vehicle = '';
        state.inStock = '';
        state.onlyNew = false;

        if (f_q) f_q.value = '';
        if (headerSearchInput) headerSearchInput.value = '';
        if (f_family) f_family.value = '';
        if (f_brand) f_brand.value = '';
        if (f_vehicle) f_vehicle.value = '';
        if (f_inStock) f_inStock.checked = false;

        setYearValues(dataYearMin, dataYearMax, true);

        syncUrlToBrowser();
        load();
      });

      newArrivalsLink?.addEventListener('click', event => event.stopPropagation());

      prevBtn?.addEventListener('click', () => { if (state.page > 1){ state.page--; load(); } });
      nextBtn?.addEventListener('click', () => { state.page++; load(); });

      prevBtnBottom?.addEventListener('click', () => { if (state.page > 1){ state.page--; load(); } });
      nextBtnBottom?.addEventListener('click', () => { state.page++; load(); });

      f_q?.addEventListener('input', () => {
        scheduleKeywordSearch(f_q.value, f_q);
      });

      headerSearchInput?.addEventListener('input', () => {
        scheduleKeywordSearch(headerSearchInput.value, headerSearchInput);
      });

      headerSearchForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        clearTimeout(keywordTimer);
        applyKeywordSearch(headerSearchInput?.value || '', headerSearchInput);
      });

      syncUrlToBrowser();

      syncCartFromServer({emit:true}).finally(() => {
        load();
      });
    })();
  </script>
{% endblock %}
