  <script>
    (() => {
      const introSection = document.querySelector('.public-intro-v2');
      const parallaxEnabled = window.matchMedia('(min-width: 768px) and (prefers-reduced-motion: no-preference)');

      if (!introSection || !parallaxEnabled.matches) return;

      let animationFrame = null;

      const updateIntroParallax = () => {
        const bounds = introSection.getBoundingClientRect();
        const sectionCenter = bounds.top + (bounds.height / 2);
        const viewportCenter = window.innerHeight / 2;
        const offset = Math.max(-28, Math.min(28, (viewportCenter - sectionCenter) * .08));

        introSection.style.setProperty('--intro-parallax-y', `${offset}px`);
        animationFrame = null;
      };

      const requestIntroParallaxUpdate = () => {
        if (animationFrame !== null) return;
        animationFrame = window.requestAnimationFrame(updateIntroParallax);
      };

      window.addEventListener('scroll', requestIntroParallaxUpdate, { passive: true });
      window.addEventListener('resize', requestIntroParallaxUpdate, { passive: true });
      updateIntroParallax();
    })();

    (() => {
      const form = document.querySelector('[data-contact-form]');
      if (!form) return;

      const submitButton = form.querySelector('[data-contact-submit]');
      const submitLabel = form.querySelector('[data-contact-submit-label]');
      const statusBox = form.querySelector('[data-contact-status]');
      const defaultLabel = submitLabel ? submitLabel.textContent : '';

      const showStatus = (message, type) => {
        if (!statusBox) return;
        statusBox.textContent = message;
        statusBox.className = `contact-form-status is-visible ${type === 'success' ? 'is-success' : 'is-error'}`;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!form.reportValidity()) return;

        if (statusBox) {
          statusBox.textContent = '';
          statusBox.className = 'contact-form-status';
        }

        if (submitButton) submitButton.disabled = true;
        if (submitLabel) submitLabel.textContent = 'Envoi en cours...';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            }
          });

          const data = await response.json().catch(() => ({}));
          const message = data.message || 'Une erreur est survenue pendant l’envoi.';

          if (!response.ok || !data.ok) {
            throw new Error(message);
          }

          form.reset();
          showStatus(message, 'success');
        } catch (error) {
          showStatus(error.message || 'Le message n’a pas pu être envoyé.', 'error');
        } finally {
          if (submitButton) submitButton.disabled = false;
          if (submitLabel) submitLabel.textContent = defaultLabel;
        }
      });
    })();
  </script>

