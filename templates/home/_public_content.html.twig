<style>
  .public-home {
    --public-blue: #315fbb;
    --public-blue-dark: #102e63;
    --public-navy: #05070d;
    --public-navy-2: #0d1931;
    --public-orange: #ff9100;
    --public-ink: #101828;
    --public-muted: #667085;
    --public-border: rgba(16,24,40,.10);
    --public-soft: #f4f6fb;
    --public-panel: #fff;
    --public-shadow: 0 22px 58px rgba(5,9,18,.16);
    --public-shadow-soft: 0 12px 28px rgba(5,9,18,.10);
    background: #fff;
    color: var(--public-ink);
    font-family: 'Roboto', sans-serif;
