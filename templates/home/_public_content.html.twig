  <div class="public-cookie-banner" id="publicCookieBanner" role="region" aria-label="Gestion des cookies">
    <p class="public-cookie-text">
      Nous utilisons les cookies pour vous offrir une meilleure expérience utilisateur et mesurer l'utilisation du site.
      En savoir plus dans notre politique de confidentialité.
    </p>
    <div class="public-cookie-actions">
      <button type="button" class="public-cookie-btn is-decline" data-cookie-choice="declined">Refuser</button>
      <button type="button" class="public-cookie-btn is-accept" data-cookie-choice="accepted">Autoriser</button>
    </div>
  </div>

  <script>
    (function () {
      const banner = document.getElementById('publicCookieBanner');
      if (!banner) return;

      const storageKey = '3sk_cookie_consent';
      let savedChoice = null;

      try {
        savedChoice = window.localStorage.getItem(storageKey);
      } catch (error) {
        savedChoice = 'unavailable';
      }

      if (!savedChoice) {
        window.setTimeout(function () {
          banner.classList.add('is-visible');
        }, 500);
      }

      banner.addEventListener('click', function (event) {
        const target = event.target instanceof Element ? event.target : event.target.parentElement;
        const button = target ? target.closest('[data-cookie-choice]') : null;
        if (!button) return;

        try {
          window.localStorage.setItem(storageKey, button.dataset.cookieChoice || 'accepted');
        } catch (error) {}

        banner.classList.remove('is-visible');
      });
    })();
  </script>
