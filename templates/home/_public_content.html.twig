    height: 100%;
    object-fit: cover;
    min-height: 320px;
  }

  .public-highlight-panel .btn-light:hover {
    background: var(--public-orange);
    border-color: var(--public-orange);
    color: #fff !important;
  }

  #marques {
    background: var(--public-soft);
    border-bottom: 1px solid rgba(16,24,40,.08);
  }

  .public-logo-strip > div {
    background: #fff;
    border: 1px solid rgba(16,24,40,.08);
    border-radius: 8px;
    min-height: 126px;
    display: grid;
    place-items: center;
    box-shadow: 0 10px 28px rgba(16,24,40,.06);
  }

  .public-logo-strip img {
    max-height: 96px;
    width: auto;
    object-fit: contain;
    filter: grayscale(0%);
    opacity: 1;
    transition: filter .15s ease, opacity .15s ease, transform .15s ease;
  }

  .public-logo-strip > div:hover img {
    filter: grayscale(100%);
    opacity: .78;
    transform: translateY(-2px);
  }

  #contact {
    background:
      linear-gradient(135deg, rgba(49,95,187,.22), transparent 45%),
      var(--public-navy-2) !important;
    border-top: 0 !important;
    color: #fff;
  }

  #contact .text-dark {
    color: var(--public-ink) !important;
  }

  #contact .text-body-secondary {
    color: var(--public-muted) !important;
  }

  .public-contact-card {
    box-shadow: var(--public-shadow);
  }

  .public-contact-card img,
  .public-contact-card iframe {
    border-radius: 0;
  }

  .public-contact-card iframe {
    width: 100% !important;
    min-height: 300px;
    border: 0 !important;
    margin-top: auto;
  }

  .public-footer {
    margin-top: 0;
    border-top: 3px solid var(--public-orange);
    background: var(--public-navy);
    color: rgba(255,255,255,.92);
  }

  .public-footer a {
    color: rgba(255,255,255,.82);
    text-decoration: none;
  }

  .public-footer a:hover {
    color: #fff;
    text-decoration: none;
  }

  .public-footer-muted {
    color: rgba(255,255,255,.68);
  }

  .public-footer-pill {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .55rem .9rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.18);
    background: rgba(255,255,255,.08);
    color: rgba(255,255,255,.92) !important;
    font-weight: 900;
    text-decoration: none;
  }

  .public-footer-pill:hover {
    background: var(--public-orange);
    border-color: var(--public-orange);
  }

  .public-footer-social a {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,.16);
    display: grid;
    place-items: center;
    text-decoration: none;
    color: rgba(255,255,255,.9);
    background: rgba(255,255,255,.08);
  }

  .public-footer-social a:hover {
    transform: translateY(-1px);
    background: var(--public-orange);
    border-color: var(--public-orange);
  }

  @media (max-width: 991px) {
    .public-hero-panel {
      margin-top: 0;
      padding-top: 1.5rem;
    }

    .public-slider-shell {
      padding-bottom: 2rem;
    }

    .public-section {
      padding: 4rem 0;
    }

    .public-navbar .nav-link::after {
      display: none;
    }

    .public-service-card img,
    .public-news-card img {
      height: 220px;
    }
  }

  @media (max-width: 575px) {
    .public-topbar {
      font-size: .82rem;
    }

    .public-navbar .navbar-brand img {
      height: 48px;
    }

    .public-display {
      font-size: 2rem;
    }

    .public-overlay-card > div,
    .public-contact-card .card-body {
      padding: 1.25rem !important;
    }

    .public-logo-strip > div {
      min-height: 112px;
    }
  }
</style>

