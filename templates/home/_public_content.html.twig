  .public-home .h2,
  .public-home .h3,
  .public-home .h4,
  .public-home .h5,
  .public-home .h6,
  .public-home .navbar,
  .public-home .btn,
  .public-home .badge,
  .public-home .public-kicker,
  .public-home .public-footer-pill {
    font-family: 'Montserrat', sans-serif;
    letter-spacing: 0;
  }

  .public-home a {
    transition: color .15s ease, background .15s ease, border-color .15s ease, transform .15s ease;
  }

  .public-home .btn {
    border-radius: 8px !important;
    padding-block: .68rem;
  }

  .public-topbar {
    position: relative;
    overflow: hidden;
    background: var(--public-navy);
    border-bottom: 1px solid rgba(255,145,0,.62);
    color: rgba(255,255,255,.84);
    font-size: .86rem;
  }

  .public-topbar::before {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    width: min(42vw, 440px);
    background: linear-gradient(90deg, rgba(255,145,0,0), rgba(255,145,0,.82));
    clip-path: polygon(16% 0, 100% 0, 100% 100%, 0 100%);
  }

  .public-topbar .container {
    position: relative;
    z-index: 1;
  }

  .public-topbar a {
    color: rgba(255,255,255,.9);
    text-decoration: none;
    font-weight: 800;
  }

  .public-topbar a:hover {
    color: #fff;
  }

  .public-navbar {
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: rgba(7,11,20,.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 18px 42px rgba(0,0,0,.24);
  }

  .public-navbar .navbar-brand {
    background: #fff;
    border-radius: 8px;
    padding: .35rem .75rem;
    box-shadow: 0 10px 26px rgba(0,0,0,.18);
  }

  .public-navbar .navbar-brand img {
    height: 52px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .public-navbar .nav-link {
    color: rgba(255,255,255,.78);
    font-weight: 800;
    position: relative;
    padding-inline: .28rem;
  }

  .public-navbar .nav-link::after {
    content: "";
    position: absolute;
    left: .2rem;
    right: .2rem;
    bottom: 0;
    height: 2px;
    border-radius: 999px;
    background: var(--public-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .16s ease;
  }

  .public-navbar .nav-link:hover,
  .public-navbar .nav-link:focus {
    color: #fff;
  }

  .public-navbar .nav-link:hover::after,
  .public-navbar .nav-link:focus::after {
    transform: scaleX(1);
  }

  .public-navbar .navbar-toggler {
    border-color: rgba(255,255,255,.20);
    border-radius: 8px;
    background: rgba(255,255,255,.10);
  }

  .public-navbar .navbar-toggler-icon {
    filter: invert(1);
  }

  .public-home .btn-primary {
    background: linear-gradient(135deg, var(--public-blue), var(--public-blue-dark));
    border-color: var(--public-blue);
    font-weight: 800;
    box-shadow: 0 12px 24px rgba(49,95,187,.18);
  }

  .public-home .btn-primary:hover {
    background: var(--public-blue-dark);
    border-color: var(--public-blue-dark);
    transform: translateY(-1px);
  }

  .public-home .btn-outline-secondary {
    color: var(--public-blue);
    border-color: rgba(49,95,187,.24);
    background: #fff;
    font-weight: 800;
  }

  .public-home .btn-outline-secondary:hover {
    color: #fff;
    background: var(--public-orange);
    border-color: var(--public-orange);
    transform: translateY(-1px);
  }

  .public-slider-shell {
    padding: 0;
    background: var(--public-navy);
    border-bottom: 4px solid var(--public-orange);
  }

  .public-slider-shell > .container-fluid {
    max-width: none;
    padding-right: 0;
    padding-left: 0;
  }

  .public-slider-shell > .container-fluid.my-3 {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .public-slider-shell .hero-carousel {
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .public-hero-panel {
    margin-top: 0;
    padding: 4.5rem 0;
    position: relative;
    z-index: 3;
    background:
      linear-gradient(135deg, rgba(49,95,187,.22), transparent 44%),
      linear-gradient(180deg, var(--public-navy), var(--public-navy-2));
    color: #fff;
    border-bottom: 1px solid rgba(255,145,0,.42);
  }

  .public-overlay-card {
    border: 1px solid rgba(255,255,255,.12);
    border-left: 4px solid var(--public-orange);
    border-radius: 8px;
    box-shadow: 0 24px 58px rgba(0,0,0,.22);
    overflow: hidden;
    background: rgba(255,255,255,.05);
  }

  .public-hero-panel .text-dark {
    color: #fff !important;
  }

  .public-hero-panel .text-body-secondary {
    color: rgba(255,255,255,.70) !important;
  }

  .public-hero-panel .public-lead,
  .public-hero-panel .public-copy {
    color: rgba(255,255,255,.76);
  }

  .public-kicker {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem .85rem;
    border-radius: 999px;
    background: rgba(255,255,255,.10);
    color: #fff;
    border: 1px solid rgba(255,255,255,.16);
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .public-kicker::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--public-orange);
  }

  .public-display {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2rem, 3.1vw, 2.875rem);
    line-height: 1.08;
    letter-spacing: 0;
    font-weight: 600 !important;
    color: #fff;
  }

  .public-lead,
  .public-copy {
    color: var(--public-muted);
  }

  .public-lead {
    font-size: 1.08rem;
    line-height: 1.75;
    max-width: 62ch;
  }

  .public-pill-stat {
    border: 1px solid rgba(255,255,255,.12);
    border-left: 3px solid var(--public-orange);
    border-radius: 8px;
    box-shadow: none;
    background: rgba(255,255,255,.07);
    height: 100%;
  }

  .public-pill-stat .card-body {
    padding: 1.15rem 1.2rem;
  }

  .public-pill-stat .text-secondary {
    color: var(--public-orange) !important;
  }

  .public-section {
    padding: 6rem 0;
  }

  .public-home .badge {
    border-radius: 8px !important;
    letter-spacing: 0;
    font-weight: 800;
    text-transform: uppercase;
  }

  .public-home .text-bg-primary,
  .public-home .bg-primary {
    background-color: var(--public-blue) !important;
  }

  .public-home .text-bg-secondary,
  .public-home .bg-secondary {
    background-color: var(--public-orange) !important;
    color: #111827 !important;
  }

  #qui-sommes-nous {
    background: #fff;
    border-bottom: 1px solid rgba(16,24,40,.08);
  }

  #qui-sommes-nous img {
    border-radius: 8px !important;
    box-shadow: var(--public-shadow) !important;
  }

  .public-section-dark {
    background:
      linear-gradient(135deg, rgba(49,95,187,.18), transparent 48%),
      var(--public-navy);
    color: #fff;
    border-top: 4px solid var(--public-orange);
    border-bottom: 4px solid var(--public-orange);
  }

  .public-section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2rem, 3.1vw, 3.2rem);
    letter-spacing: 0;
    line-height: 1.08;
    font-weight: 500 !important;
  }

  .public-section-dark .public-copy {
    color: rgba(255,255,255,.78);
  }

  .public-service-card,
  .public-value-card,
  .public-contact-card,
  .public-news-card {
    border: 1px solid rgba(16,24,40,.08);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--public-shadow);
    height: 100%;
  }

  .public-service-card img,
  .public-news-card img {
    width: 100%;
    height: 260px;
    object-fit: cover;
  }

  .public-value-card {
    background: linear-gradient(135deg, var(--public-blue) 0%, var(--public-orange) 100%);
    color: #fff;
  }

  .public-value-card .text-muted,
