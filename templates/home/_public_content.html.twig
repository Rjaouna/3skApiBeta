    color: var(--public-ink);
    font-weight: 750;
    padding-left: 1.25rem;
  }

  .public-highlight-panel {
    background: linear-gradient(135deg, var(--public-blue-dark), #07101f);
    border: 1px solid rgba(255,255,255,.18);
    border-left: 4px solid var(--public-orange);
