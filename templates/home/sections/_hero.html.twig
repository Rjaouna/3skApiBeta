<section class="container-fluid {{ hero_full_width|default(false) ? 'p-0 m-0 hero-section-full' : 'my-3' }}">
  {% if slides is defined and slides|length > 0 %}
    <div id="heroCarousel" class="carousel slide showcase" data-bs-ride="carousel" data-bs-interval="6500">
      <div class="carousel-inner">
        {% for s in slides %}
          {% set mediaExtension = s.image|split('.')|last|lower %}
          {% set heroPlaceholder = 'data:image/gif;base64,R0lGODlhAQABAAAAACw=' %}
          <section class="carousel-item {{ loop.first ? 'active' : '' }} showcase-hero" aria-label="{{ s.title|default('3SK Parts Auto', true) }}">
            <div class="showcase-hero__media">
              {% if mediaExtension in ['mp4', 'webm'] %}
                <video class="showcase-hero__managed-media"
                       autoplay muted loop playsinline preload="none"
                       data-hero-lazy-video
                       aria-label="{{ s.altText|default(s.title|default('Slide')) }}">
                  <source data-src="{{ asset('img/slides/' ~ s.image) }}" type="{{ mediaExtension == 'webm' ? 'video/webm' : 'video/mp4' }}">
                </video>
              {% else %}
                <img src="{{ loop.first ? optimized_asset('img/slides/' ~ s.image) : heroPlaceholder }}"
                     class="showcase-hero__managed-media"
                     alt="{{ s.altText|default(s.title|default('Slide')) }}"
                     width="1600" height="600" decoding="async"
                     loading="{{ loop.first ? 'eager' : 'lazy' }}"
                     fetchpriority="{{ loop.first ? 'high' : 'auto' }}"
                     {% if not loop.first %}
                       data-src="{{ optimized_asset('img/slides/' ~ s.image) }}" data-hero-lazy
                     {% endif %}>
              {% endif %}
            </div>

            {% if is_granted('ROLE_ADMIN') %}
              <div class="showcase-admin-actions">
                <form method="post" action="{{ path('admin_hero_slide_bump', {id: s.id}) }}" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('bump_slide_' ~ s.id) }}">
                  <button class="btn btn-warning btn-sm" type="submit" title="Mettre en avant" aria-label="Mettre en avant">
                    <i class="fa-solid fa-thumbtack" aria-hidden="true"></i>
                  </button>
                </form>
                <a class="btn btn-light btn-sm" href="{{ path('admin_hero_slide_edit', {id: s.id}) }}" title="Modifier" aria-label="Modifier">
                  <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                </a>
                <form method="post" action="{{ path('admin_hero_slide_delete', {id: s.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce slide ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_slide_' ~ s.id) }}">
                  <button class="btn btn-danger btn-sm" type="submit" title="Supprimer" aria-label="Supprimer">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                  </button>
                </form>
              </div>
            {% endif %}

            {% if loop.first %}
              {% include 'home/sections/_showcase_intro.html.twig' %}
            {% else %}
              <div class="showcase-hero__content">
                {% if s.kicker is defined and s.kicker %}
                  <p class="showcase-eyebrow">{{ s.kicker }}</p>
                {% endif %}

                {% if s.title is defined and s.title %}
                  <h2 class="showcase-managed-title">{{ s.title }}</h2>
                {% endif %}

                {% if s.subtitle is defined and s.subtitle %}
                  <p class="showcase-description">{{ s.subtitle }}</p>
                {% endif %}

                {% set pLabel = (s.primaryLabel is defined) ? s.primaryLabel|trim : '' %}
                {% set pUrl = (s.primaryUrl is defined) ? s.primaryUrl|trim : '' %}
                {% set sLabel = (s.secondaryLabel is defined) ? s.secondaryLabel|trim : '' %}
                {% set sUrl = (s.secondaryUrl is defined) ? s.secondaryUrl|trim : '' %}
                {% if pLabel and pUrl or sLabel and sUrl %}
                  <div class="showcase-actions">
                    {% if pLabel and pUrl %}
                      <a href="{{ pUrl }}" class="showcase-action showcase-action--primary">{{ pLabel }}<i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
                    {% endif %}
                    {% if sLabel and sUrl %}
                      <a href="{{ sUrl }}" class="showcase-action showcase-action--secondary">{{ sLabel }}<i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </section>
        {% endfor %}
      </div>

      {% if slides|length > 1 %}
        <div class="carousel-indicators showcase-pagination">
          {% for s in slides %}
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="{{ loop.index0 }}"
                    class="{{ loop.first ? 'active' : '' }}" {% if loop.first %}aria-current="true"{% endif %}
                    aria-label="Slide {{ loop.index }}"></button>
          {% endfor %}
        </div>
        <div class="showcase-controls" aria-label="Navigation des slides">
          <button type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Slide précédent"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
          <button type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Slide suivant"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
        </div>
      {% endif %}
    </div>
  {% else %}
    <div class="alert alert-light border">
      <div class="fw-bold">Aucun slide</div>
      {% if is_granted('ROLE_ADMIN') %}
        <div class="mt-2">
          <a href="{{ path('admin_hero_slide_new') }}" class="btn btn-primary rounded-pill">
            <i class="fa-solid fa-circle-plus me-2"></i>Ajouter le premier slide
          </a>
        </div>
      {% endif %}
    </div>
  {% endif %}
</section>
<script src="{{ asset('scripts/public-showcase.js') }}?v=20261016-3" defer></script>
