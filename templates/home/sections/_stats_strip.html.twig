<style>
  .site-stats-strip {
    position: relative;
    width: 100%;
    padding: 2.25rem 0;
    background: #fff;
    border-top: 1px solid rgba(17, 24, 39, .06);
    border-bottom: 1px solid rgba(17, 24, 39, .06);
  }

  .site-stats-strip__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: .85rem;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .site-stats-strip__item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: center;
    gap: .8rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid rgba(17, 24, 39, .08);
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(49,95,187,.06), rgba(255,255,255,.96) 54%, rgba(255,145,0,.055)),
      #fff;
    box-shadow: 0 12px 28px rgba(17, 24, 39, .06);
  }

  .site-stats-strip__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 14px;
    color: var(--public-blue, #315fbb);
    background: rgba(49,95,187,.08);
    font-size: 1.15rem;
  }

  .site-stats-strip__value {
    display: block;
    color: var(--public-ink, #111827);
    font-family: "Montserrat", Arial, sans-serif;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .site-stats-strip__label {
    display: block;
    margin-top: .35rem;
    color: var(--public-muted, #747b84);
    font-family: "Montserrat", Arial, sans-serif;
    font-size: .72rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .site-stats-strip__label::after {
    content: "";
    display: block;
    width: 32px;
    height: 2px;
    margin-top: .55rem;
    background: var(--public-orange, #ff9100);
    border-radius: 999px;
  }

  @media (max-width: 991.98px) {
    .site-stats-strip__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 760px;
    }
  }

  @media (max-width: 575.98px) {
    .site-stats-strip {
      padding: 1.4rem 0;
    }

    .site-stats-strip__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .75rem;
      padding: 0 1.1rem;
    }

    .site-stats-strip__item {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: .65rem;
      padding: .85rem;
      border-radius: 16px;
    }

    .site-stats-strip__icon {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      font-size: 1rem;
    }

    .site-stats-strip__value {
      font-size: 1.35rem;
    }

    .site-stats-strip__label {
      font-size: .66rem;
    }
  }
</style>

{% set stats = [
  {
    icon: 'fa-boxes-stacked',
    value: homeStats.totalReferences|default(0)|number_format(0, ',', ' '),
    label: 'Références catalogue'
  },
  {
    icon: 'fa-warehouse',
    value: homeStats.stockedReferences|default(0)|number_format(0, ',', ' '),
    label: 'Références en stock'
  },
  {
    icon: 'fa-car-side',
    value: homeStats.vehicleBrands|default(0)|number_format(0, ',', ' '),
    label: 'Marques véhicules'
  },
  {
    icon: 'fa-layer-group',
    value: homeStats.productBrands|default(0)|number_format(0, ',', ' '),
    label: 'Marques partenaires'
  },
  {
    icon: 'fa-calendar-check',
    value: '2014',
    label: 'Année de création'
  }
] %}

<section class="site-stats-strip" aria-label="3SK Parts Auto en chiffres">
  <div class="site-stats-strip__grid">
    {% for stat in stats %}
      <div class="site-stats-strip__item">
        <span class="site-stats-strip__icon" aria-hidden="true">
          <i class="fa-solid {{ stat.icon }}"></i>
        </span>
        <div>
          <strong class="site-stats-strip__value">{{ stat.value }}</strong>
          <span class="site-stats-strip__label">{{ stat.label }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
