<section id="marques" class="public-brands-v2 section-space">
  <div class="section-shell">
    <div class="brands-heading">
      <div>
        <span class="section-eyebrow">Nos marques phares</span>
        <h2 class="section-heading">Nos marques <span class="heading-accent">partenaires</span></h2>
      </div>
      <p class="section-copy">Une sélection de partenaires et de références reconnues pour accompagner les besoins des professionnels.</p>
    </div>
    <div class="brand-row">
      {% for brand in brandLogos %}
        <div class="brand-item">
          <img
            src="{{ optimized_asset('img/logo-marques-home-hors-ligne/' ~ brand.file) }}"
            alt="Logo {{ brand.name }} pièces carrosserie 3SK Parts Auto"
            loading="lazy"
            decoding="async"
          >
        </div>
      {% endfor %}
    </div>
  </div>
</section>
